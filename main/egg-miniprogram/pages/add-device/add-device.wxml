<view class="page">
  <nav-bar title="添加蛋宝宝"></nav-bar>

  <view class="content">
    <!-- 分段控件：扫码 / 输入凭证码 -->
    <view class="segment">
      <view class="segment__item {{mode === 'scan' ? 'is-active' : ''}}" bindtap="onModeScan">扫码添加</view>
      <view class="segment__item {{mode === 'code' ? 'is-active' : ''}}" bindtap="onModeCode">输入凭证码</view>
    </view>

    <!-- 扫码取景框 -->
    <view wx:if="{{mode === 'scan'}}" class="scan-frame" bindtap="onScan">
      <block wx:if="{{scanState === 'idle'}}">
        <view class="scan-icon"></view>
        <text class="scan-tip">点击调起微信扫一扫，扫描添加凭证二维码</text>
      </block>
      <view wx:elif="{{scanState === 'scanning'}}" class="spinner"></view>
      <text wx:elif="{{scanState === 'scanned'}}" class="scan-ok">识别成功 · {{code}}</text>
    </view>

    <!-- 输入凭证码 -->
    <view wx:else class="code-block">
      <text class="label">添加凭证码</text>
      <input class="code-input" value="{{code}}" bindinput="onCodeInput"
             placeholder="请输入企业码 / 个人邀请码 / 购买凭证码" />
    </view>

    <text wx:if="{{error}}" class="error">{{error}}</text>

    <view class="note">添加时会告诉你蛋宝宝的原型（例如锦鲤、玉兔），但具体款式要等破壳那一刻才会揭晓。</view>

    <view class="spacer"></view>
    <btn text="校验凭证" disabled="{{!canSubmit}}" bind:tap="onValidate"></btn>
  </view>

  <!-- 校验成功轻惊喜浮层 -->
  <view wx:if="{{success}}" class="success-mask">
    <view class="success-egg-stage">
      <view class="success-glow"></view>
      <view class="success-egg"></view>
    </view>
    <text class="success-text">你获得了一只{{success.prototype}}蛋宝宝</text>
  </view>
</view>
