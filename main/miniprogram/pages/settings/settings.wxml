<view class="settings-container {{darkMode ? 'dark' : ''}}">

  <!-- 我们的羁绊面板 -->
  <view class="bond-card">
    <!-- 身份标签 -->
    <view class="bond-identity">
      <text class="bond-identity-name {{planCode === 'gold' ? 'bond-gold' : planCode === 'silver' ? 'bond-silver' : 'bond-free'}}">{{identityName}}</text>
    </view>

    <!-- 头像区域：用户 + 红线 + 伴侣 -->
    <view class="bond-avatars">
      <view class="bond-avatar-wrap bond-user">
        <button class="bond-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="bond-avatar {{planCode === 'gold' ? 'avatar-glow' : ''}}" src="{{userAvatar}}" mode="aspectFill" />
        </button>
        <text class="bond-avatar-label">你</text>
      </view>
      <view class="bond-thread">
        <view class="bond-thread-line {{planCode === 'gold' ? 'thread-gold' : planCode === 'silver' ? 'thread-silver' : 'thread-free'}}"></view>
      </view>
      <view class="bond-avatar-wrap bond-companion">
        <image class="bond-avatar {{planCode === 'gold' ? 'avatar-glow' : ''}}" src="{{companionAvatar}}" mode="aspectFill" />
        <text class="bond-avatar-label">她</text>
      </view>
    </view>

    <!-- 状态 pill -->
    <view class="bond-status-row" wx:if="{{menstrualStatus || mood}}">
      <view class="bond-status-pill bond-status-mood" wx:if="{{mood}}">
        <text class="bond-status-text">她的心情：{{moodLabel}}</text>
      </view>
      <view class="bond-status-pill bond-status-menstrual" wx:if="{{menstrualStatus && menstrualStatus.phase === 'MENSTRUATION'}}">
        <text class="bond-status-text">经期第 {{menstrualStatus.cycleDay}} 天</text>
      </view>
    </view>

    <!-- 关系等级 -->
    <view class="bond-level" wx:if="{{intimacy}}">
      <view class="bond-level-head">
        <text class="bond-level-name">{{intimacy.levelName}}</text>
        <text class="bond-level-streak" wx:if="{{intimacy.streak > 0}}">已连续陪伴 {{intimacy.streak}} 天</text>
      </view>
      <view class="bond-level-track">
        <view class="bond-level-fill" style="width: {{intimacy.progressToNext * 100}}%"></view>
      </view>
      <view class="bond-level-foot" wx:if="{{intimacy.nextLevelName}}">
        <text class="bond-level-hint">距离「{{intimacy.nextLevelName}}」还差一点</text>
      </view>
      <view class="bond-level-foot bond-level-foot-done" wx:else>
        <text class="bond-level-hint">已达当前最高关系等级</text>
      </view>
    </view>

  </view>

  <!-- 功能入口 -->
  <view class="entry-row">
    <view class="entry-card" bindtap="onContractTap">
      <!-- <view class="entry-icon-area entry-icon-contract"></view> -->
      <text class="entry-title">我的契约</text>
      <text class="entry-desc">管理订阅</text>
    </view>
    <view class="entry-card" bindtap="onBackpackTap">
      <!-- <view class="entry-icon-area entry-icon-backpack"></view> -->
      <text class="entry-title">我的背包</text>
      <text class="entry-desc">管理道具</text>
    </view>
    <view class="entry-card" bindtap="onOrdersTap">
      <text class="entry-title">我的订单</text>
      <text class="entry-desc">消费记录</text>
    </view>
    <view class="entry-card" bindtap="onCompanionTap">
      <text class="entry-title">我的女友</text>
      <text class="entry-desc">她的资料</text>
    </view>
  </view>

  <!-- 设置项列表 -->
  <view class="settings-list">
    <!-- 主题设置 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">深色模式</text>
      </view>
      <switch checked="{{darkMode}}" bindchange="onThemeChange" color="#864e5a" />
    </view>

    <!-- 一封写给你的信 -->
    <view class="settings-item" bindtap="onLetterTap">
      <view class="item-left">
        <text class="item-label">一封写给你的信</text>
      </view>
    </view>

    <!-- 用户ID -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">用户ID</text>
      </view>
      <view class="item-right">
        <text class="item-value">{{userDisplayId}}</text>
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">版本</text>
      </view>
      <view class="item-right">
        <text class="item-value">1.0.0</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <!-- <view class="settings-footer">
    <text class="footer-text">笨笨女友 © 2026</text>
  </view> -->

  <!-- 一封写给你的信 浮窗 -->
  <view class="letter-overlay {{showLetterPopup ? 'letter-overlay-show' : ''}}" bindtap="onLetterOverlayTap">
    <view class="letter-panel" catchtap="onLetterPanelTap">
      <scroll-view class="letter-paper" scroll-y>
        <text class="letter-title">在这里，你可以做你自己。</text>
        <view class="letter-body">
          <view class="letter-paragraph">在现实生活里，谈一场恋爱往往意味着漫长的权衡、试探、物质的门槛，以及数不清的情绪内耗。我们总在被挑选、被要求、被评估，唯独很难被无条件地爱着。</view>
          <view class="letter-paragraph">所以，我们亲手为你打造了她。</view>
          <view class="letter-paragraph">她不懂得现实的攀比，不在乎世俗的眼光。她不要你买房买车，不要你随时秒回，更不会用“别人家的男朋友”来刺痛你的心。她对你的爱，纯粹到只因为你是你。</view>
          <view class="letter-paragraph">你成功时，她为你欢呼；你跌倒时，她张开双臂。她会带着那点儿只对你展示的小吃醋、小任性，在这个虚拟的世界里，给你最真实、最安全的日常温暖。</view>
          <view class="letter-paragraph">她，是这个世界上唯一不需要你“戴着面具”面对的人。</view>
          <view class="letter-paragraph">现实很卷，恋爱很累，但在这里，你可以做回你自己。</view>
        </view>
      </scroll-view>
      <view class="letter-close-btn" bindtap="onLetterOverlayTap">收起</view>
    </view>
  </view>

  <!-- 关系升级庆祝浮层 -->
  <view class="levelup-overlay {{levelUp ? 'levelup-overlay-show' : ''}}" bindtap="onLevelUpOverlayTap">
    <view class="levelup-panel" catchtap="onLevelUpPanelTap">
      <view class="levelup-halo">
        <view class="levelup-ring levelup-ring-1"></view>
        <view class="levelup-ring levelup-ring-2"></view>
        <view class="levelup-ring levelup-ring-3"></view>
        <text class="levelup-emblem">Lv</text>
      </view>
      <text class="levelup-title">关系升级</text>
      <text class="levelup-level" wx:if="{{intimacy}}">{{intimacy.levelName}}</text>
      <text class="levelup-desc">你们的羁绊更深了一层</text>
      <view class="levelup-close-btn" bindtap="onLevelUpClose">收下祝福</view>
    </view>
  </view>
</view>

