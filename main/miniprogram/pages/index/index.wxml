<!--pages/index/index.wxml-->
<view class="page">
  <!-- 背景层：背景图片 -->
  <image wx:if="{{!booting}}" class="bg-image" src="{{companionBgImage || '/images/beijing.png'}}" mode="aspectFill"></image>

  <!-- 顶部状态栏 - AI伴侣导航 -->
  <view wx:if="{{!booting}}" class="top-bar">
    <!-- AI头像和名字 -->
    <view class="ai-profile" bindtap="onTapStatus">
      <view class="avatar-wrapper">
        <image class="avatar-image" src="{{companionAvatar || '/images/avatar-default.png'}}" mode="aspectFill"></image>
        <view class="status-dot state-{{connectionState}}"></view>
      </view>
      <view class="ai-meta">
        <text class="ai-status">
          <block wx:if="{{connectionState === 'connected'}}">在线</block>
          <block wx:elif="{{connectionState === 'connecting'}}">连接中...</block>
          <block wx:else>离线</block>
        </text>
      </view>
    </view>

    <!-- 退下按钮 - 已连接时显示 -->
    <view wx:if="{{!booting && connectionState === 'connected'}}" class="summon-btn" bindtap="onDisconnect" hover-class="summon-btn-hover" hover-stay-time="80">
      <text class="summon-text">退下</text>
    </view>

    <!-- 召唤按钮 - 仅在断开连接时显示 -->
    <view wx:if="{{!booting && connectionState === 'disconnected'}}" class="summon-btn" bindtap="onSummon" hover-class="summon-btn-hover" hover-stay-time="80">
      <text class="summon-text">召唤</text>
    </view>
  </view>

  <!-- 启动占位 -->
  <view wx:if="{{booting}}" class="boot-shell">
    <view class="boot-orbit">
      <view class="boot-dot"></view>
    </view>
    <text class="boot-text">正在准备…</text>
  </view>

  <!-- 消息区 -->
  <scroll-view
    wx:if="{{!booting}}"
    class="conversation"
    scroll-y="true"
    scroll-with-animation="true"
    enhanced="true"
    show-scrollbar="false"
    scroll-into-view="{{scrollToView}}"
  >
    <view class="conversation-inner">
      <!-- 消息列表（含流式回复） -->
      <block wx:for="{{messages}}" wx:key="id">
        <view id="{{item.id}}">
          <chat-bubble role="{{item.role}}" content="{{item.content}}" typing="{{item.typing}}" />
        </view>
      </block>

      <!-- 正在输入指示器 -->
      <view wx:if="{{chatState === 'thinking'}}" class="typing-indicator">
        <view class="typing-dot"></view>
        <view class="typing-dot" style="animation-delay: 0.2s"></view>
        <view class="typing-dot" style="animation-delay: 0.4s"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view wx:if="{{!booting}}" class="input-bar safe-area-bottom">
    <view class="input-bar-inner">
      <!-- 输入框容器 -->
      <view class="input-wrapper">
        <input
          class="message-input"
          type="text"
          placeholder="输入消息..."
          placeholder-style="color: rgba(148, 163, 184, 0.5);"
          value="{{inputText}}"
          bindinput="onTextInput"
          bindconfirm="onTextSend"
          confirm-type="send"
          maxlength="500"
          disabled="{{connectionState !== 'connected' || chatState === 'thinking'}}"
          adjust-position="{{true}}"
        />
      </view>

      <!-- 发送按钮 -->
      <view
        class="send-btn {{inputText.trim() ? 'active' : ''}}"
        bindtap="onTextSend"
        hover-class="send-btn-hover"
        hover-stay-time="80"
      >
        <text class="send-btn-text">发送</text>
      </view>
    </view>
  </view>
</view>
