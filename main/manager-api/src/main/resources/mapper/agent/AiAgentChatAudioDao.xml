<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="xiaozhi.modules.agent.dao.AiAgentChatAudioDao">

    <select id="getOssKeysByAudioIds" resultType="java.lang.String">
        SELECT DISTINCT oss_key
        FROM ai_agent_chat_audio
        WHERE id IN
        <foreach collection="audioIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        AND oss_key IS NOT NULL
    </select>

</mapper>
