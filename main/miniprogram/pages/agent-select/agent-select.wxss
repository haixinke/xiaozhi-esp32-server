/* pages/agent-select/agent-select.wxss */

.header {
  padding: 60rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #ffffff;
}

.subtitle {
  font-size: 26rpx;
  color: #6b6b80;
}

/* Agent 列表 */
.agent-list {
  flex: 1;
  padding: 0 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6b6b80;
}

.retry-btn {
  margin-top: 20rpx;
}

/* Agent 卡片 */
.agent-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  transition: opacity 0.2s, transform 0.15s;
}

.agent-card:active {
  transform: scale(0.98);
}

.agent-card.binding {
  opacity: 0.6;
}

.agent-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.agent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.agent-detail {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.agent-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-desc {
  font-size: 24rpx;
  color: #6b6b80;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 绑定按钮 */
.agent-action {
  flex-shrink: 0;
  margin-left: 20rpx;
}

.bind-text {
  font-size: 26rpx;
  color: #6c63ff;
  padding: 12rpx 28rpx;
  border: 1rpx solid rgba(108, 99, 255, 0.3);
  border-radius: 30rpx;
}

.binding-text {
  font-size: 24rpx;
  color: #a0a0b0;
}
