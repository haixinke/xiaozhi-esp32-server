/* pages/memory-anchor/memory-anchor.wxss */
/* Ethereal Companion Design System - 记忆锚定 */

page {
  background-color: #fbf9f8;
  color: #1b1c1c;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbf9f8;
  background-image:
    radial-gradient(at 0% 0%, rgba(255, 183, 197, 0.2) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(211, 198, 218, 0.2) 0px, transparent 50%);
}

/* -------- 自定义导航栏 -------- */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.08);
}

.nav-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #864e5a;
  letter-spacing: 2rpx;
}

/* -------- 滚动内容区 -------- */
.scroll-content {
  flex: 1;
  overflow: hidden;
  padding-top: calc(var(--status-bar-height, 44px) + 88rpx + 24rpx);
}

/* -------- 视频区 -------- */
.video-section {
  padding: 0 40rpx;
  margin-bottom: 40rpx;
}

.video-player {
  width: 100%;
  height: 820rpx;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 60rpx rgba(255, 183, 197, 0.35);
}

/* -------- 通用 section -------- */
.section {
  margin-bottom: 48rpx;
  padding: 0 40rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 36rpx;
  background: #ffb7c5;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1c;
  line-height: 1.3;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.6);
  margin-bottom: 28rpx;
  padding-left: 22rpx;
  line-height: 1.5;
}

/* -------- 选项网格 -------- */
.option-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pet-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.25s ease;
  user-select: none;
}

.option-item-hover {
  transform: scale(0.95);
}

.option-item-active {
  background: rgba(255, 183, 197, 0.25);
  border-color: #864e5a;
  box-shadow: 0 0 20rpx rgba(255, 183, 197, 0.3);
}

.option-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1b1c1c;
  text-align: center;
  line-height: 1.3;
}

.option-item-active .option-label {
  color: #864e5a;
  font-weight: 600;
}

/* -------- 名字输入框 -------- */
.name-input-wrap {
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
}

.name-input {
  font-size: 28rpx;
  color: #1b1c1c;
  width: 100%;
}

/* -------- CTA 按钮 -------- */
.cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 40rpx 24rpx;
  background: rgba(251, 249, 248, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 100;
}

.cta-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #ffb7c5 0%, #ff9aa2 100%);
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 183, 197, 0.35);
  animation: softPulse 3s infinite ease-in-out;
  user-select: none;
}

.cta-btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.cta-btn-disabled {
  opacity: 0.5;
  animation: none;
  box-shadow: none;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #360c19;
  letter-spacing: 2rpx;
}

@keyframes softPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.01); opacity: 0.95; }
}

/* -------- 安全区 -------- */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}
