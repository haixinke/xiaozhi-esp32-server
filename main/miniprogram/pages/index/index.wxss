/* pages/index/index.wxss */
/* Ethereal Companion Design System - 完美女友主题 */

page {
  background-color: #fbf9f8;
  color: #1b1c1c;
}

.page {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #fbf9f8;
}

/* ---------------- 背景层 ---------------- */
/* 背景图片 */
.bg-image {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.9;
  z-index: 0;
  pointer-events: none;
}

/* 渐变遮罩层 - 从下到上的渐变，确保文字可读性 */
.bg-overlay {
  position: fixed;
  inset: 0;
  background: linear-gradient(to top, rgba(251, 249, 248, 0.92) 0%, rgba(251, 249, 248, 0.6) 30%, transparent 60%, transparent 100%);
  opacity: 0.85;
  z-index: 1;
  pointer-events: none;
}

.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(134, 78, 90, 0.03) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(134, 78, 90, 0.03) 1rpx, transparent 1rpx);
  background-size: 80rpx 80rpx;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 35%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 35%, transparent 80%);
  pointer-events: none;
  z-index: 2;
}

.bg-aurora {
  position: absolute;
  width: 700rpx;
  height: 700rpx;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.15;
  pointer-events: none;
  z-index: 2;
}
.bg-aurora-1 {
  top: -300rpx;
  left: -180rpx;
  background: radial-gradient(circle, rgba(255, 183, 193, 0.4) 0%, transparent 65%);
  animation: aurora-drift-1 18s ease-in-out infinite alternate;
}
.bg-aurora-2 {
  bottom: -280rpx;
  right: -200rpx;
  background: radial-gradient(circle, rgba(134, 78, 90, 0.3) 0%, transparent 65%);
  animation: aurora-drift-2 22s ease-in-out infinite alternate;
}
@keyframes aurora-drift-1 {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(80rpx, 60rpx) scale(1.1); }
}
@keyframes aurora-drift-2 {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(-100rpx, -80rpx) scale(1.15); }
}

/* ---------------- 顶部状态栏 ---------------- */
.top-bar {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 36rpx 20rpx;
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.08);
  background: rgba(251, 249, 248, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
}

/* AI伴侣头像区域 */
.ai-profile {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar-wrapper {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}

.avatar-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 3rpx solid #ffb7c5;
  background: #ffb7c5;
}

/* 状态指示点 - 头像右下角 */
.status-dot {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #ffffff;
  box-shadow: 0 0 8rpx currentColor;
}

.status-dot.state-connected {
  background: #4ade80;
}

.status-dot.state-connecting {
  background: #fbb3c1;
  animation: dot-blink 1s ease-in-out infinite;
}

.status-dot.state-disconnected {
  background: #837375;
}

.ai-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ai-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1b1c1c;
  line-height: 1.2;
}

.ai-status {
  font-size: 22rpx;
  color: #864e5a;
  opacity: 0.8;
}

/* 召唤按钮 - 改为退下按钮 */
.summon-btn {
  padding: 10rpx 48rpx;
  padding-top: 16rpx;
  padding-bottom: 16rpx;
  border-radius: 100rpx;
  background: #ffb7c5;
  box-shadow: 0 0 20rpx rgba(255, 183, 193, 0.4);
  transition: all 0.2s;
  user-select: none;
}

.summon-btn-hover {
  transform: scale(0.95);
  opacity: 0.85;
  box-shadow: 0 0 16rpx rgba(255, 183, 193, 0.35);
}

.summon-text {
  font-size: 26rpx;
  color: #360c19;
  font-weight: 500;
  letter-spacing: 2rpx;
}

@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}

.status-cluster {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.status-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  color: #864e5a;
}
.status-session {
  font-size: 18rpx;
  color: rgba(134, 78, 90, 0.55);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-cluster {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.agent-name {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  max-width: 240rpx;
}
.agent-prefix {
  font-size: 22rpx;
  color: rgba(134, 78, 90, 0.7);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
}
.agent-text {
  font-size: 28rpx;
  color: #1b1c1c;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}
.switch-btn {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #864e5a;
  border: 1rpx solid rgba(134, 78, 90, 0.4);
  border-radius: 100rpx;
  background: rgba(134, 78, 90, 0.06);
}
.switch-btn-hover {
  background: rgba(134, 78, 90, 0.18) !important;
  transform: scale(0.96);
}

/* ---------------- 启动占位 ---------------- */
.boot-shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  z-index: 2;
}
.boot-orbit {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(134, 78, 90, 0.18);
  animation: boot-spin 3s linear infinite;
}
.boot-dot {
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  background: #fbb3c1;
  box-shadow: 0 0 16rpx #fbb3c1;
}
.boot-text {
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.7);
  letter-spacing: 4rpx;
}
@keyframes boot-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ---------------- 会话区 ---------------- */
.conversation {
  position: relative;
  z-index: 10;
  flex: 1;
  width: 100%;
  height: 0; /* 关键修复：配合 flex: 1 使用，确保正确占据剩余空间 */
  box-sizing: border-box;
}
.conversation-inner {
  padding: 24rpx 24rpx 16rpx;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* ---------------- 欢迎区 ---------------- */
.welcome {
  display: flex;
  flex-direction: column;
  padding: 40rpx 8rpx;
  gap: 28rpx;
}

.welcome-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(134, 78, 90, 0.65);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
}
.welcome-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(134, 78, 90, 0.4), transparent);
}
.welcome-eyebrow .welcome-line:last-child {
  background: linear-gradient(270deg, rgba(134, 78, 90, 0.4), transparent);
}

.welcome-title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}
.welcome-hi {
  font-size: 56rpx;
  font-weight: 300;
  color: #514345;
  letter-spacing: 1rpx;
}
.welcome-name {
  font-size: 76rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #864e5a 0%, #fbb3c1 60%, #ffb7c5 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: 2rpx;
}
.welcome-dot {
  font-size: 76rpx;
  font-weight: 700;
  color: #864e5a;
}

.welcome-sub {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(81, 67, 69, 0.7);
  max-width: 580rpx;
}

.welcome-grid {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.welcome-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.1);
}
.welcome-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: linear-gradient(180deg, #fbb3c1, #864e5a);
  opacity: 0.7;
}
.welcome-card-tag {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(134, 78, 90, 0.75);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  width: 48rpx;
}
.welcome-card-text {
  font-size: 28rpx;
  color: #1b1c1c;
}

/* ---------------- 底部输入栏 ---------------- */
.input-bar {
  position: relative;
  z-index: 10;
  background: transparent;
  padding: 4rpx 24rpx 8rpx;
}

.input-bar-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 输入框容器 - pill-shaped */
.input-wrapper {
  flex: 1;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border-radius: 100rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: border-color 0.2s;
  box-shadow: 0 8rpx 32rpx rgba(134, 78, 90, 0.15), 0 0 20rpx rgba(255, 183, 193, 0.3);
}

.message-input {
  width: 100%;
  font-size: 32rpx;
  color: #1b1c1c;
  line-height: 1.5;
  background: transparent;
}

.message-input::placeholder {
  color: rgba(134, 78, 90, 0.5);
}

.message-input[disabled] {
  color: rgba(134, 78, 90, 0.3);
}

/* 发送按钮 - pill-shaped */
.send-btn {
  min-width: 112rpx;
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 100rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(30rpx);
  -webkit-backdrop-filter: blur(30rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  transition: all 0.2s;
  user-select: none;
  box-shadow: 0 8rpx 32rpx rgba(134, 78, 90, 0.15), 0 0 20rpx rgba(255, 183, 193, 0.3);
}

.send-btn.active {
  background: linear-gradient(135deg, #ffb7c5 0%, #864e5a 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 32rpx rgba(134, 78, 90, 0.25), 0 0 24rpx rgba(255, 183, 193, 0.5);
}

.send-btn-text {
  font-size: 28rpx;
  color: rgba(134, 78, 90, 0.6);
  font-weight: 500;
}

.send-btn.active .send-btn-text {
  color: #ffffff;
}

.send-btn-hover {
  transform: scale(0.95);
  opacity: 0.85;
}

/* 安全区适配 */
.safe-area-bottom {
  padding-bottom: 15rpx;
}

/* ---------------- 正在输入指示器 ---------------- */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 100rpx;
  width: fit-content;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.1);
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(134, 78, 90, 0.4);
  animation: bounce 1.4s ease-in-out infinite;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.8);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
