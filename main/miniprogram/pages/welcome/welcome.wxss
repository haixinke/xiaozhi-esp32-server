/* pages/welcome/welcome.wxss */

.page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #000;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

/* -------- 呼吸光晕 -------- */
.glow {
  position: absolute;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 183, 197, 0.06) 0%, transparent 70%);
  opacity: 0;
  animation: glow-breathe 4s ease-in-out infinite alternate;
  animation-delay: 0.6s;
}

@keyframes glow-breathe {
  0% { transform: scale(0.8); opacity: 0.3; }
  100% { transform: scale(1.3); opacity: 0.7; }
}

/* -------- 文案 -------- */
.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
  transition: opacity 0.3s ease;
}

.content-fade {
  opacity: 0;
}

.line {
  display: block;
  font-size: 44rpx;
  font-weight: 300;
  color: rgba(255, 243, 240, 0.92);
  letter-spacing: 8rpx;
  line-height: 2.4;
  opacity: 0;
}

.line-1 { animation: text-enter 0.8s ease-out forwards; animation-delay: 0.8s; }
.line-2 { animation: text-enter 0.8s ease-out forwards; animation-delay: 2.0s; }
.line-3 { animation: text-enter 0.8s ease-out forwards; animation-delay: 3.2s; }
.line-4 { animation: text-enter 0.8s ease-out forwards; animation-delay: 4.4s; }
.line-5 { animation: text-enter 0.8s ease-out forwards; animation-delay: 5.6s; }
.line-6 { animation: text-enter 0.8s ease-out forwards; animation-delay: 6.8s; }

@keyframes text-enter {
  0% {
    opacity: 0;
    transform: translateY(20rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

/* -------- 底部按钮 -------- */
.btn-wrap {
  position: absolute;
  bottom: calc(env(safe-area-inset-bottom, 40rpx) + 80rpx);
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  z-index: 2;
}

.cta-btn {
  padding: 28rpx 96rpx;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #ffb7c5 0%, #ff9aa2 100%);
  box-shadow: 0 8rpx 40rpx rgba(255, 183, 197, 0.35);
  animation: btn-enter 1s ease-out forwards, btn-pulse 3s 1s infinite ease-in-out;
  user-select: none;
}

.cta-btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #360c19;
  letter-spacing: 4rpx;
}

@keyframes btn-enter {
  0% {
    opacity: 0;
    transform: translateY(30rpx);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes btn-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.01); opacity: 0.95; }
}

/* -------- 涟漪动画 -------- */
.ripple-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  pointer-events: none;
}

.ripple-circle {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  background: transparent;
}

.ripple-1 {
  animation: ripple-expand 1s ease-out forwards;
}

.ripple-2 {
  animation: ripple-expand 1s 0.15s ease-out forwards;
}

.ripple-3 {
  animation: ripple-expand 1s 0.3s ease-out forwards;
}

@keyframes ripple-expand {
  0% {
    width: 0;
    height: 0;
    opacity: 0.6;
    border-color: rgba(255, 183, 197, 0.3);
    background: rgba(255, 183, 197, 0.05);
  }
  50% {
    opacity: 0.4;
    background: rgba(251, 249, 248, 0.15);
  }
  100% {
    width: 3000rpx;
    height: 3000rpx;
    opacity: 0;
    border-color: transparent;
    background: rgba(251, 249, 248, 1);
  }
}
