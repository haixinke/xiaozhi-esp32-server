<view class="page">
  <nav-bar title="{{card.name}}" bind:back="noop">
    <!-- 右侧「⋯」菜单：如 nav-bar 支持右插槽则放这里；否则页面自绘 -->
  </nav-bar>

  <!-- 心情状态条 -->
  <view class="mood-bar">
    <mood-badge mood="{{dailyStatus.mood}}"></mood-badge>
    <text class="mood-line">{{dailyStatus.line}}</text>
    <text class="conn-state conn-state--{{connectionState}}">{{connLabel}}</text>
  </view>

  <!-- 消息区 -->
  <scroll-view class="messages" scroll-y scroll-into-view="{{scrollAnchor}}" scroll-with-animation>
    <view class="tip">仅展示最近的对话 · 只保留最近几个月的记录</view>

    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}">
      <!-- 用户气泡（右） -->
      <view wx:if="{{item.role === 'user'}}" class="row row--user">
        <view class="bubble bubble--user">{{item.content}}</view>
      </view>
      <!-- 蛋宝宝气泡（左） -->
      <view wx:else class="row row--egg">
        <egg-avatar size="{{28}}" gradient-from="#EDE78E" gradient-to="#F4B9AE"></egg-avatar>
        <view class="bubble bubble--egg {{item.typing ? 'bubble--typing' : ''}} {{chatState === 'speaking' && index === messages.length - 1 ? 'bubble--speaking' : ''}}">
          <text>{{item.content}}</text>
          <view wx:if="{{chatState === 'speaking' && index === messages.length - 1 && !item.typing}}" class="speaking-indicator">
            <view class="speaking-bar"></view>
            <view class="speaking-bar"></view>
            <view class="speaking-bar"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 正在输入 -->
    <view wx:if="{{chatState === 'thinking'}}" class="row row--egg">
      <egg-avatar size="{{28}}" gradient-from="#EDE78E" gradient-to="#F4B9AE"></egg-avatar>
      <view class="bubble bubble--egg typing">
        <view class="dot"></view><view class="dot"></view><view class="dot"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 输入栏 -->
  <view class="composer">
    <input class="composer__input" value="{{draft}}" placeholder="说点什么…"
           confirm-type="send" bindinput="onInput" bindconfirm="onSend"
           disabled="{{chatState === 'thinking'}}" />
    <view class="composer__send {{chatState === 'thinking' ? 'composer__send--disabled' : ''}}" hover-class="composer__send--pressed" bindtap="onSend">
      <view class="composer__send-arrow"></view>
    </view>
  </view>
</view>
