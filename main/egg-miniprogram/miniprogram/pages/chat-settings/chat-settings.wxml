<view class="page">
  <nav-bar title="对话设置"></nav-bar>

  <view class="content">

    <view class="section">
      <text class="section-title">导出聊天记录</text>
      <text class="section-desc">将你的全部对话整理成文件，发送到指定邮箱。</text>

      <view class="input-wrap {{emailFocus ? 'input-wrap--focus' : ''}} {{error ? 'input-wrap--error' : ''}}">
        <input
          class="email-input"
          type="text"
          value="{{email}}"
          placeholder="请输入接收邮箱"
          placeholder-class="placeholder"
          bindinput="onEmailInput"
          bindfocus="onEmailFocus"
          bindblur="onEmailBlur"
        />
      </view>
      <text wx:if="{{error}}" class="error">{{error}}</text>

      <button
        class="primary"
        hover-class="primary--pressed"
        loading="{{submitting}}"
        disabled="{{submitting}}"
        bindtap="onExport"
      >{{submitting ? '提交中…' : '导出并发送到邮箱'}}</button>
    </view>

  </view>
</view>
