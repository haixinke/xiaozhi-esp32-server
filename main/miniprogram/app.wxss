/* 全局样式 - 深色主题 */
page {
  background-color: #0f0f1a;
  color: #e0e0e0;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  height: 100%;
  overflow: hidden;
}

/* 容器 */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 文本颜色层级 */
.text-primary {
  color: #ffffff;
}

.text-secondary {
  color: #a0a0b0;
}

.text-muted {
  color: #6b6b80;
}

/* 主色调 */
.text-accent {
  color: #6c63ff;
}

/* 按钮基础 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.7;
}

.btn-primary {
  background: linear-gradient(135deg, #6c63ff, #4834d4);
  color: #ffffff;
}

.btn-secondary {
  background: rgba(108, 99, 255, 0.15);
  color: #6c63ff;
  border: 1rpx solid rgba(108, 99, 255, 0.3);
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 30rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 加载状态 */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  color: #a0a0b0;
  font-size: 26rpx;
}

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
}
