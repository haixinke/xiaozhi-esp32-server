.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; display: flex; flex-direction: column; padding: 48rpx; box-sizing: border-box; }

/* 分段控件 */
.segment { display: flex; background: #F2F1EE; border-radius: 999rpx; padding: 6rpx; margin-bottom: 48rpx; }
.segment__item {
  flex: 1; height: 72rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600; color: #5C5C5C;
}
.segment__item.is-active { background: #002900; color: #FFFFFF; }

/* 扫码框 */
.scan-frame {
  width: 100%; height: 440rpx; border-radius: 48rpx; border: 4rpx dashed #CFCBC4; background: #FFFFFF;
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx;
  box-sizing: border-box; margin-bottom: 40rpx;
}
.scan-icon { width: 72rpx; height: 72rpx; border: 4rpx solid #8C8C88; border-radius: 12rpx; }
.scan-tip { font-size: 26rpx; color: #8C8C88; padding: 0 40rpx; text-align: center; }
.scan-ok { font-size: 26rpx; color: #54632C; }
.spinner {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  border: 6rpx solid #E5E3DF; border-top-color: #002900; animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* 输入凭证码 */
.code-block { margin-bottom: 40rpx; }
.label { display: block; font-size: 24rpx; color: #8C8C88; margin-bottom: 16rpx; }
.code-input {
  width: 100%; height: 96rpx; border-radius: 24rpx; border: 1rpx solid #CFCBC4;
  padding: 0 32rpx; font-size: 28rpx; color: #1A1A1A; box-sizing: border-box; background: #FFFFFF;
}

.error { font-size: 24rpx; color: #D9463C; margin-bottom: 24rpx; }
.note {
  font-size: 24rpx; color: #8C8C88; line-height: 1.7;
  background: #FFFFFF; border-radius: 24rpx; padding: 28rpx 32rpx; box-sizing: border-box;
}
.spacer { flex: 1; }

/* 成功浮层 */
.success-mask {
  position: fixed; inset: 0; background: rgba(250,250,248,0.97);
  display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 80;
}
.success-egg-stage { position: relative; width: 260rpx; height: 260rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 40rpx; }
.success-glow {
  position: absolute; width: 220rpx; height: 220rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(237,231,142,0.6) 0%, rgba(255,255,255,0) 70%);
  animation: glowPulse 1.2s ease-in-out infinite;
}
.success-egg {
  position: relative; width: 160rpx; height: 188rpx; border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
  border: 4rpx solid #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(0,41,0,0.10);
  background: linear-gradient(160deg, #EDE78E, #F4B9AE);
  animation: popIn 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
.success-text { font-size: 32rpx; font-weight: 600; color: #1A1A1A; }
@keyframes glowPulse { 0%, 100% { opacity: 0.55; transform: scale(1); } 50% { opacity: 0.9; transform: scale(1.15); } }
@keyframes popIn { 0% { transform: scale(0); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
