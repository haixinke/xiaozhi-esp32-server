.page{display:flex;flex-direction:column;height:100vh;background:#FAFAF8}.content{flex:1;display:flex;flex-direction:column;padding:58rpx 42rpx 50rpx}.kicker{font-size:20rpx;letter-spacing:4rpx;color:#809044}.title{margin-top:20rpx;width:590rpx;font-size:40rpx;font-weight:600;line-height:1.45;color:#002900}.options{margin-top:52rpx}.option{height:112rpx;margin-bottom:20rpx;padding:0 30rpx;border-radius:28rpx;border:2rpx solid #E1DFD8;background:#FFF;display:flex;align-items:center;gap:24rpx;font-size:28rpx}.option--selected{border-color:#9DB65B;background:#F5F8ED}.radio{width:38rpx;height:38rpx;border-radius:50%;border:2rpx solid #B9B7B0;display:flex;align-items:center;justify-content:center}.option--selected .radio{border-color:#54632C}.radio-dot{width:20rpx;height:20rpx;border-radius:50%;background:#54632C}.spacer{flex:1}.primary{height:94rpx;line-height:94rpx;border:0;border-radius:999rpx;background:#002900;color:#FFF;font-size:29rpx}.primary--disabled{opacity:.35}.primary::after{border:none}
