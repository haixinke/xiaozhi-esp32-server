.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 30rpx 40rpx 60rpx; box-sizing: border-box; }
.progress-card { padding: 38rpx; border-radius: 34rpx; background: #002900; color: #FFF; box-shadow: 0 18rpx 38rpx rgba(0,41,0,.16); }
.progress-copy { display: flex; align-items: flex-end; justify-content: space-between; }
.progress-kicker { font-size: 20rpx; letter-spacing: 4rpx; color: #C9D5A6; }
.progress-number { font-size: 52rpx; font-weight: 600; line-height: 1; }
.progress-track { height: 12rpx; margin-top: 28rpx; border-radius: 999rpx; overflow: hidden; background: rgba(255,255,255,.18); }
.progress-fill { height: 100%; background: #EDE78E; border-radius: 999rpx; }
.progress-note { display: block; margin-top: 20rpx; font-size: 23rpx; color: #CFD9C0; }
.section-title { display: block; margin: 42rpx 4rpx 20rpx; font-size: 28rpx; font-weight: 600; }
.task-list { background: #FFF; border: 1rpx solid #E7E5DF; border-radius: 32rpx; overflow: hidden; }
.task { min-height: 132rpx; display: flex; align-items: center; padding: 24rpx 28rpx; border-bottom: 1rpx solid #EEECE6; }
.task:last-child { border-bottom: none; }
.task-status { width: 54rpx; height: 54rpx; border-radius: 50%; background: #F0F4E4; color: #54632C; display: flex; align-items: center; justify-content: center; font-size: 23rpx; font-weight: 600; margin-right: 22rpx; }
.task--done .task-status { background: #9DB65B; color: #FFF; }
.task-copy { flex: 1; }
.task-title { display: block; font-size: 28rpx; font-weight: 600; }
.task-desc { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8C8C88; }
.task-side { display: flex; align-items: center; gap: 14rpx; }
.task-reward { font-size: 21rpx; color: #77843E; }
.task-arrow { font-size: 38rpx; color: #B5B2AA; }
.task--done .task-title { color: #77756E; }
.quiet-note { margin-top: 28rpx; padding: 26rpx 28rpx; border-radius: 24rpx; background: #FAFAEF; color: #6E6B35; font-size: 23rpx; line-height: 1.65; }
