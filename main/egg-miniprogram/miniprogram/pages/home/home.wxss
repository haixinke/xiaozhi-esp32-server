.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 30rpx 40rpx 48rpx; box-sizing: border-box; }
.content--incubating { height: 100vh; padding: 0; overflow: hidden; }
/* 破壳后故事场景：禁用 scroll-view 滚动（见 home.wxml scroll-y 条件），
   真机上原生滚动容器会截获平移手势导致背景拖不动；整屏内容均为 fixed 层，无需滚动 */
.content--story { height: 100vh; padding: 0; overflow: hidden; }
.empty-state { min-height: 1040rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-orbit { width: 300rpx; height: 300rpx; border-radius: 50%; border: 2rpx dashed #D8D6C8; display: flex; align-items: center; justify-content: center; margin-bottom: 50rpx; background: radial-gradient(circle, rgba(237,231,142,.22), transparent 68%); }
.empty-egg { width: 150rpx; height: 184rpx; border-radius: 52% 48% 48% 52% / 61% 59% 41% 39%; border: 4rpx solid #D7D4CA; background: #FFF; }
.empty-title { font-size: 42rpx; font-weight: 600; color: #002900; }
.empty-desc { width: 520rpx; margin: 22rpx 0 48rpx; font-size: 27rpx; line-height: 1.75; color: #6D6B65; }
.empty-note { margin-top: 22rpx; font-size: 22rpx; line-height: 1.6; color: #9A9890; text-align: center; }
.pet-restore-error .empty-orbit { border-color: #E1C9C0; background: radial-gradient(circle, rgba(244,185,174,.20), transparent 68%); }
.primary-button { width: 100%; height: 94rpx; line-height: 94rpx; padding: 0; border: none; border-radius: 999rpx; background: #002900; color: white; font-size: 29rpx; font-weight: 600; }
.primary-button::after { border: none; }
.friend-invite-card { width: 100%; margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #D9E3C2; border-radius: 28rpx; box-sizing: border-box; background: #F5F8ED; text-align: left; }
.friend-invite-title { display: block; font-size: 30rpx; font-weight: 600; color: #002900; }
.friend-invite-copy { display: block; margin: 10rpx 0 22rpx; font-size: 24rpx; color: #6D6B65; }
.pet-view { padding-bottom: 30rpx; }
/* 破壳后故事场景：故事引擎场景图作全屏背景（轨道可横向拖拽），原有内容浮于其上；
   fixed 层置于 scroll-view 外避免裁剪白边，内容层 z-index 1 压住背景轨道 */
.pet-view--story { position: relative; z-index: 1; min-height: 100vh; }
.story-track { position: fixed; z-index: 0; top: 0; left: 0; width: 200vw; height: 100vh; will-change: transform; }
.story-bg { display: block; width: 200vw; height: 100vh; }
.story-bg-mask { position: absolute; z-index: 1; top: 0; left: 0; width: 200vw; height: 100vh; pointer-events: none; background: linear-gradient(180deg, rgba(22,31,24,.30), rgba(22,31,24,0) 30%, rgba(22,31,24,0) 60%, rgba(22,31,24,.34)); }
.pet-view--story .top-row, .pet-view--story .egg-zone { position: relative; z-index: 2; }
.pet-view--story .eyebrow { color: rgba(255,255,255,.88); text-shadow: 0 2rpx 10rpx rgba(22,31,24,.5); }
.pet-view--story .pet-name--plain { color: #FFF; text-shadow: 0 2rpx 12rpx rgba(22,31,24,.55); }
/* 卧室窗户热区：轨道 right:3% width:19% 位置（200vw 兜底值换算为视口坐标），
   图片加载后由 onStoryBgLoad 按真实轨道宽重写 left/width；独立置于内容层之上；用与轨道相同的 translateX 跟随拖拽 */
.story-window-hotspot { position: fixed; z-index: 4; top: 15vh; left: 156vw; width: 38vw; height: 32vh; border-radius: 24rpx; will-change: transform; }
/* 左下角聊天入口：静态项目同款 112rpx 圆形玻璃质感按钮，内嵌 72rpx 原型 icon */
.story-chat-entry { position: fixed; z-index: 4; left: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.story-chat-button { width: 112rpx; height: 112rpx; display: flex; align-items: center; justify-content: center; border: 1rpx solid rgba(255,255,255,.78); border-radius: 50%; background: linear-gradient(145deg, rgba(255,254,249,.97), rgba(230,235,224,.96)); box-shadow: 0 11rpx 25rpx rgba(34,45,36,.18), inset 0 3rpx 4rpx rgba(255,255,255,.94), inset 0 -4rpx 8rpx rgba(96,112,91,.1); transition: transform .16s ease, box-shadow .16s ease; }
.story-chat-button--pressed { transform: scale(.98); box-shadow: 0 5rpx 12rpx rgba(34,45,36,.15), inset 0 3rpx 6rpx rgba(96,112,91,.12); }
.story-chat-icon { display: block; width: 72rpx; height: 72rpx; filter: drop-shadow(0 5rpx 5rpx rgba(57,65,50,.16)); }
.pet-view--incubating { position: relative; width: 100vw; height: 100vh; padding: 0; overflow: hidden; }
.top-row { display: flex; justify-content: space-between; align-items: center; }
.pet-view--incubating .top-row { position: absolute; z-index: 20; left: 34rpx; right: 34rpx; }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: #829047; }
.pet-name { display: block; margin-top: 10rpx; font-size: 42rpx; font-weight: 600; color: #1A1A1A; }
.pet-name--plain { margin-top: 10rpx; }
.pet-name-row { max-width: 440rpx; min-height: 64rpx; display: flex; align-items: center; padding: 0 22rpx; box-sizing: border-box; border: 1rpx solid rgba(239,235,220,.92); border-radius: 999rpx; background: rgba(255,252,243,.82); box-shadow: 0 8rpx 24rpx rgba(61,51,35,.12), inset 0 1rpx 0 rgba(255,255,255,.82); }
.pet-name-row .pet-name { margin-top: 0; overflow: hidden; color: #294732; font-size: 34rpx; line-height: 1.15; letter-spacing: 1rpx; text-overflow: ellipsis; white-space: nowrap; }
.progress-ring { width: 86rpx; height: 86rpx; border-radius: 50%; border: 8rpx solid #DCE5C1; display: flex; align-items: center; justify-content: center; color: #54632C; font-size: 23rpx; font-weight: 600; }
.egg-zone { position: relative; height: 600rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.egg-zone--incubating { width: 100vw; height: 100vh; margin: 0; }
.feedback-bubble { position: absolute; z-index: 5; top: 48rpx; max-width: 480rpx; padding: 18rpx 26rpx; border-radius: 28rpx 28rpx 28rpx 8rpx; background: #FFF; box-shadow: 0 12rpx 36rpx rgba(0,41,0,.10); font-size: 25rpx; color: #3D4930; animation: bubbleIn .25s ease-out; }
.feedback-bubble--incubating { z-index: 24; left: 50%; transform: translateX(-50%); }
.cuddle-track { position: absolute; z-index: 24; bottom: 220rpx; left: 50%; margin-left: -140rpx; width: 280rpx; height: 8rpx; border-radius: 999rpx; overflow: hidden; background: rgba(255,255,255,.6); }
.cuddle-fill { height: 100%; border-radius: 999rpx; background: #9DB65B; transition: width .1s linear; }
/* 今日状态 + 心情一句话：固定页面底部（避开左下角聊天按钮），黑色字体 */
.status-daily { position: fixed; z-index: 2; left: 168rpx; right: 40rpx; bottom: calc(48rpx + env(safe-area-inset-bottom)); margin: 0; padding: 0; text-align: left; }
.status-meta { display: block; font-size: 21rpx; line-height: 1.5; color: #1A1A1A; text-shadow: 0 1rpx 8rpx rgba(255,255,255,.65); }
.status-line { display: block; margin-top: 8rpx; font-size: 28rpx; line-height: 1.55; color: #1A1A1A; text-shadow: 0 1rpx 8rpx rgba(255,255,255,.65); }
.phone-auth-mask { position: fixed; z-index: 9998; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(0,41,0,.42); }
.phone-auth-dialog { width: 100%; padding: 52rpx 44rpx 34rpx; border-radius: 36rpx; box-sizing: border-box; background: #FFF; box-shadow: 0 24rpx 64rpx rgba(0,41,0,.18); text-align: center; }
.phone-auth-title { display: block; font-size: 34rpx; font-weight: 600; color: #002900; }
.phone-auth-copy { display: block; margin: 20rpx 0 42rpx; font-size: 26rpx; color: #6D6B65; }
.phone-auth-cancel { margin-top: 20rpx; padding: 0; border: none; background: transparent; color: #7B796F; font-size: 26rpx; }
.phone-auth-cancel::after { border: none; }
.hatch-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #000; z-index: 9999; display: flex; align-items: center; justify-content: center; }
.hatch-video { width: 100vw; height: 100vh; }
/* 陪伴入口：孵化期悬浮于场景右下，位于自定义 tabBar 按钮左侧 */
.companion-section { margin-top: 28rpx; padding: 0 12rpx; }
.companion-section--incubating { position: absolute; z-index: 22; right: 162rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); margin: 0; padding: 0; }
.companion-primary-dock { width: 368rpx; min-width: 0; height: 112rpx; display: flex; flex-direction: row; align-items: stretch; overflow: hidden; padding: 0 15rpx; box-sizing: border-box; border: 1rpx solid rgba(225,226,211,.9); border-radius: 56rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(43,55,39,.1), inset 0 1rpx 0 rgba(255,255,255,.72); }
.companion-item { position: relative; min-width: 0; display: flex; align-items: center; justify-content: center; box-sizing: border-box; text-align: center; transition: transform .16s ease, background .16s ease, opacity .16s ease; }
.companion-primary-dock .companion-item { width: 112rpx; height: 112rpx; min-height: 112rpx; flex: 0 0 112rpx; padding: 25rpx; }
.companion-item--learn::before, .companion-item--draw::before { position: absolute; left: 0; top: 22rpx; bottom: 22rpx; width: 1rpx; content: ""; background: rgba(64,82,57,.12); }
.companion-item--pressed { opacity: .9; transform: scale(.98); }
.companion-primary-dock .companion-item--pressed { background: #F7F7F4; }
.companion-icon-wrap { position: relative; width: 62rpx; height: 62rpx; flex: 0 0 62rpx; display: flex; align-items: center; justify-content: center; overflow: hidden; border-radius: 50%; background: transparent; }
.companion-icon { width: 62rpx; height: 62rpx; display: block; }
.companion-item--draw .companion-icon-wrap { overflow: visible; }
.companion-item--locked .companion-icon { filter: grayscale(1); opacity: .62; }
.companion-item--locked .companion-icon-wrap::after { position: absolute; inset: 0; border-radius: 50%; content: ""; background: rgba(112,117,108,.24); pointer-events: none; }
.draw-action-spark { position: absolute; right: -4rpx; top: -7rpx; color: #E1B24D; font-size: 25rpx; text-shadow: 0 2rpx 4rpx rgba(74,59,25,.12); transform: rotate(12deg); }
.hatch-entry { position: absolute; z-index: 24; left: 40rpx; right: 40rpx; bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.hatch-entry .primary-button { width: 100%; height: 94rpx; border-radius: 999rpx; background: #002900; color: white; font-size: 29rpx; font-weight: 600; }
/* 命名弹层 */
.name-mask { position: fixed; z-index: 120; inset: 0; display: flex; align-items: flex-end; background: linear-gradient(180deg, rgba(22,31,24,.08), rgba(22,31,24,.34)); }
.name-sheet { width: 100%; max-height: 78vh; min-height: 0; display: flex; flex-direction: column; overflow-y: auto; padding: 28rpx 40rpx calc(36rpx + env(safe-area-inset-bottom)); box-sizing: border-box; border-radius: 42rpx 42rpx 0 0; background: #FFFDF8; box-shadow: 0 -18rpx 48rpx rgba(20,31,22,.16); animation: name-sheet-rise .32s cubic-bezier(.22,.61,.36,1) both; }
.name-handle { width: 72rpx; height: 8rpx; flex: 0 0 auto; margin: 0 auto 30rpx; border-radius: 999rpx; background: #D8D8D1; }
.name-sheet-content { width: 100%; margin: 0; }
.name-sheet-title { display: block; color: #26372C; font-size: 38rpx; font-weight: 600; text-align: center; }
.name-sheet-copy { display: block; margin: 16rpx auto 28rpx; color: #777B75; font-size: 23rpx; line-height: 1.6; text-align: center; }
.name-input-wrap { position: relative; }
.name-input { height: 94rpx; padding: 0 100rpx 0 26rpx; border: 2rpx solid #DDE4D7; border-radius: 22rpx; background: #FFF; color: #26372C; font-size: 30rpx; }
.name-count { position: absolute; top: 34rpx; right: 24rpx; color: #9A9C96; font-size: 20rpx; }
.name-error { display: block; margin-top: 14rpx; color: #B84B45; font-size: 21rpx; }
.name-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 22rpx; }
.name-save, .name-skip { height: 96rpx; margin: 0; padding: 0; border-radius: 999rpx; font-size: 26rpx; line-height: 96rpx; }
.name-save { flex: 1 1 62%; background: #002900; color: #FFF; }
.name-skip { flex: 0 0 30%; background: transparent; color: #777B75; }
.name-save::after, .name-skip::after { border: 0; }
@keyframes bubbleIn { from { transform: translateY(8rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
@keyframes name-sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }

/* 临时测试：场景切换器（正式上线前删除） */
.scene-tester { position: fixed; z-index: 90; right: 28rpx; width: 270rpx; }
.scene-tester-button { min-height: 64rpx; display: flex; align-items: center; justify-content: center; gap: 8rpx; padding: 0 12rpx; box-sizing: border-box; border: 1rpx solid rgba(225,229,215,.95); border-radius: 999rpx; background: rgba(255,253,247,.92); box-shadow: 0 9rpx 26rpx rgba(44,54,39,.14); color: #3F5543; font-size: 20rpx; font-weight: 600; backdrop-filter: blur(10rpx); }
.scene-tester-button--open { border-color: rgba(133,157,102,.82); }
.scene-tester-tag { flex: none; padding: 5rpx 8rpx; border-radius: 9rpx; background: #EDF2E3; color: #71834F; font-size: 20rpx; letter-spacing: 1rpx; }
.scene-tester-current { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-tester-chevron { flex: none; margin-top: -5rpx; color: #829073; font-size: 22rpx; }
.scene-tester-menu { width: 320rpx; max-height: 700rpx; margin-top: 10rpx; margin-left: -50rpx; padding: 7rpx; box-sizing: border-box; border: 1rpx solid rgba(225,229,215,.96); border-radius: 22rpx; background: rgba(255,253,247,.97); box-shadow: 0 15rpx 38rpx rgba(44,54,39,.18); backdrop-filter: blur(12rpx); }
.scene-tester-option { min-height: 58rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 15rpx; border-radius: 999rpx; color: #586458; font-size: 20rpx; }
.scene-tester-option--active { background: #EEF3E5; color: #36513C; font-weight: 600; }
.scene-tester-option-label { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.scene-tester-option-check { flex: none; margin-left: 8rpx; color: #36513C; }
