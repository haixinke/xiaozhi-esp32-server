/* components/chat-bubble/chat-bubble.wxss */
/* Ethereal Companion Design System - 完美女女友主题 */

.cb-row {
  display: flex;
  flex-direction: column;
  margin: 0 0 24rpx;
  max-width: 100%;
  animation: cb-enter 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cb-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cb-row.cb-user {
  align-items: flex-end;
}
.cb-row.cb-assistant {
  align-items: flex-start;
}

/* ----- 角色标签 ----- */
.cb-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 18rpx;
  margin-bottom: 8rpx;
}

.cb-tag {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  color: rgba(134, 78, 90, 0.6);
}

.cb-row.cb-user .cb-tag {
  color: rgba(134, 78, 90, 0.85);
}
.cb-row.cb-assistant .cb-tag {
  color: rgba(134, 78, 90, 0.85);
}

.cb-pin {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
}

.cb-row.cb-user .cb-pin {
  background: rgba(134, 78, 90, 0.7);
  box-shadow: 0 0 8rpx rgba(134, 78, 90, 0.6);
}
.cb-row.cb-assistant .cb-pin {
  background: rgba(134, 78, 90, 0.7);
  box-shadow: 0 0 8rpx rgba(134, 78, 90, 0.6);
}

.cb-row.cb-user .cb-meta {
  flex-direction: row-reverse;
}

/* ----- 气泡 ----- */
.cb-bubble {
  position: relative;
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 32rpx;
  overflow: hidden;
  isolation: isolate;
}

.cb-row.cb-user .cb-bubble {
  border-top-right-radius: 32rpx;
  border-bottom-right-radius: 0; /* 右下角直角 */
  background: rgba(255, 183, 193, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.2);
}

.cb-row.cb-assistant .cb-bubble {
  border-top-left-radius: 32rpx;
  border-bottom-left-radius: 0; /* 左下角直角 */
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.1);
}

/* assistant 左侧的指示线 */
.cb-row.cb-assistant .cb-bubble::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: linear-gradient(180deg, #fbb3c1, transparent);
  opacity: 0.7;
}

/* 流式时的边光 */
.cb-glow {
  position: absolute;
  inset: -1rpx;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(120deg,
    transparent 30%,
    rgba(255, 183, 193, 0.35) 50%,
    transparent 70%);
  background-size: 200% 100%;
  z-index: -1;
}

.cb-typing .cb-glow {
  opacity: 1;
  animation: cb-shimmer 2.4s linear infinite;
}

@keyframes cb-shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -100% 0; }
}

/* ----- 文本 ----- */
.cb-content {
  position: relative;
  display: block;
  word-break: break-word;
}

.cb-text {
  font-size: 30rpx;
  line-height: 1.65;
  color: #1b1c1c;
  letter-spacing: 0.5rpx;
}

.cb-row.cb-user .cb-text {
  color: #7b4551;
  font-weight: 500;
}

.cb-cursor {
  display: inline-block;
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 1;
  color: #864e5a;
  animation: cb-blink 1s steps(2, start) infinite;
  text-shadow: 0 0 12rpx rgba(134, 78, 90, 0.6);
}

/* ----- 时间戳 ----- */
.cb-time {
  display: block;
  font-size: 20rpx;
  color: rgba(134, 78, 90, 0.5);
  margin-top: 8rpx;
  line-height: 1;
}

@keyframes cb-blink {
  0%, 50%   { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}
