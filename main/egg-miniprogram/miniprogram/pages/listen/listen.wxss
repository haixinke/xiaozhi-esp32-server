.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.kicker { display: block; color: #809044; font-size: 20rpx; letter-spacing: 0; }
.title { display: block; margin-top: 18rpx; color: #17311F; font-size: 40rpx; font-weight: 600; }
.question-title { font-size: 30rpx; font-weight: 400; line-height: 1.55; }
.options { display: flex; flex-direction: column; gap: 16rpx; margin-top: 38rpx; }
.option { min-height: 112rpx; padding: 22rpx 30rpx; box-sizing: border-box; border: 2rpx solid #E1DFD8; border-radius: 999rpx; display: flex; align-items: center; gap: 24rpx; background: #FFF; }
.option--selected { border-color: #91A65A; background: #F3F7EB; }
.option-label { flex: 1; color: #374039; font-size: 25rpx; line-height: 1.45; }
.radio { width: 30rpx; height: 30rpx; flex: 0 0 auto; border: 2rpx solid #B9BDB7; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.radio-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #536B43; }
.primary { height: 96rpx; padding: 0; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 28rpx; font-weight: 400; display: flex; align-items: center; justify-content: center; }
.primary::after { border: none; }
.primary--disabled { background: #AEB9AE !important; color: rgba(255,255,255,.86) !important; }
.button-label { display: block; line-height: 1; }

.progress-area { flex: none; padding: 48rpx 42rpx 0; }
.meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 24rpx; }
.count { flex: none; color: #858A81; font-size: 24rpx; white-space: nowrap; }
.progress-track { height: 8rpx; margin-top: 24rpx; border-radius: 999rpx; background: #E5E5DB; overflow: hidden; }
.progress-fill { height: 100%; background: #91A65A; border-radius: 999rpx; transition: width .24s ease; }
.question-scroll, .feedback-scroll { flex: 1; min-height: 0; height: 0; }
.question-content { padding: 24rpx 42rpx 40rpx; }
.supplement { display: block; width: 100%; height: 180rpx; box-sizing: border-box; padding: 24rpx 28rpx; margin-top: 28rpx; border: 2rpx solid #CBD7B6; border-radius: 30rpx; background: #F2F6EB; color: #374039; font-size: 25rpx; line-height: 1.55; }
.supplement-placeholder { color: #858A81; }
.add-note { margin: 22rpx 0 0; padding: 0; background: transparent; color: #647064; font-size: 24rpx; text-align: left; line-height: normal; }
.add-note::after, .return::after { border: none; }
.question-footer { flex: none; display: flex; align-items: center; gap: 28rpx; padding: 28rpx 42rpx calc(40rpx + env(safe-area-inset-bottom)); }
.next-slot { flex: 1; min-width: 0; }
.question-footer .primary { width: 100%; margin: 0; }

.feedback-main { display: flex; flex-direction: column; box-sizing: border-box; min-height: 100%; padding: 56rpx 42rpx 0; }
.feedback-quote { flex: none; width: 100%; max-width: 666rpx; margin: 44rpx auto 0; text-align: left; }
.quote-mark { display: block; width: 60rpx; height: 60rpx; margin: 0 0 8rpx; }
.feedback-quote-copy { display: block; color: #17311F; font-size: 44rpx; font-weight: 400; line-height: 1.6; letter-spacing: 0; overflow-wrap: anywhere; }
.feedback-pet-stage { position: relative; flex: none; margin-top: auto; padding-top: 220rpx; }
.pet-portrait { display: block; width: 460rpx; height: 460rpx; margin: 0 auto; }
.feedback-reward-label { position: absolute; left: 50%; top: 0; width: 300rpx; min-height: 200rpx; transform: translateX(-50%); box-sizing: border-box; }
.feedback-reward-label__copy { position: absolute; left: 50%; top: 50%; z-index: 1; transform: translate(-50%, -50%); color: #17311F; font-size: 32rpx; font-weight: 500; line-height: 1.4; white-space: nowrap; }
.feedback-reward-dots { color: #FFDD79; font-weight: 600; }
.feedback-reward-spark { position: absolute; pointer-events: none; }
.feedback-reward-spark--1 { left: 14rpx; top: 17rpx; width: 62rpx; height: 56rpx; }
.feedback-reward-spark--2 { right: 31rpx; top: 10rpx; width: 62rpx; height: 69rpx; }
.feedback-reward-spark--3 { right: 54rpx; top: 113rpx; width: 63rpx; height: 71rpx; }
.reply-copy { display: block; color: #647064; font-size: 23rpx; line-height: 1.55; overflow-wrap: anywhere; }
.feedback-footer { flex: none; display: flex; flex-direction: column; align-items: stretch; gap: 26rpx; padding: 36rpx 42rpx calc(40rpx + env(safe-area-inset-bottom)); max-width: 666rpx; width: 100%; margin: 0 auto; box-sizing: border-box; }
.feedback-footer .primary,
.feedback-footer .return { display: flex; align-items: center; justify-content: center; width: 100%; margin: 0; box-sizing: border-box; }
.return { height: 96rpx; padding: 0; border: 3rpx solid #002900; border-radius: 999rpx; background: #FFF; color: #002900; font-size: 28rpx; font-weight: 400; line-height: 28rpx; }
.error { display: block; margin-top: 18rpx; color: #A34B44; font-size: 22rpx; }
.empty-content { flex: 1; display: flex; flex-direction: column; align-items: stretch; padding: 80rpx 42rpx; }
.empty-content .reply-copy { margin-top: 24rpx; }
.empty-content .pet-portrait { margin-top: auto; }

.today-companion-award{position:absolute;left:50%;top:0;width:150rpx;height:150rpx;transform:translateX(-50%);pointer-events:none}
.today-companion-award__plus{position:absolute;left:100%;top:50%;margin-left:26rpx;margin-top:-34rpx;color:#FFDD79;font-size:44rpx;font-weight:700;line-height:68rpx;white-space:nowrap;text-shadow:0 2rpx 8rpx rgba(72,50,12,.35);transform-origin:30% 60%;animation:today-companion-award-plus .85s cubic-bezier(.2,.9,.3,1) .88s both}
.today-companion-award--reduced .today-companion-award__plus{animation:none}
@media (prefers-reduced-motion:reduce){.today-companion-award__plus{animation:none}}
@keyframes today-companion-award-plus{0%{opacity:0;transform:translate3d(-44rpx,20rpx,0) rotate(-160deg) scale(.5)}40%{opacity:1;transform:translate3d(4rpx,-14rpx,0) rotate(10deg) scale(1.08)}65%{transform:translate3d(0,4rpx,0) rotate(-4deg) scale(.97)}85%{transform:translate3d(0,-2rpx,0) rotate(1deg) scale(1.01)}100%{opacity:1;transform:translate3d(0,0,0) rotate(0) scale(1)}}

@media (prefers-reduced-motion: reduce) { .progress-fill { transition: none; } }
@media (max-height: 700px) {
  .feedback-main { padding-top: 32rpx; }
  .feedback-quote { margin-top: 24rpx; }
  .feedback-pet-stage { padding-top: 140rpx; }
  .feedback-footer { padding-top: 16rpx; }
  .pet-portrait { width: 360rpx; height: 360rpx; }
}
