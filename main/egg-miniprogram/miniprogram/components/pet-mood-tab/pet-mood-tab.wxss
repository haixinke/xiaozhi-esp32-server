/* 破壳后左上角心情卡片：移植自 eggbabe-miniprogram 静态项目 pet-mood-tab，
   去掉 icon 与 tone 变体，仅保留 紧凑/展开 两态宽度过渡 */
.pet-mood-tab { display: inline-flex; width: 218rpx; max-width: 380rpx; flex-direction: column; align-items: stretch; padding: 8rpx 14rpx 9rpx; box-sizing: border-box; border: 1rpx solid rgba(255,255,255,.72); border-radius: 24rpx; background: rgba(255,253,247,.9); box-shadow: 0 6rpx 18rpx rgba(37,46,35,.08), inset 0 1rpx 0 rgba(255,255,255,.58); color: #314238; overflow: hidden; transform: translate3d(0,0,0); transform-origin: 0 0; will-change: width; pointer-events: auto; transition: width 420ms cubic-bezier(.16,1,.3,1), padding 360ms cubic-bezier(.16,1,.3,1), border-radius 360ms ease, background 220ms ease; }
.pet-mood-tab--expanded { width: 380rpx; padding-top: 10rpx; padding-bottom: 8rpx; border-radius: 28rpx; }
.pet-mood-tab--compact { width: 218rpx; }
.pet-mood-tab__name { display: block; max-width: 100%; overflow: hidden; color: #294732; font-size: 24rpx; font-weight: 600; line-height: 1.25; letter-spacing: .5rpx; text-overflow: ellipsis; white-space: nowrap; }
.pet-mood-tab__mood-summary { display: flex; max-width: 100%; align-items: center; overflow: hidden; margin-top: 10rpx; white-space: nowrap; }
.pet-mood-tab__eyebrow { flex: none; color: #748078; font-size: 20rpx; font-weight: 600; letter-spacing: .4rpx; }
.pet-mood-tab__mood-label { overflow: hidden; color: #31463A; font-size: 22rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
/* 一句话默认收起（max-height 0），展开时做 高度+透明度+位移 的联合过渡 */
.pet-mood-tab__sentence { width: 0; max-height: 0; overflow: hidden; margin-top: 0; opacity: 0; transform: translate3d(0,-5rpx,0); will-change: max-height,opacity,transform; transition: max-height 280ms cubic-bezier(.16,1,.3,1), margin-top 280ms cubic-bezier(.16,1,.3,1), opacity 140ms ease-out, transform 220ms cubic-bezier(.16,1,.3,1); }
.pet-mood-tab--expanded .pet-mood-tab__sentence { width: auto; max-width: 100%; }
.pet-mood-tab__sentence--visible { max-height: 60rpx; margin-top: 5rpx; opacity: 1; transform: translate3d(0,0,0); }
.pet-mood-tab__text { display: block; color: #303A32; font-size: 20rpx; line-height: 1.35; overflow-wrap: anywhere; word-break: break-word; }
@media (prefers-reduced-motion: reduce) { .pet-mood-tab, .pet-mood-tab__sentence { transition: none; } }
