<!--components/chat-bubble/chat-bubble.wxml-->
<view class="cb-row cb-{{role}} {{typing ? 'cb-typing' : ''}}">
  <view class="cb-bubble">
    <view class="cb-glow"></view>
    <view class="cb-content">
      <text class="cb-text" selectable="{{!typing}}">{{content}}</text>
      <text wx:if="{{typing}}" class="cb-cursor">▍</text>
    </view>
    <text class="cb-time" wx:if="{{!typing && time}}">{{time}}</text>
  </view>
</view>
