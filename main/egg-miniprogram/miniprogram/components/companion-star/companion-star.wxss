:host{display:inline-block;flex:none;line-height:0;vertical-align:middle}
.companion-star{position:relative;z-index:0;pointer-events:none}
.companion-star__body{position:absolute;z-index:1;inset:0}
.companion-star__pose{position:absolute;inset:0;width:100%;height:100%;display:block;transform-origin:50% 62%;backface-visibility:hidden}
.companion-star__pose--squeezed{opacity:0}
.companion-star__halo{position:absolute;z-index:0;left:-50%;top:-50%;width:200%;height:200%;border-radius:50%;opacity:0;background:radial-gradient(circle,rgba(255,221,121,.95) 0,rgba(247,204,110,.5) 34%,rgba(243,187,90,0) 70%)}
.companion-star__spark,.companion-star__dust{position:absolute;z-index:2;border-radius:50%;opacity:0;background:#FFE7A3;box-shadow:0 0 6rpx rgba(255,221,121,.75)}

/* 信件收星：约 2.0s。0.0–0.24s 入场，0.24–0.70s 横向挤压（PNG 硬切），0.70–1.0s 弹出落定，余下微幅回弹。 */
.companion-star--award .companion-star__body{animation:companion-star-enter 2s linear both}
.companion-star--award .companion-star__pose--neutral{animation:companion-star-neutral-shape 2s cubic-bezier(.22,1,.36,1) both,companion-star-neutral-show 2s step-end both}
.companion-star--award .companion-star__pose--squeezed{animation:companion-star-squeezed-shape 2s ease-in-out both,companion-star-squeezed-show 2s step-end both}
.companion-star--award .companion-star__halo{animation:companion-star-award-halo 2s ease-out both}
/* 光点在弹出后（≥0.72s）再出现，避免抢挤压节奏。 */
.companion-star__spark--1{left:-20rpx;top:70rpx;width:6rpx;height:6rpx;animation:companion-star-rise-l 1s ease-out .72s both}
.companion-star__spark--2{left:30rpx;top:20rpx;width:5rpx;height:5rpx;animation:companion-star-rise-m .95s ease-out .78s both}
.companion-star__spark--3{left:118rpx;top:28rpx;width:6rpx;height:6rpx;animation:companion-star-rise-s .9s ease-out .84s both}
.companion-star__spark--4{left:-8rpx;top:112rpx;width:5rpx;height:5rpx;animation:companion-star-rise-l 1s ease-out .9s both}
.companion-star__spark--5{left:76rpx;top:4rpx;width:8rpx;height:8rpx;animation:companion-star-rise-s .95s ease-out .96s both}
.companion-star__spark--6{left:156rpx;top:84rpx;width:5rpx;height:5rpx;animation:companion-star-rise-m .9s ease-out 1.02s both}
.companion-star__spark--7{left:46rpx;top:128rpx;width:6rpx;height:6rpx;animation:companion-star-rise-m 1s ease-out 1.08s both}

/* 房间左上角：常驻极轻呼吸光；关信件时光晕亮一下并落入 3 粒光尘，星体不位移、不放大。 */
.companion-star--room{margin:0 -2rpx}
.companion-star--accent{display:inline-block;vertical-align:middle}
.companion-star--accent .companion-star__halo{display:none}
.companion-star--room .companion-star__halo{animation:companion-star-breathe 3.8s ease-in-out infinite}
.companion-star--room.companion-star--pulse .companion-star__halo{animation:companion-star-room-pulse 1.2s ease-out both}
.companion-star--room.companion-star--pulse .companion-star__pose--neutral{animation:companion-star-room-brighten 1.2s ease-out both}
.companion-star__dust{width:3rpx;height:3rpx}
.companion-star__dust--1{left:calc(50% + 12rpx);top:calc(50% - 16rpx);animation:companion-star-dust-1 .8s ease-in both}
.companion-star__dust--2{left:calc(50% - 9rpx);top:calc(50% - 17rpx);animation:companion-star-dust-2 .8s ease-in .12s both}
.companion-star__dust--3{left:calc(50% + 17rpx);top:calc(50% - 8rpx);animation:companion-star-dust-3 .8s ease-in .24s both}

.companion-star--reduced .companion-star__body,.companion-star--reduced .companion-star__pose{animation:none!important;opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.companion-star__body,.companion-star__pose,.companion-star__halo,.companion-star__spark,.companion-star__dust{animation:none!important}.companion-star__pose--squeezed,.companion-star__spark,.companion-star__dust,.companion-star__halo{opacity:0}}

@keyframes companion-star-enter{0%{opacity:0;transform:scale(.86)}6%{opacity:1;transform:scale(.98)}12%{opacity:1;transform:scale(1)}100%{opacity:1;transform:scale(1)}}
@keyframes companion-star-neutral-shape{
  0%{transform:translate3d(0,0,0) scale(.88,.88)}
  12%{transform:translate3d(0,0,0) scale(1,1)}
  24%{transform:translate3d(0,0,0) scale(1,1)}
  35%{transform:translate3d(0,0,0) scale(.84,1.06)}
  42%{transform:translate3d(0,-14%,0) scale(1.18,1.1)}
  52%{transform:translate3d(0,-4%,0) scale(1.06,1.04)}
  62%{transform:translate3d(0,0,0) scale(.96,.98)}
  72%{transform:translate3d(0,0,0) scale(1.03,1.02)}
  82%{transform:translate3d(0,0,0) scale(.99,1)}
  100%{transform:translate3d(0,0,0) scale(1,1)}
}
@keyframes companion-star-neutral-show{0%{opacity:1}24%{opacity:0}35%{opacity:1}100%{opacity:1}}
@keyframes companion-star-squeezed-shape{
  0%{transform:translate3d(0,0,0) scale(1.174,1.05)}
  24%{transform:translate3d(0,0,0) scale(1.174,1.05)}
  30%{transform:translate3d(0,2%,0) scale(1.12,1.08)}
  35%{transform:translate3d(0,0,0) scale(1.105,1.061)}
  100%{transform:translate3d(0,0,0) scale(1.105,1.061)}
}
@keyframes companion-star-squeezed-show{0%{opacity:0}24%{opacity:1}35%{opacity:0}100%{opacity:0}}
@keyframes companion-star-award-halo{0%{opacity:0;transform:scale(.72)}8%{opacity:.04;transform:scale(.82)}24%{opacity:.08;transform:scale(.92)}38%{opacity:.24;transform:scale(1.05)}58%{opacity:.1;transform:scale(1.06)}100%{opacity:0;transform:scale(1.08)}}
@keyframes companion-star-rise-s{0%{opacity:0;transform:translate3d(0,0,0) scale(.55)}22%{opacity:.28;transform:translate3d(0,-8rpx,0) scale(.95)}100%{opacity:0;transform:translate3d(3rpx,-34rpx,0) scale(.65)}}
@keyframes companion-star-rise-m{0%{opacity:0;transform:translate3d(0,0,0) scale(.55)}22%{opacity:.26;transform:translate3d(2rpx,-10rpx,0) scale(.95)}100%{opacity:0;transform:translate3d(8rpx,-46rpx,0) scale(.65)}}
@keyframes companion-star-rise-l{0%{opacity:0;transform:translate3d(0,0,0) scale(.55)}22%{opacity:.3;transform:translate3d(-2rpx,-12rpx,0) scale(.95)}100%{opacity:0;transform:translate3d(-8rpx,-58rpx,0) scale(.65)}}
@keyframes companion-star-breathe{0%{opacity:.05}50%{opacity:.16}100%{opacity:.05}}
@keyframes companion-star-room-pulse{0%{opacity:.05;transform:scale(1)}17%{opacity:.45;transform:scale(1.12)}100%{opacity:.05;transform:scale(1)}}
@keyframes companion-star-room-brighten{0%{filter:brightness(1)}17%{filter:brightness(1.14)}100%{filter:brightness(1)}}
@keyframes companion-star-dust-1{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.35}100%{opacity:0;transform:translate3d(-12rpx,16rpx,0)}}
@keyframes companion-star-dust-2{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.32}100%{opacity:0;transform:translate3d(9rpx,17rpx,0)}}
@keyframes companion-star-dust-3{0%{opacity:0;transform:translate3d(0,0,0)}35%{opacity:.3}100%{opacity:0;transform:translate3d(-17rpx,8rpx,0)}}
