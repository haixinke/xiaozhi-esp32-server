.page { position: relative; height: 100vh; overflow: hidden; background: #F8F7EF; }
.loading { position: absolute; top: 0; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: center; z-index: 1; }
.loading-spinner { width: 64rpx; height: 64rpx; border-radius: 50%; border: 5rpx solid rgba(0,41,0,.10); border-top-color: #002900; animation: spin 0.7s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.halo { position: absolute; border-radius: 50%; filter: blur(4rpx); }
.halo--one { width: 540rpx; height: 540rpx; right: -220rpx; top: 120rpx; background: rgba(237,231,142,.35); }
.halo--two { width: 420rpx; height: 420rpx; left: -210rpx; top: 430rpx; background: rgba(244,185,174,.22); }
.brand { position: relative; z-index: 2; padding: 142rpx 56rpx 0; }
.brand-kicker { display: block; font-size: 20rpx; letter-spacing: 7rpx; color: #78863D; font-weight: 600; }
.brand-name { display: block; margin-top: 18rpx; font-size: 68rpx; line-height: 1; font-weight: 600; color: #002900; }
.brand-slogan { display: block; margin-top: 24rpx; font-size: 27rpx; color: #6C6A62; letter-spacing: 1rpx; }
.egg-stage { position: relative; height: 590rpx; display: flex; justify-content: center; align-items: center; }
.egg-shadow { position: absolute; bottom: 76rpx; width: 250rpx; height: 48rpx; border-radius: 50%; background: rgba(0,41,0,.12); filter: blur(12rpx); }
.egg { position: relative; width: 278rpx; height: 340rpx; border-radius: 52% 48% 47% 53% / 61% 58% 42% 39%; background: linear-gradient(155deg, #FFFDF0 8%, #EDE78E 54%, #F4B9AE 120%); box-shadow: inset -18rpx -20rpx 32rpx rgba(174,158,80,.18), 0 32rpx 70rpx rgba(84,99,44,.18); animation: breathe 3.4s ease-in-out infinite; }
.egg-shine { position: absolute; width: 58rpx; height: 122rpx; border-radius: 50%; top: 64rpx; left: 54rpx; background: rgba(255,255,255,.58); transform: rotate(18deg); }
.egg-speck { position: absolute; border-radius: 50%; background: rgba(0,41,0,.10); }
.egg-speck--one { width: 16rpx; height: 16rpx; top: 108rpx; right: 58rpx; }
.egg-speck--two { width: 10rpx; height: 10rpx; bottom: 92rpx; left: 78rpx; }
@keyframes breathe { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-14rpx) rotate(1deg); } }
.bottom-panel { position: absolute; z-index: 3; left: 40rpx; right: 40rpx; bottom: 20rpx; }
.agreement { display: flex; align-items: center; justify-content: center; margin-bottom: 24rpx; }
.check { width: 30rpx; height: 30rpx; border: 2rpx solid #B7B6AD; border-radius: 8rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; color: white; }
.check--on { background: #002900; border-color: #002900; }
.agreement-text, .privacy-link { font-size: 22rpx; color: #85837C; }
.privacy-link { color: #54632C; }
.auth-button { display: flex; align-items: center; justify-content: center; height: 96rpx; padding: 0; margin: 0; border: none; border-radius: 999rpx; background: #002900; color: white; font-size: 30rpx; font-weight: 600; box-shadow: 0 14rpx 30rpx rgba(0,41,0,.18); }
.auth-button::after { border: none; }
.auth-note { display: block; margin-top: 18rpx; text-align: center; font-size: 20rpx; color: #9B9992; }
