<view class="page">
  <nav-bar title="领取蛋宝宝" bindback="onGoHome"></nav-bar>

  <!-- BOOTSTRAPPING / LOADING_PREVIEW / SUBMITTING -->
  <view wx:if="{{state === 'BOOTSTRAPPING' || state === 'LOADING_PREVIEW' || state === 'SUBMITTING'}}" class="loading">
    <view class="loading-spinner"></view>
    <text class="loading-text">{{state === 'SUBMITTING' ? '正在领取…' : '加载中…'}}</text>
  </view>

  <!-- NEED_PHONE：预览信息 + 授权按钮（preview 已先跑，用户先看货再授权） -->
  <view wx:elif="{{state === 'NEED_PHONE'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">🥚</text></view>
    <text wx:if="{{productName}}" class="panel-title">{{productName}}</text>
    <text wx:if="{{petType}}" class="panel-prototype">原型：{{petType}}</text>
    <text wx:if="{{statusLabel}}" class="panel-status">{{statusLabel}}</text>
    <text class="panel-desc">领取前需要授权手机号，用于保障您的蛋宝宝账号安全。</text>
    <button class="primary-button" open-type="getPhoneNumber" loading="{{authorizingPhone}}" disabled="{{authorizingPhone}}" bindgetphonenumber="onAuthorizePhone">授权手机号并领取</button>
  </view>

  <!-- READY - claimable -->
  <view wx:elif="{{state === 'READY'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">🥚</text></view>
    <text class="panel-title">{{productName}}</text>
    <text class="panel-prototype">原型：{{petType}}</text>
    <text class="panel-status">{{statusLabel}}</text>
    <button class="primary-button confirm-button" bindtap="onConfirmClaim">立即领取</button>
  </view>

  <!-- SUCCESS -->
  <view wx:elif="{{state === 'SUCCESS'}}" class="center-panel">
    <view class="icon-circle icon-circle--success"><text class="icon-emoji">🎉</text></view>
    <text class="panel-title">领取成功！</text>
    <text wx:if="{{pet}}" class="panel-desc">{{pet.petType}}已来到您的蛋宝宝家园。</text>
    <!-- 渠道互斥：领取替换了邀请码宠物时，轻提示数据去向，防「数据丢失」误解（ADR 0007） -->
    <text wx:if="{{replacedInvitePet}}" class="panel-desc panel-note">您的虚拟宠物已随本次NFC领取进行替换。</text>
    <button class="primary-button" bindtap="onGoHome">去看看它</button>
  </view>

  <!-- CLAIMED_BY_OTHER -->
  <view wx:elif="{{state === 'CLAIMED_BY_OTHER'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">😢</text></view>
    <text class="panel-title">这只蛋宝宝已被其他小伙伴领取</text>
    <text class="panel-desc">每件蛋宝宝实物只能领取一次。</text>
    <button class="secondary-button" bindtap="onGoHome">回到首页</button>
  </view>

  <!-- ALREADY_OWNED：重复原型拦截，用户已领取过该原型角色的宠物；此卡不消耗，仍可给他人领取 -->
  <view wx:elif="{{state === 'ALREADY_OWNED'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">🥚</text></view>
    <text class="panel-title">您已经领取过该角色的宠物</text>
    <text class="panel-desc">这张卡片没有消耗，还可以给其他小伙伴使用。</text>
    <!-- preview 回传已有宠物时可「去看看它」直达；10206 竞态兜底无宠物信息，只给回首页 -->
    <button wx:if="{{ownedPet}}" class="primary-button" bindtap="onGoOwnedPet">去看看它</button>
    <button class="secondary-button" bindtap="onGoHome">回到首页</button>
  </view>

  <!-- NOT_ACTIVATED：卡已入库未激活（量产收货与放行之间） -->
  <view wx:elif="{{state === 'NOT_ACTIVATED'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">🥚</text></view>
    <text class="panel-title">卡片尚未激活</text>
    <text class="panel-desc">这只蛋宝宝还在路上，敬请期待。</text>
    <button class="secondary-button" bindtap="onGoHome">回到首页</button>
  </view>

  <!-- UNAVAILABLE -->
  <view wx:elif="{{state === 'UNAVAILABLE'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">⚠️</text></view>
    <text class="panel-title">暂时无法领取</text>
    <text class="panel-desc">{{errorMessage || '请稍后再试。'}}</text>
    <button class="secondary-button" bindtap="onGoHome">回到首页</button>
  </view>

  <!-- NETWORK_ERROR：preview 失败不阻塞授权入口 -->
  <view wx:elif="{{state === 'NETWORK_ERROR'}}" class="center-panel">
    <view class="icon-circle"><text class="icon-emoji">📡</text></view>
    <text class="panel-title">连接失败</text>
    <text class="panel-desc">{{errorMessage || '暂时无法连接服务，请稍后重试'}}</text>
    <button class="primary-button" bindtap="onRetry">重试</button>
    <button wx:if="{{!hasPhoneBound}}" class="secondary-button" open-type="getPhoneNumber" loading="{{authorizingPhone}}" disabled="{{authorizingPhone}}" bindgetphonenumber="onAuthorizePhone">先授权手机号</button>
    <button class="secondary-button" bindtap="onGoHome">回到首页</button>
  </view>
</view>
