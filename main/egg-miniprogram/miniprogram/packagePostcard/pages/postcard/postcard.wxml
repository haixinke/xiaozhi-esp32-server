<!-- 明信片：好友免授权查看，加载/缺页/就绪三态 -->
<view class="page">
  <nav-bar title="明信片" show-back="{{false}}" />

  <view class="content">
  <!-- 加载态 -->
  <view wx:if="{{phase === 'loading'}}" class="state-wrap">
    <view class="loading-dot"></view>
    <text class="state-text">正在拆开明信片…</text>
  </view>

  <!-- 缺页态 -->
  <view wx:elif="{{phase === 'missing'}}" class="state-wrap">
    <text class="state-emoji">🥚</text>
    <text class="state-text">明信片不见了</text>
    <text class="state-sub">可能已被删除或链接有误</text>
    <button class="primary-btn" bindtap="onRetry">再试一次</button>
    <button class="ghost-btn" bindtap="onEnter">认识一下蛋宝宝</button>
  </view>

  <!-- 就绪态：海报式大图（文案悬浮其上，eggbabe 角标 + 邮戳） -->
  <block wx:else>
    <view class="hero">
      <image class="hero-img" src="{{postcard.imageUrl}}" mode="aspectFill" />
      <!-- 品牌角标：三颗蛋色点 + eggbabe 字标 -->
      <view class="logo">
        <view class="logo-mark">
          <view class="dot dot-green"></view>
          <view class="dot dot-yellow"></view>
          <view class="dot dot-pink"></view>
        </view>
        <text class="logo-word">eggbabe</text>
      </view>
      <!-- 邮戳：谁寄的 -->
      <view class="postmark">
        <view class="postmark-stamp">
          <text class="postmark-text">{{postcard.petName || '蛋宝宝'}} 寄</text>
        </view>
      </view>
      <!-- 悬浮文案：底部渐变蒙层上的涂鸦体 -->
      <view class="caption-wrap">
        <text class="caption-text">{{postcard.caption}}</text>
      </view>
    </view>
    <view class="footer-actions">
      <button class="primary-btn" bindtap="onEnter">我也要孵蛋宝宝</button>
    </view>
  </block>
  </view>
</view>
