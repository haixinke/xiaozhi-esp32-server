/* 复用静态一起画的纸张色、布局比例与工具层次，导航及安全区适配正式工程。 */
page { height: 100%; background: #F8F7EF; }
.page { height: 100vh; display: flex; flex-direction: column; overflow: hidden; font-family: "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif; color: #35483C; }
nav-bar { flex: 0 0 auto; z-index: 50; }
.stage { flex: 1; min-height: 0; position: relative; overflow: hidden; background: #F8F7EF; }
button::after { border: 0; }
.paper { position: absolute; left: 50%; top: calc(50% - 140rpx); width: 88vw; height: 120vw; max-height: 936rpx; transform: translate(-50%, -50%); border-radius: 56rpx; border: 1rpx solid rgba(53,72,60,.08); background: #F7EEE5; box-shadow: 0 8rpx 32rpx rgba(54,71,61,.06); }
.paper--hidden { visibility: hidden; }
.paper-dash { position: absolute; inset: 30rpx; border: 3rpx dashed rgba(53,72,60,.2); border-radius: 40rpx; pointer-events: none; z-index: 3; }
.canvas-slot { position: absolute; inset: 30rpx; transform-origin: center; }
.drawing-canvas { width: 100%; height: 100%; }
.drawing-canvas--hidden { visibility: hidden; }
.reference-preload { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
.look-row { position: absolute; top: 20rpx; left: 24rpx; right: 24rpx; display: flex; justify-content: center; z-index: 20; }
.look-pill { margin: 0; padding: 14rpx 28rpx; border-radius: 999rpx; border: 1rpx solid rgba(53,72,60,.12); background: rgba(255,255,255,.92); color: #35483C; font-size: 26rpx; font-weight: 500; line-height: 1.2; box-shadow: 0 4rpx 16rpx rgba(54,71,61,.08); }
.look-pill[disabled] { opacity: .5; background: rgba(255,255,255,.92); color: #35483C; }
.peek { position: absolute; top: calc(50% - 140rpx); left: 0; right: 0; transform: translateY(-50%); display: flex; flex-direction: column; align-items: center; z-index: 25; animation: peek-in 280ms ease-out both; }
.reference-image { width: 52vw; height: 52vw; max-width: 420rpx; max-height: 420rpx; }
.peek-caption { margin-top: 24rpx; color: rgba(53,72,60,.6); font-size: 26rpx; line-height: 1.3; }
.notice { position: absolute; z-index: 40; top: 102rpx; left: 48rpx; right: 48rpx; padding: 18rpx 24rpx; border-radius: 28rpx; background: rgba(18,21,18,.76); color: #fff; font-size: 26rpx; text-align: center; }
.status { position: absolute; z-index: 45; top: 24%; left: 48rpx; right: 48rpx; display: flex; flex-direction: column; align-items: center; gap: 32rpx; text-align: center; font-size: 28rpx; line-height: 1.7; }
.primary { border: 0; border-radius: 999rpx; background: #002900; color: #fff; font-size: 30rpx; font-weight: 600; height: 96rpx; line-height: 96rpx; padding: 0; box-shadow: 0 8rpx 24rpx rgba(0,41,0,.12); }
.primary[disabled] { opacity: .5; background: #002900; color: #fff; }
.primary:active { opacity: .85; }
.retry { width: 440rpx; max-width: 100%; margin: 0; }
.editor-chrome--dimmed { opacity: .35; pointer-events: none; }
/* 与静态工程 prop 布局一致：底部 = 完成按钮底距 210 + 按钮高 96 - 悬浮栏高 224 = 82rpx，栏顶与完成按钮顶对齐 */
.action-rail { position: absolute; bottom: calc(82rpx + env(safe-area-inset-bottom)); right: 20rpx; z-index: 30; width: 112rpx; border: 1rpx solid #E5E3DF; border-radius: 56rpx; overflow: hidden; background: rgba(255,255,255,.94); box-shadow: 0 8rpx 22rpx rgba(45,55,40,.1); }
.action { width: 112rpx; height: 112rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 22rpx; }
.action + .action { border-top: 1rpx solid #E5E3DF; }
.action image { width: 52rpx; height: 52rpx; }
.action--disabled { opacity: .35; pointer-events: none; }
.finish { position: absolute; z-index: 30; bottom: calc(210rpx + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: 560rpx; max-width: calc(100% - 96rpx); margin: 0; }
.tool-section { position: absolute; z-index: 32; bottom: calc(40rpx + env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%); width: 560rpx; max-width: calc(100% - 96rpx); }
.toolbar { display: flex; justify-content: center; align-items: center; gap: 0; width: 368rpx; height: 112rpx; box-sizing: border-box; overflow: hidden; border: 1rpx solid rgba(225,226,211,.9); border-radius: 56rpx; background: #fff; padding: 0 15rpx; margin: 0 auto; box-shadow: 0 8rpx 24rpx rgba(43,55,39,.1), inset 0 1rpx 0 rgba(255,255,255,.72); }
.tool-button { position: relative; width: 112rpx; height: 112rpx; min-height: 112rpx; flex: 0 0 112rpx; display: flex; align-items: center; justify-content: center; }
.tool-button + .tool-button::before { content: ''; position: absolute; left: 0; top: 22rpx; bottom: 22rpx; width: 1rpx; background: rgba(64,82,57,.12); }
.tool-button--selected { background: #FFF0DD; color: #6A3F2D; }
.tool-button--selected:first-child { box-shadow: -15rpx 0 0 #FFF0DD; }
.tool-button--selected:last-child { box-shadow: 15rpx 0 0 #FFF0DD; }
.tool-button image { width: 62rpx; height: 62rpx; }
.current-color { display: none; }
.tool-options { position: relative; background: rgba(255,255,255,.98); border: 1rpx solid #E5E3DF; border-radius: 32rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 8rpx 22rpx rgba(45,55,40,.08); }
.size-options { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; }
.setting-group { flex: 1; min-width: 0; }
.setting-title { font-size: 22rpx; color: #687548; }
.size-row { display: flex; justify-content: space-between; gap: 2rpx; margin-top: 8rpx; }
.size-option { width: 72rpx; min-height: 88rpx; display: flex; flex-direction: column; align-items: center; justify-content: space-around; border-radius: 20rpx; font-size: 18rpx; }
.size-option--selected { background: #F0F3E6; }
.size-dot { border-radius: 50%; }
.color-setting { display: flex; flex-direction: column; align-items: center; }
.color-trigger { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.color-trigger view { width: 44rpx; height: 44rpx; border-radius: 50%; border: 6rpx solid #F3F7E7; }
.color-picker { position: absolute; bottom: 150rpx; right: 0; display: grid; grid-template-columns: repeat(5, 64rpx); gap: 16rpx; padding: 24rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(38,54,43,.16); }
.color-option { width: 64rpx; height: 64rpx; border-radius: 50%; box-sizing: border-box; border: 6rpx solid transparent; }
.color-option--selected { border-color: #35483C; }
.sticker-row { display: flex; justify-content: space-around; }
.sticker-option { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 112rpx; min-height: 112rpx; border-radius: 24rpx; font-size: 22rpx; }
.sticker-option--selected { background: #F0F3E6; }
.sticker-symbol { font-size: 52rpx; line-height: 1.4; }
.result { position: absolute; z-index: 48; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #F8F7EF; padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.result-award { position: relative; width: 150rpx; height: 150rpx; margin-bottom: 32rpx; flex-shrink: 0; }
.result-award text { position: absolute; top: 50%; left: 100%; margin-left: 26rpx; transform: translateY(-50%); color: #D7A92D; font-size: 44rpx; font-weight: 600; white-space: nowrap; }
.result-reveal { display: flex; flex-direction: column; align-items: center; }
.result--animated .result-reveal { animation: result-reveal 780ms cubic-bezier(.22,1,.36,1) both; }
.result-name { margin-top: 28rpx; color: #002900; font-size: 40rpx; font-weight: 600; }
.result-caption { margin-top: 16rpx; color: #687548; font-size: 26rpx; }
.result-ok { width: 560rpx; max-width: 100%; margin: 56rpx 0 0; flex-shrink: 0; }
.page--reduced .peek, .page--reduced .result-reveal { animation: none; }
@keyframes peek-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes result-reveal { 0% { opacity: 0; transform: scale(.52) translateY(48rpx); } 45% { opacity: 1; transform: scale(1.1) translateY(-12rpx); } 68% { transform: scale(.96) translateY(6rpx); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
