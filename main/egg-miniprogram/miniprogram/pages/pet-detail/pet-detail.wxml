<view class="page">
  <nav-bar title="蛋宝宝档案"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view class="hero">
      <pet-avatar pet-type="{{card.prototype}}" size="{{210}}"></pet-avatar>
      <text class="name">{{card.name}} {{card.gender}}</text>
      <text class="meta">{{card.prototype}} · {{card.style}}</text>
    </view>
    <view class="daily-card">
      <view class="daily-head"><text>今日心情</text><text class="mood">{{dailyStatus.mood}}</text></view>
      <text class="daily-line">{{dailyStatus.line}}</text>
    </view>
    <view class="profile-card">
      <text class="section-title">身份档案</text>
      <view class="fields">
        <view><text>生日</text><text class="field-value">{{card.birthday}}</text></view>
        <view><text>星座</text><text class="field-value">{{card.zodiac}}</text></view>
        <view><text>MBTI</text><text class="field-value">{{card.mbti}}</text></view>
        <view><text>血型</text><text class="field-value">{{card.bloodType}} 型</text></view>
      </view>
      <text class="summary">{{card.personality}}</text>
    </view>
    <view class="record-card" bindtap="onCard"><view><text class="section-title">破壳收藏卡</text><text class="serial">{{card.serial}}</text></view><text class="arrow">›</text></view>
    <button class="primary" bindtap="onChat">和{{card.name}}说说话</button>
  </scroll-view>
</view>
