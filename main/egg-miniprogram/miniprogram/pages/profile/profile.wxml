<view class="page">
  <nav-bar title="个人信息"></nav-bar>

  <scroll-view scroll-y class="content">

    <view class="avatar-section">
      <!-- 微信原生头像选择能力：呼出系统「使用微信头像 / 从手机相册选择」面板 -->
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-image" src="{{avatarUrl}}" mode="aspectFill"></image>
        <egg-avatar wx:else size="{{72}}"></egg-avatar>
        <view class="avatar-edit-badge">
          <view class="camera-icon"><view class="camera-lens"></view></view>
        </view>
      </button>

      <view class="nickname-row" bindtap="onEditNickname">
        <text class="nickname-text">{{nickname}}</text>
        <view class="chevron"></view>
      </view>
      <text class="user-id">ID：{{userId}}</text>
    </view>

    <view class="field-panel">
      <list-row
        label="性别"
        value="{{gender}}"
        bind:rowtap="onEditGender"
      ></list-row>
      <picker mode="date" bindchange="onEditBirthday">
        <list-row label="生日" value="{{birthday}}"></list-row>
      </picker>
      <list-row label="星座" value="{{zodiac}}" show-chevron="{{false}}"></list-row>
      <picker mode="selector" range="{{cityList}}" bindchange="onCityChange">
        <list-row label="常驻城市" value="{{city}}"></list-row>
      </picker>
      <picker mode="selector" range="{{mbtiList}}" bindchange="onMbtiChange">
        <list-row label="MBTI" value="{{mbti}}" show-border="{{false}}"></list-row>
      </picker>
    </view>

  </scroll-view>
</view>
