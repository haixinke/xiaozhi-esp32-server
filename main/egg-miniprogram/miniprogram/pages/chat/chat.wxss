/* 聊天页样式对齐 eggbabe-miniprogram 静态 UI 项目 */
.page {
  display: flex; flex-direction: column; height: 100vh; overflow: hidden;
  background: linear-gradient(180deg, #FAFAF8 0%, #F4F6EE 100%); color: #1A1A1A;
}

.chat-header { flex: none; min-height: 0; background: rgba(255, 255, 255, 0.9); }

/* AI 内容标识：对齐静态项目 ai-content-timeline-label，位于消息列表顶部 */
.ai-content-label {
  padding: 12rpx 0 4rpx;
  color: rgba(92, 92, 92, 0.48); font-size: 18rpx; line-height: 1.45; text-align: center;
}

/* 紧跟在 AI 内容标识后的第二行（防诈骗提示）：收紧上间距，视觉成组 */
.ai-content-label--tight {
  padding-top: 0;
}

/* 心情状态条 */
.mood-bar {
  flex: none;
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 32rpx; border-bottom: 1rpx solid rgba(70, 72, 60, 0.08);
}
.mood-line { flex: 1; font-size: 24rpx; color: #5C5C5C; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 连接状态 */
.conn-state { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx; }
.conn-state--disconnected { color: #8C8C88; background: #EFEFED; }
.conn-state--connecting { color: #856B00; background: #FFF6CC; }
.conn-state--connected { color: #54632C; background: #E8F2D4; }

/* 消息区 */
.messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 10rpx 28rpx 0;
  box-sizing: border-box;
}
.tip { text-align: center; font-size: 20rpx; color: #8C8C88; margin-bottom: 24rpx; }
.time-sep { display: flex; align-items: center; justify-content: center; padding: 6rpx 0 18rpx; }
.time-sep-text { font-size: 20rpx; color: #8C8C88; letter-spacing: 1rpx; }
.history-loader { display: flex; align-items: center; justify-content: center; gap: 12rpx; margin-bottom: 24rpx; }
.history-loader-dot { width: 16rpx; height: 16rpx; border-radius: 50%; background: #ACC861; animation: historyLoaderDot 1s ease-in-out infinite; }
.history-loader-text { font-size: 20rpx; color: #8C8C88; }
@keyframes historyLoaderDot { 0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; } 40% { transform: scale(1); opacity: 1; } }

.row { display: flex; margin-bottom: 22rpx; }
.row--user { justify-content: flex-end; }
.row--egg { justify-content: flex-start; }

.bubble {
  max-width: 76%; padding: 22rpx 26rpx; border-radius: 28rpx;
  font-size: 26rpx; line-height: 1.65; word-break: break-word;
  box-sizing: border-box;
}
.bubble--egg {
  border: 1rpx solid #E2E6D9; border-bottom-left-radius: 9rpx;
  background: #FFFFFF; color: #26362B;
  box-shadow: 0 7rpx 18rpx rgba(42, 53, 41, 0.06);
  position: relative; min-width: 100rpx;
}
.bubble--user {
  border-bottom-right-radius: 9rpx;
  background: #002900; color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(0, 41, 0, 0.16);
}
.bubble--egg text { color: #26362B; font-size: 26rpx; }

/* 正在输入 / 正在说话 */
.typing { display: flex; align-items: center; gap: 8rpx; }
.bubble--typing { padding-right: 28rpx; }
.dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #819178; animation: typingDot 0.5s ease-in-out infinite; }
.dot:nth-child(2) { animation-delay: 0.08s; }
.dot:nth-child(3) { animation-delay: 0.16s; }
@keyframes typingDot { 0%, 100% { opacity: 0.35; transform: translateY(0); } 50% { opacity: 1; transform: translateY(-3rpx); } }

.speaking-indicator { display: flex; align-items: flex-end; gap: 6rpx; margin-top: 12rpx; height: 24rpx; }
.speaking-bar { width: 6rpx; height: 8rpx; background: #819178; border-radius: 999rpx; animation: speakingBar 0.8s ease-in-out infinite; }
.speaking-bar:nth-child(2) { animation-delay: 0.15s; }
.speaking-bar:nth-child(3) { animation-delay: 0.3s; }
@keyframes speakingBar { 0%, 100% { height: 8rpx; opacity: 0.5; } 50% { height: 22rpx; opacity: 1; } }

.thread-spacer { height: 24rpx; }

/* 输入栏：底部安全区适配小屏横条 */
.composer {
  flex: none;
  padding: 16rpx 20rpx calc(4rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(70, 72, 60, 0.10); background: #FCFCF9;
}
.composer-row { display: flex; align-items: flex-end; gap: 14rpx; }
/* 输入框外壳承载边框/圆角/内边距：iOS 真机会把 textarea 自身 padding 叠加进 auto-height 计算，故 textarea 必须 padding:0 */
.composer-field {
  flex: 1; min-height: 96rpx; max-height: 190rpx; padding: 28rpx 24rpx;
  box-sizing: border-box; border: 1rpx solid #D8D5CE; border-radius: 28rpx;
  background: #FFFFFF; overflow: hidden;
}
/* 初始高度钉为单行 40rpx：placeholder 对齐 textarea 内容区顶部，不定高会偏上不居中 */
.composer-input {
  display: block; width: 100%; height: 40rpx; max-height: 134rpx; padding: 0; margin: 0;
  background: transparent; color: #1A1A1A; font-size: 25rpx; line-height: 40rpx;
}
.send-button {
  width: 96rpx; height: 96rpx; flex: none; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #002900; box-shadow: 0 7rpx 16rpx rgba(0, 41, 0, 0.18);
  transition: transform 0.18s ease-out, background-color 0.18s ease-out, opacity 0.18s ease-out;
}
.send-button__icon { width: 44rpx; height: 44rpx; display: block; }
.send-button--disabled { background: #E5E3DF; box-shadow: none; }
.send-button--disabled .send-button__icon { opacity: 0.42; }
.pressable--pressed { opacity: 0.9; transform: scale(0.98); background: #001F00; }

/* 减弱动画：系统设置开启时关闭所有循环动画与过渡 */
@media (prefers-reduced-motion: reduce) {
  .history-loader-dot, .dot, .speaking-bar { animation: none; }
}
.page--reduced .send-button { transition: none; }
.page--reduced .history-loader-dot, .page--reduced .dot, .page--reduced .speaking-bar { animation: none; }

/* 依赖提醒弹窗：样式参考蛋宝宝 UI 静态项目 pages/chat/chat.wxss 的 health-mask/health-dialog */
.health-mask{position:fixed;z-index:300;inset:0;display:flex;align-items:center;justify-content:center;padding:40rpx;background:rgba(13,22,16,.48);box-sizing:border-box}
.health-dialog{width:100%;max-width:620rpx;padding:42rpx 34rpx 30rpx;border-radius:34rpx;background:#FFF;box-sizing:border-box}
.health-message{display:block;color:#26362B;font-size:30rpx;font-weight:600;line-height:1.65;text-align:center}
.health-actions{display:flex;margin-top:36rpx}
.health-button{min-height:96rpx;display:flex;align-items:center;justify-content:center;flex:1;border-radius:999rpx;background:#002900;color:#FFF;font-size:26rpx;font-weight:600}
