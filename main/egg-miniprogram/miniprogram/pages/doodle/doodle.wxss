.page{display:flex;flex-direction:column;height:100vh;background:#FAFAF8}.content{flex:1;padding:34rpx 42rpx 60rpx;box-sizing:border-box}.preview{position:relative;height:470rpx;border-radius:38rpx;background:#FFF;display:flex;flex-direction:column;align-items:center;justify-content:center;overflow:hidden}.preview-aura{position:absolute;width:350rpx;height:350rpx;border-radius:50%;background:radial-gradient(circle,rgba(237,231,142,.35),transparent 68%)}.preview-egg{position:relative;width:188rpx;height:232rpx;border-radius:52% 48% 48% 52%/61% 59% 41% 39%;box-shadow:0 24rpx 45rpx rgba(0,41,0,.13);display:flex;align-items:center;justify-content:center}.pattern-mark{font-size:62rpx;color:rgba(0,41,0,.26)}.preview-name{margin-top:26rpx;font-size:24rpx;color:#77756E}.label{display:block;margin:40rpx 0 22rpx;font-size:27rpx;font-weight:600}.color-row{display:flex;justify-content:space-between}.color-item{width:140rpx;text-align:center;font-size:21rpx;color:#77756E}.swatch{width:76rpx;height:76rpx;margin:0 auto 12rpx;border-radius:50%;border:6rpx solid #FAFAF8;box-shadow:0 0 0 2rpx #E1DFD8}.swatch--selected{box-shadow:0 0 0 4rpx #54632C}.pattern-row{display:flex;flex-wrap:wrap;gap:16rpx}.pattern{padding:18rpx 28rpx;border-radius:999rpx;background:#FFF;border:2rpx solid #E1DFD8;font-size:24rpx}.pattern--selected{border-color:#9DB65B;background:#F5F8ED;color:#54632C}.primary{margin-top:48rpx;height:94rpx;padding:0;border:0;border-radius:999rpx;background:#002900;color:#FFF;font-size:29rpx;display:flex;align-items:center;justify-content:center;line-height:normal}.primary-label{display:block;line-height:1;transform:translateY(-2rpx)}.primary::after{border:none}
