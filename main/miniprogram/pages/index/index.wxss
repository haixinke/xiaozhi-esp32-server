/* pages/index/index.wxss */

page {
  background-color: #06070d;
  color: #e2e8f0;
}

.page {
  position: relative;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background:
    radial-gradient(ellipse 100% 50% at 50% 0%, rgba(56, 189, 248, 0.06), transparent 70%),
    radial-gradient(ellipse 80% 60% at 50% 100%, rgba(94, 234, 212, 0.05), transparent 70%),
    #06070d;
}

/* ---------------- 背景层 ---------------- */
.bg-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(148, 163, 184, 0.045) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(148, 163, 184, 0.045) 1rpx, transparent 1rpx);
  background-size: 80rpx 80rpx;
  mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 35%, transparent 80%);
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 30%, #000 35%, transparent 80%);
  pointer-events: none;
}

.bg-aurora {
  position: absolute;
  width: 700rpx;
  height: 700rpx;
  border-radius: 50%;
  filter: blur(120rpx);
  opacity: 0.35;
  pointer-events: none;
}
.bg-aurora-1 {
  top: -300rpx;
  left: -180rpx;
  background: radial-gradient(circle, #5eead4 0%, transparent 65%);
  animation: aurora-drift-1 18s ease-in-out infinite alternate;
}
.bg-aurora-2 {
  bottom: -280rpx;
  right: -200rpx;
  background: radial-gradient(circle, #2563eb 0%, transparent 65%);
  animation: aurora-drift-2 22s ease-in-out infinite alternate;
}
@keyframes aurora-drift-1 {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(80rpx, 60rpx) scale(1.1); }
}
@keyframes aurora-drift-2 {
  from { transform: translate(0, 0) scale(1); }
  to   { transform: translate(-100rpx, -80rpx) scale(1.15); }
}

/* ---------------- 顶部状态栏 ---------------- */
.top-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 36rpx 20rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.08);
  background: linear-gradient(180deg, rgba(10, 12, 20, 0.7), rgba(10, 12, 20, 0.0));
  backdrop-filter: blur(12rpx);
}

.status-cluster {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.status-ring {
  position: relative;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-ring::before {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 2rpx solid currentColor;
  opacity: 0.3;
}
.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 14rpx currentColor;
}

.status-ring.state-connected {
  color: #22c55e;
}
.status-ring.state-connected::after {
  content: '';
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 2rpx solid #22c55e;
  animation: ring-pulse 2s ease-out infinite;
}
.status-ring.state-connecting {
  color: #f59e0b;
}
.status-ring.state-connecting .status-dot {
  animation: dot-blink 1s ease-in-out infinite;
}
.status-ring.state-disconnected {
  color: #ef4444;
}

@keyframes ring-pulse {
  0%   { transform: scale(0.85); opacity: 0.7; }
  100% { transform: scale(1.6); opacity: 0; }
}
@keyframes dot-blink {
  0%, 100% { opacity: 1; }
  50%      { opacity: 0.3; }
}

.status-meta {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.status-label {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  color: #cbd5e1;
}
.status-session {
  font-size: 18rpx;
  color: rgba(148, 163, 184, 0.55);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.agent-cluster {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.agent-name {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  max-width: 240rpx;
}
.agent-prefix {
  font-size: 22rpx;
  color: rgba(94, 234, 212, 0.7);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
}
.agent-text {
  font-size: 28rpx;
  color: #f1f5f9;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 200rpx;
}
.switch-btn {
  padding: 10rpx 22rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #5eead4;
  border: 1rpx solid rgba(94, 234, 212, 0.4);
  border-radius: 100rpx;
  background: rgba(94, 234, 212, 0.06);
}
.switch-btn-hover {
  background: rgba(94, 234, 212, 0.18) !important;
  transform: scale(0.96);
}

/* ---------------- 启动占位 ---------------- */
.boot-shell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 36rpx;
  z-index: 2;
}
.boot-orbit {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(94, 234, 212, 0.18);
  animation: boot-spin 3s linear infinite;
}
.boot-dot {
  position: absolute;
  top: -8rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  margin-left: -8rpx;
  border-radius: 50%;
  background: #5eead4;
  box-shadow: 0 0 16rpx #5eead4;
}
.boot-text {
  font-size: 24rpx;
  color: rgba(148, 163, 184, 0.7);
  letter-spacing: 4rpx;
}
@keyframes boot-spin {
  from { transform: rotate(0deg); }
  to   { transform: rotate(360deg); }
}

/* ---------------- 会话区 ---------------- */
.conversation {
  position: relative;
  z-index: 2;
  flex: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 0 20rpx;
  overflow: hidden;
}
.conversation-inner {
  padding: 24rpx 24rpx 24rpx;
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
}

/* ---------------- 欢迎区 ---------------- */
.welcome {
  display: flex;
  flex-direction: column;
  padding: 40rpx 8rpx;
  gap: 28rpx;
}

.welcome-eyebrow {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: rgba(94, 234, 212, 0.65);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
}
.welcome-line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(94, 234, 212, 0.4), transparent);
}
.welcome-eyebrow .welcome-line:last-child {
  background: linear-gradient(270deg, rgba(94, 234, 212, 0.4), transparent);
}

.welcome-title {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 12rpx;
}
.welcome-hi {
  font-size: 56rpx;
  font-weight: 300;
  color: #cbd5e1;
  letter-spacing: 1rpx;
}
.welcome-name {
  font-size: 76rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #5eead4 0%, #38bdf8 60%, #818cf8 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: 2rpx;
}
.welcome-dot {
  font-size: 76rpx;
  font-weight: 700;
  color: #f59e0b;
}

.welcome-sub {
  font-size: 26rpx;
  line-height: 1.7;
  color: rgba(203, 213, 225, 0.7);
  max-width: 580rpx;
}

.welcome-grid {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.welcome-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 18rpx;
  background:
    linear-gradient(135deg, rgba(30, 41, 59, 0.6) 0%, rgba(15, 23, 42, 0.4) 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
  overflow: hidden;
}
.welcome-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: linear-gradient(180deg, #5eead4, #2563eb);
  opacity: 0.7;
}
.welcome-card-tag {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: rgba(94, 234, 212, 0.75);
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  width: 48rpx;
}
.welcome-card-text {
  font-size: 28rpx;
  color: #e2e8f0;
}

/* ---------------- 底部输入栏 ---------------- */
.input-bar {
  position: relative;
  z-index: 3;
  background: rgba(15, 23, 42, 0.95);
  border-top: 1rpx solid rgba(148, 163, 184, 0.1);
  padding: 12rpx 24rpx 12rpx;
  backdrop-filter: blur(20rpx);
}

.input-bar-inner {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
}

/* 输入框容器 */
.input-wrapper {
  flex: 1;
  min-height: 76rpx;
  max-height: 200rpx;
  padding: 16rpx 20rpx;
  background: rgba(30, 41, 59, 0.8);
  border-radius: 8rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.15);
  transition: border-color 0.2s;
}

.message-input {
  width: 100%;
  font-size: 32rpx;
  color: #e2e8f0;
  line-height: 1.5;
  background: transparent;
}

.message-input::placeholder {
  color: rgba(148, 163, 184, 0.5);
}

.message-input[disabled] {
  color: rgba(148, 163, 184, 0.3);
}

/* 操作按钮区 */
.action-buttons {
  display: flex;
  align-items: center;
  padding-bottom: 8rpx;
}

.action-btn {
  min-width: 112rpx;
  height: 76rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-size: 28rpx;
  transition: all 0.2s;
  user-select: none;
  color: #cbd5e1;
}

/* 发送按钮 */
.send-btn-active {
  background: linear-gradient(135deg, #5eead4 0%, #38bdf8 100%);
  border: none;
  color: #06070d;
}

.send-btn-active .action-btn-text {
  color: #06070d;
  font-weight: 500;
}

/* 语音按钮（小版） */
.voice-btn-mini {
  background: rgba(30, 41, 59, 0.8);
  border: 1rpx solid rgba(148, 163, 184, 0.15);
  min-width: 96rpx;
  transition: all 0.2s;
}

.voice-btn-mini.idle {
  background: rgba(30, 41, 59, 0.8);
}

.voice-btn-mini.listening {
  background: rgba(245, 158, 11, 0.15);
  border-color: rgba(245, 158, 11, 0.5);
  transform: scale(0.95);
}

.voice-btn-mini.listening.cancelled {
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.5);
}

.voice-btn-mini.thinking {
  background: rgba(94, 234, 212, 0.15);
  border-color: rgba(94, 234, 212, 0.5);
}

.voice-btn-mini.speaking {
  background: rgba(56, 189, 248, 0.15);
  border-color: rgba(56, 189, 248, 0.5);
}

.voice-btn-mini.disabled {
  background: rgba(30, 41, 59, 0.3);
  border-color: rgba(148, 163, 184, 0.08);
  opacity: 0.5;
}

.voice-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  width: 48rpx;
  height: 48rpx;
}

.voice-icon-line {
  width: 6rpx;
  height: 24rpx;
  background: rgba(94, 234, 212, 0.8);
  border-radius: 3rpx;
}

.voice-btn-mini.listening .voice-icon-line {
  background: rgba(245, 158, 11, 0.9);
  animation: voice-wave 0.8s ease-in-out infinite;
}

.voice-btn-mini.listening .voice-icon-line:nth-child(1) {
  animation-delay: 0s;
}

.voice-btn-mini.listening .voice-icon-line:nth-child(2) {
  animation-delay: 0.15s;
}

.voice-btn-mini.listening .voice-icon-line:nth-child(3) {
  animation-delay: 0.3s;
}

.voice-btn-mini.thinking .voice-icon-line {
  background: rgba(94, 234, 212, 0.8);
}

.voice-btn-mini.speaking .voice-icon-line {
  background: rgba(56, 189, 248, 0.9);
  animation: voice-wave 0.6s ease-in-out infinite;
}

.voice-btn-mini.speaking .voice-icon-line:nth-child(1) {
  animation-delay: 0s;
}

.voice-btn-mini.speaking .voice-icon-line:nth-child(2) {
  animation-delay: 0.2s;
}

.voice-btn-mini.speaking .voice-icon-line:nth-child(3) {
  animation-delay: 0.1s;
}

@keyframes voice-wave {
  0%, 100% {
    height: 16rpx;
  }
  50% {
    height: 36rpx;
  }
}

/* 打断按钮 */
.abort-btn {
  background: rgba(239, 68, 68, 0.8);
  border: 1rpx solid rgba(239, 68, 68, 0.5);
  color: #ffffff;
}

.abort-btn .action-btn-text {
  color: #ffffff;
  font-weight: 500;
}

/* 按钮悬停效果 */
.action-btn-hover {
  transform: scale(0.95);
  opacity: 0.8;
}

/* 安全区适配 */
.safe-area-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
