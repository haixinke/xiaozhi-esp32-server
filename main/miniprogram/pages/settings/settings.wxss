/* pages/settings/settings.wxss */
/* Ethereal Companion Design System - 完美女友主题 */

/* ===== Base ===== */
.settings-container {
  min-height: 100vh;
  background: #f6f3f2;
  padding: 40rpx 32rpx 60rpx;
}

/* ===== Header ===== */
.settings-header {
  padding: 20rpx 8rpx 48rpx;
}

.settings-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1b1c1c;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

/* ===== Settings List (Glassmorphic Card) ===== */
.settings-list {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(134, 78, 90, 0.08),
    0 0 20rpx rgba(255, 183, 193, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* ===== Settings Item ===== */
.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.06);
  transition: background 0.2s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: rgba(134, 78, 90, 0.04);
}

/* ===== Item Left ===== */
.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.item-label {
  font-size: 32rpx;
  color: #1b1c1c;
  font-weight: 500;
  line-height: 1.4;
}

/* ===== Item Right ===== */
.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: flex-end;
}

.item-value {
  font-size: 28rpx;
  color: #514345;
  text-align: right;
}

/* ===== Switch Component ===== */
switch {
  transform: scale(0.9);
}

/* ===== Footer ===== */
.settings-footer {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.5);
  letter-spacing: 0.5rpx;
}
