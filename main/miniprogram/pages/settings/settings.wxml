<view class="settings-container {{darkMode ? 'dark' : ''}}">

  <!-- 我们的羁绊面板 -->
  <view class="bond-card">
    <!-- 头像区域：用户 + 红线 + 伴侣 -->
    <view class="bond-avatars">
      <view class="bond-avatar-wrap bond-user">
        <button class="bond-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="bond-avatar" src="{{userAvatar}}" mode="aspectFill" />
        </button>
        <text class="bond-avatar-label">你</text>
      </view>
      <view class="bond-thread">
        <view class="bond-thread-line"></view>
      </view>
      <view class="bond-avatar-wrap bond-companion">
        <image class="bond-avatar" src="{{companionAvatar}}" mode="aspectFill" />
        <text class="bond-avatar-label">她</text>
      </view>
    </view>

    <!-- 身份标签 -->
    <view class="bond-identity">
      <text class="bond-identity-name {{planCode === 'gold' ? 'bond-gold' : planCode === 'silver' ? 'bond-silver' : 'bond-free'}}">{{identityName}}</text>
    </view>

  </view>

  <!-- 功能入口 -->
  <view class="entry-row">
    <view class="entry-card" bindtap="onContractTap">
      <!-- <view class="entry-icon-area entry-icon-contract"></view> -->
      <text class="entry-title">我的契约</text>
      <text class="entry-desc">管理订阅</text>
    </view>
    <view class="entry-card" bindtap="onBackpackTap">
      <!-- <view class="entry-icon-area entry-icon-backpack"></view> -->
      <text class="entry-title">我的背包</text>
      <text class="entry-desc">查看道具</text>
    </view>
  </view>

  <!-- 设置项列表 -->
  <view class="settings-list">
    <!-- 主题设置 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">深色模式</text>
      </view>
      <switch checked="{{darkMode}}" bindchange="onThemeChange" color="#864e5a" />
    </view>

    <!-- 关于 -->
    <view class="settings-item" bindtap="onAbout">
      <view class="item-left">
        <text class="item-label">关于</text>
      </view>
      <view class="item-right">
        <text class="item-value">完美女友</text>
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">版本</text>
      </view>
      <view class="item-right">
        <text class="item-value">1.0.0</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="settings-footer">
    <text class="footer-text">完美女友 © 2026</text>
  </view>

  <!-- 契约浮窗 -->
  <view class="contract-overlay {{showContractPopup ? 'contract-overlay-show' : ''}}" bindtap="onContractOverlayTap">
    <view class="contract-panel" catchtap="onContractPanelTap">
      <view class="contract-header">
        <text class="contract-romantic-text">你愿意签一个契约，让我们离的更近一点吗？</text>
      </view>

      <view class="contract-cards">
        <view class="contract-card {{selectedPlanId === item.id ? 'contract-card-selected' : ''}}"
              wx:for="{{plans}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onPlanSelect">
          <text class="contract-card-name">{{item.planName}}</text>
          <view class="contract-card-price">
            <text class="contract-card-promo">¥{{item.promoYuan}}</text>
            <text class="contract-card-original">¥{{item.priceYuan}}</text>
          </view>
          <view class="contract-card-features">
            <text class="contract-feature" wx:for="{{item.features}}" wx:for-item="feat" wx:key="code">{{feat.label}}</text>
          </view>
        </view>
      </view>

      <view class="contract-action">
        <view class="contract-btn {{selectedPlanId ? 'contract-btn-active' : 'contract-btn-disabled'}}" bindtap="onSignContract">
          签订契约
        </view>
      </view>
    </view>
  </view>
</view>
