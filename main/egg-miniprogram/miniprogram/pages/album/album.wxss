.page{height:100vh;background:#FAFAF8}.content{padding:40rpx}.album-card{display:flex;align-items:center;padding:28rpx;border-radius:30rpx;background:linear-gradient(145deg,#FFFDF2,#F9D8D1);box-shadow:0 16rpx 36rpx rgba(0,41,0,.1)}.baby-mark{width:120rpx;height:150rpx;border-radius:52% 48% 48% 52%/61% 59% 41% 39%;background:#002900;color:#EDE78E;display:flex;align-items:center;justify-content:center;font-size:44rpx}.copy{flex:1;margin-left:26rpx}.name{display:block;font-size:32rpx;font-weight:600}.meta{display:block;margin-top:10rpx;font-size:23rpx;color:#77756E}.serial{display:block;margin-top:18rpx;font-size:18rpx;color:#929087}.arrow{font-size:42rpx;color:#8A8D6F}.empty{display:flex;flex-direction:column;align-items:center;padding-top:190rpx;text-align:center}.empty-card{width:210rpx;height:290rpx;border-radius:28rpx;border:3rpx dashed #CFCBC4;background:#FFF}.empty-title{margin-top:42rpx;font-size:34rpx;font-weight:600}.empty-desc{margin-top:16rpx;width:470rpx;font-size:24rpx;line-height:1.65;color:#8C8C88}
