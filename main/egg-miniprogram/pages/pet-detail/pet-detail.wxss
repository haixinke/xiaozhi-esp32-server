.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 24rpx 40rpx 48rpx; box-sizing: border-box; }

/* 顶部 */
.hero { display: flex; flex-direction: column; align-items: center; padding: 24rpx 0 32rpx; }
.hero-name { font-size: 38rpx; font-weight: 600; color: #1A1A1A; margin-top: 20rpx; }
.hero-proto { font-size: 24rpx; color: #8C8C88; margin-top: 8rpx; }

/* 灵魂底色卡 */
.seal-card {
  background: #FFFFFF; border: 3rpx dashed #002900; border-radius: 40rpx;
  padding: 40rpx; box-sizing: border-box; margin-bottom: 32rpx;
}
.seal-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24rpx; }
.seal-title { font-size: 30rpx; font-weight: 600; color: #1A1A1A; }
.seal-serial { font-family: 'Google Sans', Arial, sans-serif; font-size: 20rpx; letter-spacing: 1rpx; color: #8C8C88; }
.trait { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.trait-name { width: 120rpx; font-size: 24rpx; color: #5C5C5C; flex-shrink: 0; }
.trait-track { flex: 1; height: 12rpx; border-radius: 999rpx; background: #F2F1EE; overflow: hidden; }
.trait-fill { height: 100%; background: #9DB65B; border-radius: 999rpx; }
.seal-summary { display: block; font-size: 26rpx; color: #5C5C5C; line-height: 1.65; margin-top: 20rpx; }

/* 分组标题 */
.section-title { font-size: 28rpx; font-weight: 600; color: #1A1A1A; margin: 8rpx 0 20rpx; }

/* 成就横滑 */
.ach-scroll { white-space: nowrap; margin-bottom: 32rpx; }
.ach-card {
  display: inline-flex; flex-direction: column; align-items: center;
  width: 180rpx; padding: 28rpx 16rpx; margin-right: 20rpx;
  background: #FFFFFF; border: 1rpx solid #E5E3DF; border-radius: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,41,0,0.06);
}
.ach-medal { width: 72rpx; height: 72rpx; border-radius: 50%; background: linear-gradient(160deg, #EDE78E, #F4B9AE); margin-bottom: 16rpx; }
.ach-name { font-size: 24rpx; font-weight: 600; color: #1A1A1A; }
.ach-date { font-size: 20rpx; color: #8C8C88; margin-top: 6rpx; }

/* 技能 */
.skills { display: flex; flex-wrap: wrap; gap: 16rpx; }
.skill-chip {
  height: 64rpx; padding: 0 28rpx; border-radius: 999rpx;
  background: #F5F8ED; color: #54632C; font-size: 26rpx;
  display: flex; align-items: center;
}
