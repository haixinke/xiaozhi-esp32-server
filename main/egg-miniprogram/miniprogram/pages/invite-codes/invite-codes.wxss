.page{display:flex;flex-direction:column;height:100vh;background:#FAFAF8}.content{flex:1;padding:38rpx 40rpx 60rpx;box-sizing:border-box}.intro{padding:34rpx;border-radius:32rpx;background:#002900;color:#FFF}.title{display:block;font-size:36rpx;font-weight:600}.desc{display:block;margin-top:16rpx;font-size:24rpx;line-height:1.7;color:#CFD9C0}.code-list{margin-top:28rpx;border-radius:30rpx;background:#FFF;overflow:hidden;border:1rpx solid #E5E3DF}.code-row{height:126rpx;padding:0 28rpx;display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid #EEECE6}.code-row:last-child{border-bottom:none}.code{display:block;font-size:27rpx;font-weight:600;letter-spacing:1rpx}.status{display:block;margin-top:8rpx;font-size:21rpx;color:#8C8C88}.code-row--used{opacity:.45}.copy{width:120rpx;height:62rpx;line-height:62rpx;margin:0;border-radius:999rpx;background:#F5F8ED;color:#54632C;font-size:23rpx}.copy::after{border:none}.empty{margin-top:28rpx;padding:70rpx 30rpx;border-radius:28rpx;background:#FFF;text-align:center;color:#8C8C88;font-size:25rpx}.note{margin-top:26rpx;padding:26rpx;border-radius:24rpx;background:#FAFAEF;color:#6E6B35;font-size:22rpx;line-height:1.7}
