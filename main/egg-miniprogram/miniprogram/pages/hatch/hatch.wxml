<view class="page">
  <!-- 破壳仪式：情感时刻，全程 520ms cubic-bezier(0.34,1.56,0.64,1)，尊重 prefers-reduced-motion -->

  <!-- 阶段一：确认（物理装置已在预设破壳日打开） -->
  <view wx:if="{{phase === 'confirm'}}" class="stage">
    <view class="egg-pulse" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    <text class="sub">物理装置已在预设时间打开</text>
    <text class="headline">它终于见到你了。</text>
    <btn text="{{submitting ? '正在揭晓…' : '揭晓破壳收藏卡'}}" disabled="{{submitting}}" bind:tap="onReveal"></btn>
  </view>

  <!-- 阶段二：破壳 + 粒子迸发 + 收藏卡生成 -->
  <view wx:elif="{{phase === 'reveal'}}" class="stage">
    <view class="burst">
      <view class="particle" wx:for="{{particles}}" wx:key="i"
            style="--tx: {{item.tx}}; --ty: {{item.ty}}; background: {{item.color}};"></view>
      <view class="crack-flash"></view>
      <view class="reveal-card" style="background: linear-gradient(160deg, #FFFDF0, {{pet.shell.color}}, #F4B9AE);"></view>
    </view>
    <text class="gen-text">正在生成收藏卡…</text>
  </view>
</view>
