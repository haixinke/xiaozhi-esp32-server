.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.search-bar {
  padding: 24rpx 40rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E3DF;
  flex-shrink: 0;
}

.search-input {
  height: 72rpx;
  background: #E5EBE5; /* --ink-surface */
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid #8C8C88;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
}
.search-icon::after {
  content: '';
  position: absolute;
  width: 14rpx;
  height: 3rpx;
  background: #8C8C88;
  transform: rotate(45deg);
  right: -10rpx;
  bottom: -1rpx;
}

.search-placeholder {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #8C8C88;
}

.faq-scroll {
  flex: 1;
  background: #FFFFFF;
}

.qa-group {
  background: #FFFFFF;
}

.bottom-space {
  height: 24rpx;
}

.cs-bar {
  border-top: 1rpx solid #E5E3DF;
  padding: 26rpx 40rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}

.cs-hint {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #8C8C88;
}

.cs-link {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cs-link-text {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #002900; /* --ink */
}

.cs-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #002900;
  border-right: 3rpx solid #002900;
  transform: rotate(45deg);
}
