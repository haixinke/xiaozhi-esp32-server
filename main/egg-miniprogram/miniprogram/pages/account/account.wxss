.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.content {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 40rpx;
  background: #FAFAF8;
  box-sizing: border-box;
}

.panel {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  border: 1rpx solid #E5E3DF;
  box-shadow: 0rpx 2rpx 4rpx rgba(0, 41, 0, 0.06), 0rpx 4rpx 8rpx rgba(0, 41, 0, 0.04);
}

.spacer {
  flex: 1;
}

.danger-panel {
  margin-bottom: 64rpx;
}
