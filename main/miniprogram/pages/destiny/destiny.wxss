/* pages/destiny/destiny.wxss */
/* Ethereal Companion Design System - 命运初见 */

page {
  background-color: #fbf9f8;
  color: #1b1c1c;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbf9f8;
  background-image:
    radial-gradient(at 0% 0%, rgba(255, 183, 197, 0.2) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(211, 198, 218, 0.2) 0px, transparent 50%);
}

/* -------- 自定义导航栏 -------- */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.08);
}

.nav-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #864e5a;
  letter-spacing: 2rpx;
}

/* -------- 角色区（swiper 在 scroll-view 外） -------- */
.char-section {
  flex-shrink: 0;
  padding: calc(var(--status-bar-height, 44px) + 88rpx + 24rpx) 40rpx 0;
}

/* -------- 滚动内容区 -------- */
.scroll-content {
  flex: 1;
  overflow: hidden;
}

/* -------- 通用 section -------- */
.section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.section-bar {
  width: 6rpx;
  height: 36rpx;
  background: #ffb7c5;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1c;
  line-height: 1.3;
}

/* -------- 角色肖像卡 -------- */
.char-swiper {
  height: 640rpx;
}

.char-card {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  transform: scale(0.92);
  opacity: 0.7;
  transition: all 0.3s ease;
  box-shadow: 0 8rpx 40rpx rgba(134, 78, 90, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.char-card-active {
  transform: scale(1);
  opacity: 1;
  box-shadow: 0 8rpx 60rpx rgba(255, 183, 197, 0.35);
}

.char-image {
  width: 100%;
  height: 100%;
}

.char-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 36rpx 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.35) 0%, transparent 100%);
  text-align: center;
}

.char-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

.char-dots {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 0 0 20rpx;
}

.char-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(134, 78, 90, 0.2);
  transition: all 0.3s ease;
}

.char-dot-active {
  background: #864e5a;
  width: 24rpx;
  border-radius: 6rpx;
}

/* -------- 职业选择网格 -------- */
.occ-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.occ-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.25s ease;
  user-select: none;
}

.occ-item-hover {
  transform: scale(0.95);
}

.occ-item-active {
  background: rgba(255, 183, 197, 0.25);
  border-color: #864e5a;
  box-shadow: 0 0 20rpx rgba(255, 183, 197, 0.3);
}

.occ-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1b1c1c;
  text-align: center;
  line-height: 1.3;
}

.occ-item-active .occ-label {
  color: #864e5a;
  font-weight: 600;
}

/* -------- 音色选择（触发区域） -------- */
.voice-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
}

.voice-cell-hover {
  background: rgba(255, 255, 255, 0.8);
}

.voice-cell-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1b1c1c;
}

.voice-cell-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid rgba(134, 78, 90, 0.5);
  transition: transform 0.3s ease;
}

.voice-cell-arrow-up {
  transform: rotate(180deg);
}

/* -------- 音色底部弹窗 -------- */
.voice-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 200;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
}

.voice-overlay-show {
  opacity: 1;
  visibility: visible;
}

.voice-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fbf9f8;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.voice-panel-show {
  transform: translateY(0);
}

.voice-panel-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx 0 16rpx;
}

.voice-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #864e5a;
}

.voice-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 48rpx;
  transition: background 0.2s ease;
}

.voice-row-active {
  background: rgba(255, 183, 197, 0.15);
}

.voice-row-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1b1c1c;
}

.voice-row-active .voice-row-label {
  color: #864e5a;
  font-weight: 600;
}

.voice-play-btn {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.6;
}

.voice-play-btn-playing {
  opacity: 1;
}

/* -------- 职业病输入 -------- */
.quirks-wrap {
  position: relative;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  overflow: hidden;
}

.quirks-input {
  width: 100%;
  min-height: 200rpx;
  padding: 28rpx;
  padding-bottom: 56rpx;
  font-size: 28rpx;
  color: #1b1c1c;
  line-height: 1.7;
  box-sizing: border-box;
  background: transparent;
}

.quirks-placeholder {
  color: rgba(134, 78, 90, 0.4);
}

.quirks-counter {
  position: absolute;
  bottom: 16rpx;
  right: 24rpx;
  font-size: 22rpx;
  color: rgba(134, 78, 90, 0.4);
}

/* -------- CTA 按钮 -------- */
.cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 40rpx 24rpx;
  background: rgba(251, 249, 248, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  z-index: 100;
}

.cta-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #ffb7c5 0%, #ff9aa2 100%);
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 183, 197, 0.35);
  animation: softPulse 3s infinite ease-in-out;
  user-select: none;
}

.cta-btn-disabled {
  opacity: 0.5;
  animation: none;
  box-shadow: none;
}

.cta-btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #360c19;
  letter-spacing: 2rpx;
}

@keyframes softPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.01); opacity: 0.95; }
}

/* -------- 安全区 -------- */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}
