<view class="page">
  <nav-bar title="添加蛋宝宝"></nav-bar>

  <view class="content">
    <view wx:if="{{sharedInvite}}" class="intro">
      <text class="intro-title">好友送你一颗蛋</text>
      <text class="intro-desc">确认后即可领取蛋宝宝。</text>
    </view>
    <view wx:else class="intro">
      <text class="intro-title">扫描激活码</text>
      <text class="intro-desc">对准激活码二维码扫描，也可以在扫码界面从相册选图。</text>
    </view>

    <text wx:if="{{error}}" class="error">{{error}}</text>

    <view class="spacer"></view>
    <view class="actions">
      <btn wx:if="{{sharedInvite}}" text="{{submitting ? '正在领取…' : '领取好友邀请'}}"
        disabled="{{scanning || submitting}}" bind:tap="onClaimSharedInvite"></btn>
      <btn text="{{submitting ? '正在领取…' : '扫码领取'}}" variant="{{sharedInvite ? 'secondary' : 'primary'}}"
        disabled="{{scanning || submitting}}" bind:tap="onScanCode"></btn>
    </view>
  </view>

  <view wx:if="{{success}}" class="success-mask">
    <view class="success-egg-stage">
      <view class="success-glow"></view>
      <view class="success-egg"></view>
    </view>
    <text class="success-text">你获得了一只{{success.petType}}蛋宝宝</text>
  </view>
</view>
