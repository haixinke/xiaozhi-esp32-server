<view class="page">
  <block wx:if="{{authChecked && !petRestoreLoading}}">
    <nav-bar wx:if="{{!pet}}" title="蛋宝宝" show-back="{{false}}"></nav-bar>

    <scroll-view class="content {{pet && stage !== 'hatched' ? 'content--incubating' : ''}}" scroll-y="{{!(pet && stage !== 'hatched')}}">
      <view wx:if="{{petRestoreError}}" class="empty-state pet-restore-error">
        <view class="empty-orbit"><view class="empty-egg"></view></view>
        <text class="empty-title">暂时无法加载蛋宝宝</text>
        <text class="empty-desc">请检查网络后重新加载。</text>
        <button class="primary-button" bindtap="onRetryPetRestore">重新加载</button>
      </view>

      <view wx:elif="{{!pet}}" class="empty-state">
        <view class="empty-orbit"><view class="empty-egg"></view></view>
        <text class="empty-title">领取我的蛋宝宝</text>
        <text class="empty-desc">输入购买或好友送给你的激活码，开始一段只属于你们的孵化旅程。</text>
        <view wx:if="{{hasPendingInvite}}" class="friend-invite-card">
          <text class="friend-invite-title">好友送你一颗蛋</text>
          <text class="friend-invite-copy">完成手机号授权后即可领取。</text>
          <button class="primary-button" bindtap="onAddDevice">领取好友邀请</button>
        </view>
        <button wx:else class="primary-button" bindtap="onAddDevice">添加蛋宝宝</button>
        <text class="empty-note">当前版本每个账号只能绑定 1 只</text>
      </view>

      <!-- 孵化期：整屏场景 -->
      <view wx:elif="{{stage !== 'hatched'}}" class="pet-view pet-view--incubating">
        <view class="top-row" style="top:{{nameTopPx}}px;">
          <view class="pet-name-row" bindtap="onPetNameTap" aria-role="button" aria-label="给蛋宝宝起名字">
            <text class="pet-name">{{pet.name || '还没有名字'}}</text>
          </view>
        </view>

        <!-- 临时测试：场景切换器（已隐藏，正式上线前删除整段；恢复时去掉外层注释即可） -->
        <!--
        <view wx:if="{{!doodleEditorVisible}}" class="scene-tester" style="top:{{nameTopPx}}px;">
          <view class="scene-tester-button {{sceneTesterOpen ? 'scene-tester-button--open' : ''}}" aria-role="button" aria-label="切换场景，当前{{sceneTesterLabel}}" catchtap="onSceneTesterToggle">
            <text class="scene-tester-tag">场景</text><text class="scene-tester-current">{{sceneTesterLabel}}</text><text class="scene-tester-chevron">⌄</text>
          </view>
          <scroll-view wx:if="{{sceneTesterOpen}}" class="scene-tester-menu" scroll-y="true">
            <view
              wx:for="{{sceneTesterOptions}}"
              wx:key="key"
              class="scene-tester-option {{sceneTesterKey === item.key ? 'scene-tester-option--active' : ''}}"
              data-scene="{{item.key}}"
              aria-role="button"
              aria-label="切换到{{item.label}}"
              catchtap="onSceneTesterSelect"
            >
              <text class="scene-tester-option-label">{{item.label}}</text><text wx:if="{{sceneTesterKey === item.key}}" class="scene-tester-option-check">✓</text>
            </view>
          </scroll-view>
        </view>
        -->

        <view class="egg-zone egg-zone--incubating">
          <view wx:if="{{feedback}}" class="feedback-bubble feedback-bubble--incubating" style="top:{{nameTopPx}}px;" catchtap="noop">{{feedback}}</view>
          <incubation-scene
            environment="{{environment}}"
            egg-art-url="{{eggArtUrl}}"
            lamp-on="{{lampOn}}"
            bind:eggtap="onEggTap"
            bind:eggcuddle="onEggCuddle"
            bind:lamptap="onLampTap"
            bind:windowtap="onWindowTap"
            bind:retryscene="onRetryScene"
          />
          <view wx:if="{{cuddleProgress > 0}}" class="cuddle-track"><view class="cuddle-fill" style="width: {{cuddleProgress}}%;"></view></view>
        </view>

        <view wx:if="{{stage !== 'ready'}}" class="companion-section companion-section--incubating">
          <view class="companion-primary-dock">
            <view class="companion-item companion-item--{{item.key}} {{item.locked ? 'companion-item--locked' : ''}}"
                  wx:for="{{companionActions}}" wx:key="key"
                  hover-class="companion-item--pressed"
                  data-key="{{item.key}}"
                  aria-role="button"
                  aria-label="{{item.locked ? item.title + '，暂未开放' : item.title}}"
                  bindtap="onCompanionTap">
              <view class="companion-icon-wrap">
                <image class="companion-icon" src="{{item.icon}}" mode="aspectFit" />
                <text wx:if="{{item.key === 'draw'}}" class="draw-action-spark">✦</text>
              </view>
            </view>
          </view>
        </view>

        <view wx:if="{{stage === 'ready'}}" class="hatch-entry">
          <button class="primary-button" bindtap="onPrimaryAction"><text class="button-label">{{actionLabel}}</text></button>
        </view>
      </view>

      <!-- 破壳后：保留原有宠物展示 -->
      <view wx:else class="pet-view">
        <view class="top-row">
          <view>
            <text class="eyebrow">{{pet.petType}} · 已破壳</text>
            <text class="pet-name pet-name--plain">{{pet.name || '还没有名字'}}</text>
          </view>
        </view>

        <view class="egg-zone" bindtap="onOpenProfile">
          <view wx:if="{{feedback}}" class="feedback-bubble" catchtap="noop">{{feedback}}</view>
          <view class="scene-or-avatar">
            <image wx:if="{{pet.sceneUrl}}" class="life-home-scene" src="{{pet.sceneUrl}}" mode="aspectFill" catchtap="onOpenLifeScene"></image>
            <pet-avatar wx:else pet-type="{{pet.prototype}}" size="{{270}}"></pet-avatar>
          </view>
        </view>

        <view class="state-card">
          <view class="state-dot"></view>
          <view class="state-copy">
            <text class="state-title">{{stageText}}</text>
          </view>
        </view>

        <view wx:if="{{dailyStatus}}" class="status-daily">
          <text class="status-meta">今日状态 · {{dailyStatus.mood}}</text>
          <text class="status-line">{{dailyStatus.line}}</text>
        </view>

        <view class="home-actions">
          <button class="primary-button home-actions__chat" bindtap="onPrimaryAction"><text class="button-label">{{actionLabel}}</text></button>
          <button class="primary-button home-actions__scene" bindtap="onChangeScene"><text class="button-label">更换场景</text></button>
        </view>
      </view>
    </scroll-view>
  </block>

  <view wx:if="{{showPhoneAuthorization}}" class="phone-auth-mask" catchtap="onClosePhoneAuthorization">
    <view class="phone-auth-dialog" catchtap="noop">
      <text class="phone-auth-title">领取前需要授权手机号</text>
      <text class="phone-auth-copy">用于保障你的蛋宝宝账号安全。</text>
      <button class="primary-button" open-type="getPhoneNumber" loading="{{authorizingPhone}}" disabled="{{authorizingPhone}}" bindgetphonenumber="onAuthorizePhone">授权手机号并继续</button>
      <button class="phone-auth-cancel" disabled="{{authorizingPhone}}" bindtap="onClosePhoneAuthorization">暂不领取</button>
    </view>
  </view>

  <!-- 命名弹层：点击左上角名字药丸打开 -->
  <view wx:if="{{showNameSheet}}" class="name-mask" catchtouchmove="noop">
    <view class="name-sheet">
      <view class="name-handle"></view>
      <view class="name-sheet-content">
        <text class="name-sheet-title">{{pet && pet.name ? '修改名字' : '我还没有名字'}}</text>
        <text class="name-sheet-copy">{{pet && pet.name ? '新名字保存后会继续留在这间房里。' : '给我起一个昵称吧，也可以以后再决定。'}}</text>
        <view class="name-input-wrap">
          <input class="name-input" value="{{nameDraft}}" maxlength="10" placeholder="最多 10 个字" bindinput="onNameInput" />
          <text class="name-count">{{nameCount}}/10</text>
        </view>
        <text wx:if="{{nameError}}" class="name-error">{{nameError}}</text>
        <view class="name-actions">
          <button class="name-save" hover-class="button-press" disabled="{{savingName}}" bindtap="onSaveName"><text class="button-label">{{savingName ? '正在保存…' : '记住这个名字'}}</text></button>
          <button class="name-skip" hover-class="button-press" bindtap="onCloseNameSheet"><text class="button-label">{{pet && pet.name ? '取消' : '暂不命名'}}</text></button>
        </view>
      </view>
    </view>
  </view>

  <!-- 每日窗景详情 -->
  <daily-window-detail
    visible="{{dailyWindowVisible}}"
    image="{{environment.windowImage}}"
    weather="{{environment.weather}}"
    season="{{environment.season}}"
    period="{{environment.period}}"
    light-phase="{{environment.lightPhase}}"
    weather-label="{{dailyWindowWeatherLabel}}"
    period-label="{{dailyWindowPeriodLabel}}"
    origin-style="{{dailyWindowOriginStyle}}"
    bind:close="onDailyWindowClosed"
    bind:retry="onDailyWindowRetry"
  />

  <!-- 涂鸦编辑器（孵化期场景内嵌） -->
  <doodle-editor
    visible="{{doodleEditorVisible}}"
    pet-id="{{pet.id}}"
    initial-operations="{{doodleInitialOperations}}"
    bind:saved="onDoodleSaved"
    bind:close="onDoodleEditorClose"
  />

  <!-- 破壳视频遮罩 -->
  <view wx:if="{{hatching}}" class="hatch-overlay">
    <video
      id="hatchVideo"
      class="hatch-video"
      src="https://oss.eggbabe.com/video/egg-out.mp4"
      autoplay
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      show-play-btn="{{false}}"
      object-fit="cover"
      bindended="onHatchVideoEnded"
      binderror="onHatchVideoError"
    ></video>
  </view>
</view>
