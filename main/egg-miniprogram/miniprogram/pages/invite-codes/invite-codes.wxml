<view class="page">
  <nav-bar title="我的激活码"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view wx:if="{{loading}}" class="state">
      <text class="state-text">加载中…</text>
    </view>

    <view wx:elif="{{error && !inviteCode}}" class="state">
      <text class="state-error">{{error}}</text>
      <button class="retry" bindtap="onRetry">重试</button>
    </view>

    <block wx:elif="{{inviteCode}}">
      <view class="intro">
        <text class="title">把一颗蛋送给朋友</text>
        <text class="desc">请好友打开蛋宝宝，从「添加蛋宝宝」扫码领取。</text>
      </view>
      <view class="code-card">
        <view class="code-head">
          <text class="state-label {{qrImage ? 'state-label--available' : ''}}">{{statusLabel}}</text>
          <text class="usage">已用 {{inviteCode.usedCount}} / {{inviteCode.quota}} · 剩余 {{inviteCode.remaining}}</text>
        </view>
        <block wx:if="{{qrImage}}">
          <image class="qr-image" src="{{qrImage}}" data-path="{{qrImage}}" mode="aspectFit"
            aria-label="我的激活码二维码" binderror="onQrImageError"></image>
          <button class="qr-save" disabled="{{saving}}" bindtap="onSaveQrImage">{{saving ? '保存中…' : '保存到相册'}}</button>
        </block>
        <view wx:elif="{{error}}" class="qr-error">
          <text class="state-error">{{error}}</text>
          <button class="retry" bindtap="onRetry">重试</button>
        </view>
      </view>
    </block>

    <view wx:else class="state">
      <text class="state-text">暂无可用激活码</text>
    </view>
  </scroll-view>
</view>
