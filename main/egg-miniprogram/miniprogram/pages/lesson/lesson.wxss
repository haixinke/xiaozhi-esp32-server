.page{display:flex;flex-direction:column;height:100vh;background:#FAFAF8}.content{flex:1;display:flex;flex-direction:column;padding:58rpx 42rpx 50rpx}.kicker{font-size:20rpx;letter-spacing:4rpx;color:#809044}.title{margin-top:20rpx;font-size:42rpx;font-weight:600;color:#002900}.desc{margin-top:16rpx;font-size:25rpx;color:#77756E}.options{margin-top:52rpx}.option{height:116rpx;margin-bottom:20rpx;padding:0 30rpx;border-radius:28rpx;border:2rpx solid #E1DFD8;background:#FFF;display:flex;align-items:center;gap:24rpx;font-size:28rpx}.option--selected{border-color:#9DB65B;background:#F5F8ED}.icon{width:54rpx;height:54rpx;border-radius:18rpx;background:#FAFAEF;color:#6E6B35;display:flex;align-items:center;justify-content:center;font-size:28rpx}.arrow{margin-left:auto;color:#829047;font-size:30rpx}.spacer{flex:1}.primary{height:94rpx;line-height:94rpx;padding:0;border:0;border-radius:999rpx;background:#002900;color:#FFF;font-size:29rpx;text-align:center;width:100%}.primary--disabled{opacity:.35}.primary::after{border:none}
