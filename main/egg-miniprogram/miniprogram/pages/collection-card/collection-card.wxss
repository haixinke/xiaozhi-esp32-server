.page { display: flex; flex-direction: column; height: 100vh; background: #F3F1E8; }
.content { flex: 1; padding: 28rpx 36rpx 64rpx; box-sizing: border-box; }
.new-banner { margin-bottom: 22rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #002900; color: #FFF; text-align: center; font-size: 23rpx; }
.card { position: relative; padding: 36rpx 34rpx 32rpx; border-radius: 38rpx; background: linear-gradient(160deg,#FFFDF2,#FAF7D8 56%,#F9D8D1); border: 4rpx solid #FFF; box-shadow: 0 26rpx 60rpx rgba(0,41,0,.16); overflow: hidden; }
.card::before { content: ''; position: absolute; width: 300rpx; height: 300rpx; border-radius: 50%; right: -140rpx; top: 120rpx; border: 2rpx solid rgba(0,41,0,.09); }
.card-top { display: flex; justify-content: space-between; align-items: center; }
.card-kicker { font-size: 18rpx; letter-spacing: 3rpx; color: #56612E; }.collectible { padding: 6rpx 16rpx; border: 1rpx solid #78863D; border-radius: 999rpx; font-size: 19rpx; color: #56612E; }
.portrait { position: relative; width: 270rpx; height: 270rpx; margin: 32rpx auto 24rpx; display: flex; align-items: center; justify-content: center; }.portrait-aura { position: absolute; inset: 0; border-radius: 50%; background: radial-gradient(circle,#FFF 0,rgba(255,255,255,.1) 68%); }
.name { display: block; text-align: center; font-size: 46rpx; font-weight: 600; color: #002900; }.gender { font-size: 29rpx; color: #7D8945; }.style { display: block; margin-top: 10rpx; text-align: center; font-size: 24rpx; color: #737168; }
.personality { display: block; margin: 26rpx auto 28rpx; max-width: 540rpx; text-align: center; font-size: 25rpx; line-height: 1.6; color: #48473F; }
.stats { display: grid; grid-template-columns: 1fr 1fr; gap: 2rpx; background: rgba(255,255,255,.65); border-radius: 24rpx; overflow: hidden; }.stats > view { padding: 20rpx 24rpx; background: rgba(255,255,255,.48); }.stat-label { display: block; font-size: 19rpx; color: #929087; }.stat-value { display: block; margin-top: 7rpx; font-size: 25rpx; font-weight: 600; color: #31362A; }
.record { display: flex; justify-content: space-between; margin-top: 24rpx; font-size: 21rpx; color: #6B704E; }
.serial-row { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid rgba(0,41,0,.14); }.serial { font-size: 19rpx; letter-spacing: 1rpx; color: #5D633F; }.mini-code { width: 48rpx; height: 48rpx; padding: 5rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 3rpx; background: #FFF; }.mini-code view { background: #002900; }.mini-code view:last-child { border-radius: 50%; background: #9DB65B; }
.actions { margin-top: 28rpx; }.primary,.secondary { height: 88rpx; line-height: 88rpx; border-radius: 999rpx; font-size: 27rpx; }.primary { background: #002900; color: #FFF; }.secondary { flex: 1; background: #FFF; color: #002900; border: 1rpx solid #D8D6CF; }.primary::after,.secondary::after { border: none; }.action-row { display: flex; gap: 18rpx; margin-top: 18rpx; }.text-button { margin-top: 12rpx; background: transparent; color: #6F744F; font-size: 24rpx; }.text-button::after { border: none; }
.share-canvas { position: fixed; left: -2000px; top: 0; width: 600px; height: 840px; }
