<view class="page">
  <nav-bar title="收藏卡"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view wx:if="{{isNew}}" class="new-banner">获得第一张破壳收藏卡 · 已自动收入卡册</view>
    <view class="card">
      <view class="card-title-section">
        <view class="title-copy">
          <text class="name">{{card.name}}</text>
          <text class="collect-context">{{subtitle}}</text>
        </view>
      </view>
      <view class="card-illustration-section">
        <image wx:if="{{card.imageUrl}}" class="illustration" src="{{card.imageUrl}}" mode="aspectFill" show-menu-by-longpress></image>
        <pet-avatar wx:else pet-type="{{card.petType}}" size="{{250}}"></pet-avatar>
      </view>
      <view class="card-data-section">
        <view class="stat-grid">
          <view class="stat-cell"><text class="stat-label">类型</text><text class="stat-value">{{card.petType}}</text></view>
          <view class="stat-cell"><text class="stat-label">生日</text><text class="stat-value">{{birthdayLabel}}</text></view>
          <view class="stat-cell"><text class="stat-label">星座</text><text class="stat-value">{{card.zodiac}} {{zodiacSymbol}}</text></view>
          <view class="stat-cell">
            <text class="stat-label">性别</text>
            <view wx:if="{{genderKind}}" class="gender-symbol gender-symbol--{{genderKind}}">
              <view class="gender-symbol__ring"></view>
              <view class="gender-symbol__stem"></view>
              <view class="gender-symbol__bar"></view>
            </view>
            <text wx:else class="stat-value">{{genderLabel}}</text>
          </view>
          <view class="stat-cell"><text class="stat-label">血型</text><text class="stat-value">{{card.bloodType}} 型</text></view>
          <view class="stat-cell"><text class="stat-label">MBTI</text><text class="stat-value">{{card.mbti}}</text></view>
        </view>
        <text class="card-signature {{signatureClass}}">"{{card.personality}}"</text>
      </view>
    </view>
    <view class="actions">
      <view class="action-row">
        <button class="secondary" bindtap="onSave">保存图片</button>
        <button class="secondary" open-type="share">分享给好友</button>
      </view>
    </view>
    <canvas canvas-id="shareCanvas" class="share-canvas"></canvas>
  </scroll-view>
</view>
