/* components/chat-bubble/chat-bubble.wxss */
/* Ethereal Companion Design System - 完美女女友主题 */

.cb-row {
  display: flex;
  flex-direction: column;
  margin: 0 0 24rpx;
  max-width: 100%;
  animation: cb-enter 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cb-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cb-row.cb-user {
  align-items: flex-end;
}
.cb-row.cb-assistant {
  align-items: flex-start;
}

/* ----- 气泡 ----- */
.cb-bubble {
  position: relative;
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 32rpx;
  overflow: hidden;
  isolation: isolate;
}

.cb-row.cb-user .cb-bubble {
  border-top-right-radius: 32rpx;
  border-bottom-right-radius: 0; /* 右下角直角 */
  background: rgba(255, 183, 193, 0.8);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.2);
}

.cb-row.cb-assistant .cb-bubble {
  border-top-left-radius: 32rpx;
  border-bottom-left-radius: 0; /* 左下角直角 */
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(255, 183, 193, 0.1);
}

/* assistant 左侧的指示线 */
.cb-row.cb-assistant .cb-bubble::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: linear-gradient(180deg, #fbb3c1, transparent);
  opacity: 0.7;
}

/* 流式时的边光 */
.cb-glow {
  position: absolute;
  inset: -1rpx;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(120deg,
    transparent 30%,
    rgba(255, 183, 193, 0.35) 50%,
    transparent 70%);
  background-size: 200% 100%;
  z-index: -1;
}

.cb-typing .cb-glow {
  opacity: 1;
  animation: cb-shimmer 2.4s linear infinite;
}

@keyframes cb-shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -100% 0; }
}

/* ----- 文本 ----- */
.cb-content {
  position: relative;
  display: block;
  word-break: break-word;
}

.cb-text {
  font-size: 30rpx;
  line-height: 1.65;
  color: #1b1c1c;
  letter-spacing: 0.5rpx;
}

.cb-row.cb-user .cb-text {
  color: #7b4551;
  font-weight: 500;
}

/* ================================================================
   DARK MODE (.dark is on the same element as .cb-row)
   ================================================================ */

.cb-row.dark.cb-user .cb-bubble {
  background: rgba(134, 78, 90, 0.6);
  border-color: rgba(134, 78, 90, 0.3);
  box-shadow: 0 4rpx 20rpx rgba(134, 78, 90, 0.2);
}

.cb-row.dark.cb-assistant .cb-bubble {
  background: rgba(30, 28, 46, 0.8);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.cb-row.dark.cb-assistant .cb-bubble::before {
  background: linear-gradient(180deg, #864e5a, transparent);
}

.cb-row.dark .cb-text {
  color: #e8e4e3;
}

.cb-row.dark.cb-user .cb-text {
  color: #f0dce0;
}

/* ----- 音频播放按钮 ----- */
.cb-audio {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.cb-audio-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(134, 78, 90, 0.12);
  transition: background 0.2s;
}

.cb-audio-icon:active {
  background: rgba(134, 78, 90, 0.22);
}

/* 播放三角形 */
.cb-audio-triangle {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 10rpx 0 10rpx 16rpx;
  border-color: transparent transparent transparent #864e5a;
  margin-left: 4rpx;
}

/* 播放中的音频条动画 */
.cb-audio-bars {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 24rpx;
}

.cb-audio-bar {
  width: 4rpx;
  background: #864e5a;
  border-radius: 2rpx;
  animation: cb-bar-bounce 0.8s ease-in-out infinite alternate;
}

.cb-audio-bar:nth-child(1) {
  height: 12rpx;
  animation-delay: 0s;
}

.cb-audio-bar:nth-child(2) {
  height: 20rpx;
  animation-delay: 0.2s;
}

.cb-audio-bar:nth-child(3) {
  height: 14rpx;
  animation-delay: 0.4s;
}

@keyframes cb-bar-bounce {
  0% { transform: scaleY(0.5); }
  100% { transform: scaleY(1.2); }
}

/* 深色模式音频按钮 */
.cb-row.dark .cb-audio-icon {
  background: rgba(255, 183, 193, 0.15);
}

.cb-row.dark .cb-audio-triangle {
  border-color: transparent transparent transparent #f0dce0;
}

.cb-row.dark .cb-audio-bar {
  background: #f0dce0;
}

/* ----- 撤回占位 ----- */
.cb-recalled {
  align-self: center;
  max-width: 78%;
  padding: 8rpx 20rpx;
}

.cb-recalled-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(27, 28, 28, 0.4);
  text-align: center;
}

.cb-row.dark .cb-recalled-text {
  color: rgba(232, 228, 227, 0.4);
}
