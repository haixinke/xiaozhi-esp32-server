user  nginx;
worker_processes  auto;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  300;
    client_header_timeout 180s;
    client_body_timeout 180s;
    client_max_body_size 1024M;

    # 日志输出到stdout/stderr，SAE容器日志规范
    access_log /dev/stdout;
    error_log  /dev/stderr;

    gzip on;
    gzip_buffers 32 4K;
    gzip_comp_level 6;
    gzip_min_length 100;
    gzip_types application/javascript text/css text/xml image/jpeg image/gif image/png application/json font/woff font/woff2;
    gzip_disable "MSIE [1-6]\.";
    gzip_vary on;

    server {
        listen  80;
        server_name localhost;

        # 前端静态资源
        location / {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /index.html;
        }

        # API反向代理到manager-api服务
        # UPSTREAM_API_ADDR通过环境变量注入，格式如：manager-api.xiaozhi.svc.cluster.local:8002
        location /xiaozhi/ {
            proxy_pass http://${UPSTREAM_API_ADDR};
            proxy_set_header   Host   $host;
            proxy_set_header   X-Real-IP  $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;

            proxy_connect_timeout 15;
            proxy_send_timeout 15;
            proxy_read_timeout 15;
        }
    }
}
