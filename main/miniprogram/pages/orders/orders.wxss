/* 我的订单 - Ethereal Companion 设计系统 */

/* 覆盖全局 page { overflow: hidden } 以启用页面滚动 */
page {
  height: auto;
  overflow: auto;
}

/* ===== Base ===== */
.orders-container {
  min-height: 100vh;
  background: #f6f3f2;
  padding: 24rpx 28rpx 80rpx;
}

/* ===== Tab 分段器 ===== */
.orders-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.06);
  padding: 8rpx;
  margin-bottom: 24rpx;
}

.orders-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #8a7a7e;
  border-radius: 18rpx;
  transition: all 0.2s ease;
  letter-spacing: 1rpx;
}

.orders-tab-active {
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(134, 78, 90, 0.25);
}

/* ===== 订单卡片 ===== */
.order-card {
  background: rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 26rpx;
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.07);
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
}

/* 卡片头部 */
.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.order-product-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1c;
  flex: 1;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

/* 状态标签 */
.order-status-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 18rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  letter-spacing: 1rpx;
}

.order-status-pending { color: #d97706; background: rgba(217, 119, 6, 0.12); }
.order-status-paid { color: #5a8a4e; background: rgba(90, 138, 78, 0.12); }
.order-status-fulfilled { color: #5a8a4e; background: rgba(90, 138, 78, 0.12); }
.order-status-cancelled { color: #8a7a7e; background: rgba(138, 122, 126, 0.12); }
.order-status-refunded { color: #c0392b; background: rgba(192, 57, 43, 0.12); }
.order-status-expired { color: #8a7a7e; background: rgba(138, 122, 126, 0.12); }

/* 卡片主体 */
.order-card-body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

/* 类型标签 */
.order-type-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  letter-spacing: 0.5rpx;
}

.order-type-subscription { color: #864e5a; background: rgba(134, 78, 90, 0.08); }
.order-type-item { color: #b8860b; background: rgba(184, 134, 11, 0.08); }

/* 金额行 */
.order-amount-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.order-amount {
  font-size: 36rpx;
  font-weight: 700;
  color: #864e5a;
}

.order-qty {
  font-size: 24rpx;
  color: #8a7a7e;
}

/* 卡片底部 */
.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(134, 78, 90, 0.06);
}

.order-trade-no {
  font-size: 22rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

.order-time {
  font-size: 22rpx;
  color: #8a7a7e;
}

/* ===== 骨架屏 ===== */
.order-skeleton {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 26rpx;
  padding: 28rpx 30rpx;
  margin-bottom: 18rpx;
}

.order-skel-line {
  height: 28rpx;
  border-radius: 14rpx;
  background: rgba(134, 78, 90, 0.08);
  margin-bottom: 16rpx;
}

.order-skel-name { width: 50%; height: 32rpx; }
.order-skel-meta { width: 30%; }
.order-skel-price { width: 25%; height: 36rpx; }

/* ===== 状态（错误/空） ===== */
.orders-state {
  text-align: center;
  padding: 200rpx 40rpx;
}

.orders-state-text {
  display: block;
  font-size: 28rpx;
  color: #8a7a7e;
  margin-bottom: 28rpx;
}

.orders-retry {
  display: inline-block;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #864e5a, #d4737a);
  border-radius: 30rpx;
  padding: 14rpx 48rpx;
  box-shadow: 0 6rpx 18rpx rgba(134, 78, 90, 0.22);
}

.orders-retry:active {
  opacity: 0.85;
}

/* ===== 深色模式 ===== */
.orders-container.dark {
  background: #121220;
}

.dark .orders-tabs {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dark .orders-tab {
  color: #6a6468;
}

.dark .orders-tab-active {
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(134, 78, 90, 0.2);
}

.dark .order-card {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dark .order-product-name {
  color: #e8e4e3;
}

.dark .order-status-pending { color: #f0a040; background: rgba(217, 119, 6, 0.18); }
.dark .order-status-paid { color: #7ab86e; background: rgba(90, 138, 78, 0.15); }
.dark .order-status-fulfilled { color: #7ab86e; background: rgba(90, 138, 78, 0.15); }
.dark .order-status-cancelled { color: #6a6468; background: rgba(138, 122, 126, 0.15); }
.dark .order-status-refunded { color: #e06050; background: rgba(192, 57, 43, 0.18); }
.dark .order-status-expired { color: #6a6468; background: rgba(138, 122, 126, 0.15); }

.dark .order-type-subscription { color: #c49ba5; background: rgba(134, 78, 90, 0.15); }
.dark .order-type-item { color: #daa520; background: rgba(184, 134, 11, 0.15); }

.dark .order-amount {
  color: #d4737a;
}

.dark .order-qty {
  color: #6a6468;
}

.dark .order-card-footer {
  border-top-color: rgba(134, 78, 90, 0.12);
}

.dark .order-trade-no {
  color: #6a6468;
}

.dark .order-time {
  color: #6a6468;
}

.dark .order-skeleton {
  background: rgba(30, 28, 46, 0.6);
}

.dark .order-skel-line {
  background: rgba(134, 78, 90, 0.12);
}

.dark .orders-state-text {
  color: #6a6468;
}
