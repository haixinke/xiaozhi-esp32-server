<view class="page">
  <nav-bar title="破壳收藏卡"></nav-bar>
  <scroll-view class="content" scroll-y>
    <view wx:if="{{isNew}}" class="new-banner">获得第一张破壳收藏卡 · 已自动收入卡册</view>
    <view class="card">
      <view class="card-top"><text class="card-kicker">EGGBABY · BIRTH CARD</text><text class="collectible">{{card.collectible}}</text></view>
      <view class="portrait">
        <view class="portrait-aura"></view>
        <image wx:if="{{card.imageUrl}}" class="portrait-image" src="{{card.imageUrl}}" mode="aspectFill" show-menu-by-longpress />
        <pet-avatar wx:else pet-type="{{card.petType || card.prototype}}" size="{{250}}"></pet-avatar>
      </view>
      <text class="name">{{card.name}} <text class="gender">{{card.gender}}</text></text>
      <text wx:if="{{card.style}}" class="style">{{card.petType || card.prototype}} · {{card.style}}</text>
      <text class="personality">“{{card.personality}}”</text>
      <view class="stats"><view><text class="stat-label">生日</text><text class="stat-value">{{card.birthday}}</text></view><view><text class="stat-label">星座</text><text class="stat-value">{{card.zodiac}}</text></view><view><text class="stat-label">MBTI</text><text class="stat-value">{{card.mbti}}</text></view><view><text class="stat-label">血型</text><text class="stat-value">{{card.bloodType}}</text></view></view>
      <view class="record"><text>{{card.hatchQuality}}</text><text>初始主人 · {{card.originalOwner}}</text></view>
      <view class="serial-row"><text class="serial">{{card.serial}}</text><view class="mini-code"><view></view><view></view><view></view><view></view></view></view>
    </view>
    <view class="actions"><view class="action-row"><button class="secondary" bindtap="onSave">保存图片</button><button class="secondary" open-type="share">分享给好友</button></view></view>
    <canvas canvas-id="shareCanvas" class="share-canvas"></canvas>
  </scroll-view>
</view>
