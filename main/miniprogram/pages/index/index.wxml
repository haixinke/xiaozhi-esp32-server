<!--pages/index/index.wxml-->
<view class="page {{darkMode ? 'dark' : ''}}">
  <!-- 背景层：背景图片 -->
  <image wx:if="{{!booting && companionBgImage}}" class="bg-image" src="{{companionBgImage}}" mode="aspectFill"></image>

  <!-- 顶部状态栏 - AI伴侣导航 -->
  <view wx:if="{{!booting && !bindFailed}}" class="top-bar">
    <!-- AI头像和名字 -->
    <view class="ai-profile">
      <view class="avatar-wrapper" bindtap="onAvatarTap" hover-class="avatar-wrapper-hover" hover-stay-time="80">
        <image class="avatar-image" src="{{companionAvatar || '/images/avatar-default.png'}}" mode="aspectFill"></image>
        <view class="status-dot state-{{connectionState}}"></view>
      </view>
      <view class="ai-meta">
        <text class="ai-status">
          <block wx:if="{{connectionState === 'connected'}}">在线</block>
          <block wx:elif="{{connectionState === 'connecting'}}">连接中...</block>
          <block wx:else>离线</block>
        </text>
      </view>
    </view>

    <!-- 退下按钮 - 已连接时显示 -->
    <view wx:if="{{!booting && connectionState === 'connected'}}" class="summon-btn" bindtap="onDisconnect" hover-class="summon-btn-hover" hover-stay-time="80">
      <text class="summon-text">退下</text>
    </view>

    <!-- 召唤按钮 - 仅在断开连接时显示 -->
    <view wx:if="{{!booting && connectionState === 'disconnected'}}" class="summon-btn" bindtap="onSummon" hover-class="summon-btn-hover" hover-stay-time="80">
      <text class="summon-text">召唤</text>
    </view>
  </view>

  <!-- 启动占位 -->
  <view wx:if="{{booting}}" class="boot-shell">
    <view class="boot-orbit">
      <view class="boot-dot"></view>
    </view>
    <text class="boot-text">正在准备…</text>
  </view>

  <!-- 绑定失败重试 -->
  <view wx:if="{{bindFailed}}" class="boot-shell">
    <text class="boot-text">设备连接失败</text>
    <view class="retry-btn" bindtap="onRetryBind" hover-class="retry-btn-hover" hover-stay-time="80">
      <text class="retry-btn-text">重试</text>
    </view>
  </view>

  <!-- 消息区 -->
  <scroll-view
    wx:if="{{!booting && !bindFailed}}"
    class="conversation"
    style="height: {{scrollViewHeight}}px;"
    scroll-y="true"
    scroll-with-animation="true"
    enhanced="true"
    bounces="{{false}}"
    show-scrollbar="false"
    scroll-into-view="{{scrollToView}}"
    refresher-enabled="{{!historyNoMore}}"
    refresher-threshold="{{80}}"
    refresher-default-style="none"
    refresher-background="transparent"
    refresher-triggered="{{historyLoading}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <!-- 自定义下拉刷新指示器 -->
    <view slot="refresher" class="refresher-container">
      <view class="refresher-spinner"></view>
    </view>

    <view class="conversation-inner">
      <!-- 历史记录加载状态 -->
      <view class="history-loader" wx:if="{{historyLoading}}">
        <view class="history-loader-dot"></view>
        <text class="history-loader-text">加载中...</text>
      </view>

      <!-- 消息列表（含流式回复） -->
      <block wx:for="{{messages}}" wx:key="id">
        <view id="{{item.id}}">
          <chat-bubble role="{{item.role}}" content="{{item.content}}" typing="{{item.typing}}" audioId="{{item.audioId}}" darkMode="{{darkMode}}" />
        </view>
      </block>

      <!-- 正在输入指示器 -->
      <view wx:if="{{chatState === 'thinking'}}" class="typing-indicator">
        <view class="typing-dot"></view>
        <view class="typing-dot" style="animation-delay: 0.2s"></view>
        <view class="typing-dot" style="animation-delay: 0.4s"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view wx:if="{{!booting && !bindFailed}}" class="input-bar safe-area-bottom">
    <!-- 录音浮层 -->
    <view wx:if="{{recording}}" class="recording-overlay">
      <view class="recording-indicator">
        <view class="recording-waves">
          <view class="recording-wave-bar"></view>
          <view class="recording-wave-bar"></view>
          <view class="recording-wave-bar"></view>
          <view class="recording-wave-bar"></view>
          <view class="recording-wave-bar"></view>
        </view>
        <text class="recording-text">{{recordCancelled ? '松开 取消' : '手指上滑 取消'}}</text>
      </view>
    </view>

    <view class="input-bar-inner">
      <!-- 模式切换按钮（仅订阅用户可见） -->
      <view
        wx:if="{{hasVoiceInput}}"
        class="mode-toggle-btn"
        bindtap="onToggleInputMode"
        hover-class="mode-toggle-btn-hover"
        hover-stay-time="80"
      >
        <image
          class="mode-toggle-icon"
          src="{{inputMode === 'text' ? (darkMode ? '/images/laba-dark.png' : '/images/laba.png') : (darkMode ? '/images/jianpan-dark.png' : '/images/jianpan.png')}}"
          mode="aspectFit"
        />
      </view>

      <!-- 文字模式 -->
      <block wx:if="{{inputMode === 'text'}}">
        <view class="input-wrapper" bindtap="onInputTap">
          <input
            class="message-input"
            type="text"
            placeholder="输入消息..."
            placeholder-style="color: rgba(148, 163, 184, 0.5);"
            value="{{inputText}}"
            bindinput="onTextInput"
            bindconfirm="onTextSend"
            confirm-type="send"
            maxlength="500"
            disabled="{{connectionState !== 'connected' || chatState === 'thinking'}}"
            adjust-position="{{true}}"
            cursor-spacing="20"
          />
        </view>
      </block>

      <!-- 语音模式 -->
      <block wx:else>
        <view
          class="voice-btn {{recording ? 'is-pressed' : ''}} {{recordCancelled ? 'is-cancelled' : ''}}"
          catchtouchstart="onVoiceTouchStart"
          catchtouchmove="onVoiceTouchMove"
          catchtouchend="onVoiceTouchEnd"
          catchtouchcancel="onVoiceTouchCancel"
        >
          <text class="voice-btn-text">{{recordCancelled ? '松开 取消' : '按住 说话'}}</text>
        </view>
      </block>
    </view>
  </view>
</view>
