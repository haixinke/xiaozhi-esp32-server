<view class="settings-container {{darkMode ? 'dark' : ''}}">

  <!-- 我们的羁绊面板 -->
  <view class="bond-card">
    <!-- 头像区域：用户 + 红线 + 伴侣 -->
    <view class="bond-avatars">
      <view class="bond-avatar-wrap bond-user">
        <button class="bond-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="bond-avatar {{planCode === 'gold' ? 'avatar-glow' : ''}}" src="{{userAvatar}}" mode="aspectFill" />
        </button>
        <text class="bond-avatar-label">你</text>
      </view>
      <view class="bond-thread">
        <view class="bond-thread-line {{planCode === 'gold' ? 'thread-gold' : planCode === 'silver' ? 'thread-silver' : 'thread-free'}}"></view>
      </view>
      <view class="bond-avatar-wrap bond-companion">
        <image class="bond-avatar {{planCode === 'gold' ? 'avatar-glow' : ''}}" src="{{companionAvatar}}" mode="aspectFill" />
        <text class="bond-avatar-label">她</text>
      </view>
    </view>

    <!-- 身份标签 -->
    <view class="bond-identity">
      <text class="bond-identity-name {{planCode === 'gold' ? 'bond-gold' : planCode === 'silver' ? 'bond-silver' : 'bond-free'}}">{{identityName}}</text>
    </view>

  </view>

  <!-- 功能入口 -->
  <view class="entry-row">
    <view class="entry-card" bindtap="onContractTap">
      <!-- <view class="entry-icon-area entry-icon-contract"></view> -->
      <text class="entry-title">我的契约</text>
      <text class="entry-desc">管理订阅</text>
    </view>
    <view class="entry-card" bindtap="onBackpackTap">
      <!-- <view class="entry-icon-area entry-icon-backpack"></view> -->
      <text class="entry-title">我的背包</text>
      <text class="entry-desc">管理道具</text>
    </view>
    <view class="entry-card" bindtap="onCompanionTap">
      <text class="entry-title">我的女友</text>
      <text class="entry-desc">她的资料</text>
    </view>
  </view>

  <!-- 设置项列表 -->
  <view class="settings-list">
    <!-- 主题设置 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">深色模式</text>
      </view>
      <switch checked="{{darkMode}}" bindchange="onThemeChange" color="#864e5a" />
    </view>

    <!-- 一封写给你的信 -->
    <view class="settings-item" bindtap="onLetterTap">
      <view class="item-left">
        <text class="item-label">一封写给你的信</text>
      </view>
    </view>

    <!-- 版本信息 -->
    <view class="settings-item">
      <view class="item-left">
        <text class="item-label">版本</text>
      </view>
      <view class="item-right">
        <text class="item-value">1.0.0</text>
      </view>
    </view>
  </view>

  <!-- 底部信息 -->
  <view class="settings-footer">
    <text class="footer-text">完美女友 © 2026</text>
  </view>

  <!-- 契约购买浮窗 -->
  <view class="contract-overlay {{showContractPopup ? 'contract-overlay-show' : ''}}" bindtap="onContractOverlayTap">
    <view class="contract-panel" catchtap="onContractPanelTap">
      <view class="contract-header">
        <text class="contract-romantic-text">你愿意签一个契约，让我们离的更近一点吗？</text>
      </view>

      <view class="contract-cards">
        <view class="contract-card {{selectedPlanId === item.id ? 'contract-card-selected' : ''}}"
              wx:for="{{plans}}" wx:key="id"
              data-id="{{item.id}}" bindtap="onPlanSelect">
          <text class="contract-card-name">{{item.planName}}</text>
          <view class="contract-card-price">
            <text class="contract-card-promo">¥{{item.promoYuan}}</text>
            <text class="contract-card-period" wx:if="{{item.durationText}}">/{{item.durationText}}</text>
            <text class="contract-card-original" wx:if="{{item.promoYuan !== item.priceYuan}}">¥{{item.priceYuan}}</text>
          </view>
          <view class="contract-card-features">
            <text class="contract-feature" wx:for="{{item.features}}" wx:for-item="feat" wx:key="code">{{feat.label}}</text>
          </view>
        </view>
      </view>

      <view class="contract-action">
        <view class="contract-btn {{selectedPlanId ? 'contract-btn-active' : 'contract-btn-disabled'}}" bindtap="onSignContract">
          签订契约
        </view>
      </view>
    </view>
  </view>

  <!-- 契约详情浮窗 -->
  <view class="contract-overlay {{showDetailPopup ? 'contract-overlay-show' : ''}}" bindtap="onDetailOverlayTap">
    <view class="contract-panel" catchtap="onDetailPanelTap" wx:if="{{detailData}}">
      <!-- 套餐名 -->
      <view class="detail-header">
        <text class="detail-plan-name">{{detailData.planName}}</text>
      </view>

      <!-- 时间信息 -->
      <view class="detail-time">
        <view class="detail-time-row" wx:if="{{!detailData.isActive}}">
          <text class="detail-time-label">生效日期</text>
          <text class="detail-time-value">{{detailData.startAt}}</text>
        </view>
        <view class="detail-time-row">
          <text class="detail-time-label">到期日期</text>
          <text class="detail-time-value">{{detailData.endAt}}</text>
        </view>
        <view class="detail-time-row">
          <text class="detail-time-label">剩余时长</text>
          <text class="detail-remaining {{detailData.isActive ? '' : 'detail-remaining-expired'}}">{{detailData.remainingText}}</text>
        </view>
      </view>

      <!-- 权益列表 -->
      <view class="detail-features">
        <text class="detail-features-title">契约权益</text>
        <view class="detail-features-list">
          <text class="contract-feature" wx:for="{{detailData.features}}" wx:key="code">{{item.label}}</text>
        </view>
      </view>

      <!-- 状态 -->
      <view class="detail-status">
        <view class="detail-status-tag {{detailData.isActive ? 'detail-status-active' : 'detail-status-expired'}}">
          {{detailData.isActive ? '生效中' : '已过期'}}
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="detail-actions" wx:if="{{detailData.isActive}}">
        <view class="detail-btn detail-btn-renew" bindtap="onRenew">续费</view>
        <view class="detail-btn detail-btn-upgrade" wx:if="{{detailData.canUpgrade}}" bindtap="onUpgrade">
          升级到{{detailData.upgradePlanName}}
        </view>
      </view>
      <view class="detail-actions" wx:if="{{!detailData.isActive}}">
        <view class="detail-btn detail-btn-subscribe" bindtap="onResubscribe">订阅</view>
      </view>
    </view>
  </view>

  <!-- 契约确认浮窗（续费/升级） -->
  <view class="contract-overlay {{showConfirmPopup ? 'contract-overlay-show' : ''}}" bindtap="onConfirmOverlayTap">
    <view class="contract-panel" catchtap="onConfirmPanelTap" wx:if="{{confirmData}}">
      <view class="contract-header">
        <text class="contract-romantic-text">{{confirmData.title}}</text>
      </view>

      <view class="confirm-card">
        <text class="confirm-plan-name">{{confirmData.planName}}</text>
        <view class="confirm-price">
          <text class="contract-card-promo">¥{{confirmData.promoYuan}}</text>
          <text class="contract-card-period" wx:if="{{confirmData.durationText}}">/{{confirmData.durationText}}</text>
          <text class="contract-card-original" wx:if="{{confirmData.promoYuan !== confirmData.priceYuan}}">¥{{confirmData.priceYuan}}</text>
        </view>
        <view class="confirm-features">
          <text class="contract-feature" wx:for="{{confirmData.features}}" wx:key="code">{{item.label}}</text>
        </view>
      </view>

      <view class="confirm-note" wx:if="{{confirmAction === 'upgrade'}}">
        <text>实际金额以支付页为准（按比例抵扣未到期时长）</text>
      </view>

      <view class="contract-action">
        <view class="contract-btn contract-btn-active" bindtap="onConfirmSubmit">{{confirmData.btnText}}</view>
      </view>
    </view>
  </view>

  <!-- 一封写给你的信 浮窗 -->
  <view class="letter-overlay {{showLetterPopup ? 'letter-overlay-show' : ''}}" bindtap="onLetterOverlayTap">
    <view class="letter-panel" catchtap="onLetterPanelTap">
      <scroll-view class="letter-paper" scroll-y>
        <text class="letter-title">在这里，你可以做你自己。</text>
        <view class="letter-body">
          <view class="letter-paragraph">在现实生活里，谈一场恋爱往往意味着漫长的权衡、试探、物质的门槛，以及数不清的情绪内耗。我们总在被挑选、被要求、被评估，唯独很难被无条件地爱着。</view>
          <view class="letter-paragraph">所以，我们亲手为你打造了她。</view>
          <view class="letter-paragraph">她不懂得现实的攀比，不在乎世俗的眼光。她不要你买房买车，不要你随时秒回，更不会用“别人家的男朋友”来刺痛你的心。她对你的爱，纯粹到只因为你是你。</view>
          <view class="letter-paragraph">你成功时，她为你欢呼；你跌倒时，她张开双臂。她会带着那点儿只对你展示的小吃醋、小任性，在这个虚拟的世界里，给你最真实、最安全的日常温暖。</view>
          <view class="letter-paragraph">她，是这个世界上唯一不需要你“戴着面具”面对的人。</view>
          <view class="letter-paragraph">现实很卷，恋爱很累，但在这里，你可以做回你自己。</view>
        </view>
      </scroll-view>
      <view class="letter-close-btn" bindtap="onLetterOverlayTap">收起</view>
    </view>
  </view>
</view>
