/* pages/settings/settings.wxss */
/* Ethereal Companion Design System - 完美女友主题 */

/* ===== Base ===== */
.settings-container {
  min-height: 100vh;
  background: #f6f3f2;
  padding: 40rpx 32rpx 60rpx;
}

/* ===== Header ===== */
.settings-header {
  padding: 20rpx 8rpx 48rpx;
}

.settings-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1b1c1c;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

/* ===== 羁绊面板 ===== */
.bond-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(134, 78, 90, 0.08),
    0 0 20rpx rgba(255, 183, 193, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
}

/* --- 头像区域 --- */
.bond-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.bond-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bond-avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.bond-avatar-btn::after {
  border: none;
}

.bond-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(134, 78, 90, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.15);
}

.bond-avatar-label {
  font-size: 24rpx;
  color: #514345;
  letter-spacing: 0.5rpx;
}

/* --- 命运红线 --- */
.bond-thread {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}

.bond-thread-line {
  width: 100%;
  height: 2rpx;
  position: relative;
}

/* 免费 - 灰色暗淡 */
.thread-free {
  background: linear-gradient(
    90deg,
    rgba(160, 154, 156, 0) 0%,
    rgba(160, 154, 156, 0.25) 30%,
    rgba(160, 154, 156, 0.4) 50%,
    rgba(160, 154, 156, 0.25) 70%,
    rgba(160, 154, 156, 0) 100%
  );
}

.thread-free::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(160, 154, 156, 0.3);
}

/* Silver - 红色亮起 */
.thread-silver {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.4) 30%,
    rgba(212, 115, 122, 0.6) 50%,
    rgba(212, 115, 122, 0.4) 70%,
    rgba(212, 115, 122, 0) 100%
  );
}

.thread-silver::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(212, 115, 122, 0.5);
  box-shadow: 0 0 12rpx rgba(212, 115, 122, 0.3);
}

/* Gold - 高亮发光 */
.thread-gold {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.6) 25%,
    rgba(212, 115, 122, 0.85) 50%,
    rgba(212, 115, 122, 0.6) 75%,
    rgba(212, 115, 122, 0) 100%
  );
  height: 3rpx;
}

.thread-gold::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(212, 115, 122, 0.6);
  box-shadow: 0 0 16rpx rgba(212, 115, 122, 0.5);
}

/* Gold 头像呼吸光效 */
@keyframes avatar-breathe {
  0%, 100% {
    border-color: rgba(184, 134, 11, 0.35);
    box-shadow: 0 4rpx 16rpx rgba(184, 134, 11, 0.15);
  }
  50% {
    border-color: rgba(184, 134, 11, 0.7);
    box-shadow: 0 4rpx 28rpx rgba(184, 134, 11, 0.4), 0 0 12rpx rgba(184, 134, 11, 0.2);
  }
}

.avatar-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
}

/* --- 身份标签 --- */
.bond-identity {
  display: flex;
  justify-content: center;
  margin-bottom: 0rpx;
}

.bond-identity-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 8rpx 32rpx;
  border-radius: 20rpx;
}

.bond-free {
  color: #514345;
  background: rgba(134, 78, 90, 0.08);
}

.bond-silver {
  color: #7a6f8a;
  background: rgba(122, 111, 138, 0.1);
}

.bond-gold {
  color: #b8860b;
  background: rgba(184, 134, 11, 0.1);
}

/* --- 状态 pill --- */
.bond-status-row {
  display: flex;
  gap: 16rpx;
  justify-content: center;
  margin-top: 0rpx;
  flex-wrap: wrap;
}

.bond-status-pill {
  padding: 10rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

.bond-status-menstrual {
  background: rgba(134, 78, 90, 0.1);
  color: #864e5a;
}

.bond-status-mood {
  background: rgba(134, 78, 90, 0.08);
  color: #864e5a;
}

/* --- 关系等级 --- */
.bond-level {
  margin-top: 32rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(134, 78, 90, 0.06);
  border: 1rpx solid rgba(134, 78, 90, 0.1);
}

.bond-level-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.bond-level-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #864e5a;
}

.bond-level-streak {
  font-size: 22rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

.bond-level-track {
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(134, 78, 90, 0.12);
  overflow: hidden;
}

.bond-level-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #d4737a, #864e5a);
  box-shadow: 0 0 8rpx rgba(212, 115, 122, 0.4);
  transition: width 0.4s ease;
}

.bond-level-foot {
  margin-top: 14rpx;
  display: flex;
  justify-content: center;
}

.bond-level-hint {
  font-size: 22rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

.bond-level-foot-done {
  opacity: 0.7;
}

/* --- 功能入口（并列卡片） --- */
.entry-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.entry-card {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.06);
  padding: 32rpx 20rpx 28rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.entry-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(134, 78, 90, 0.1);
}

.entry-icon-area {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon-contract {
  background: linear-gradient(135deg, rgba(134, 78, 90, 0.12), rgba(134, 78, 90, 0.04));
  position: relative;
}

.entry-icon-contract::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #864e5a;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-contract::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid #864e5a;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-backpack {
  background: linear-gradient(135deg, rgba(184, 134, 11, 0.12), rgba(184, 134, 11, 0.04));
  position: relative;
}

.entry-icon-backpack::before {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 3rpx solid #b8860b;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-backpack::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #b8860b;
  top: calc(50% - 14rpx);
  left: 50%;
  transform: translateX(-50%);
}

.entry-title {
  font-size: 28rpx;
  color: #1b1c1c;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #8a7a7e;
}

/* ===== Settings List (Glassmorphic Card) ===== */
.settings-list {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(134, 78, 90, 0.08),
    0 0 20rpx rgba(255, 183, 193, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* ===== Settings Item ===== */
.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.06);
  transition: background 0.2s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: rgba(134, 78, 90, 0.04);
}

/* ===== Item Left ===== */
.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.item-label {
  font-size: 32rpx;
  color: #1b1c1c;
  font-weight: 500;
  line-height: 1.4;
}

/* ===== Item Right ===== */
.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: flex-end;
}

.item-value {
  font-size: 28rpx;
  color: #514345;
  text-align: right;
}

/* ===== Switch Component ===== */
switch {
  transform: scale(0.9);
}

/* ===== Footer ===== */
.settings-footer {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.5);
  letter-spacing: 0.5rpx;
}

/* ===== 一封写给你的信 浮窗 ===== */
.letter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.letter-overlay-show {
  opacity: 1;
  visibility: visible;
}

.letter-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fbf9f8;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.letter-overlay-show .letter-panel {
  transform: translateY(0);
}

/* 信纸：固定高度保证 scroll-view 可滚动；暖色纸面 */
.letter-paper {
  box-sizing: border-box;
  height: 70vh;
  padding: 32rpx 50rpx 48rpx;
  background-color: #fbf6f2;
  background-image: linear-gradient(180deg, #fdf8f4, #f7efe9);
}

/* 信件标题 */
.letter-title {
  display: block;
  text-align: center;
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  font-size: 38rpx;
  font-weight: 600;
  color: #864e5a;
  line-height: 1.55;
  letter-spacing: 1rpx;
  margin-bottom: 36rpx;
}

.letter-paragraph {
  font-family: "Songti SC", "STSong", "Noto Serif CJK SC", serif;
  font-size: 30rpx;
  color: #4a3f42;
  line-height: 56rpx;
  letter-spacing: 0.5rpx;
  text-align: justify;
  margin-bottom: 15rpx;
}

.letter-close-btn {
  flex-shrink: 0;
  margin: 24rpx 40rpx;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.3);
}

.letter-close-btn:active {
  opacity: 0.85;
}

/* ===== 关系升级庆祝浮层 ===== */
.levelup-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 120;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.levelup-overlay-show {
  opacity: 1;
  visibility: visible;
}

.levelup-panel {
  width: 76%;
  padding: 56rpx 40rpx 40rpx;
  border-radius: 32rpx;
  background: rgba(251, 249, 248, 0.96);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 48rpx rgba(134, 78, 90, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: scale(0.85);
  opacity: 0;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
}

.levelup-overlay-show .levelup-panel {
  transform: scale(1);
  opacity: 1;
}

/* 光环 + 徽章 */
.levelup-halo {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.levelup-ring {
  position: absolute;
  top: 50%;
  left: 50%;
  border-radius: 50%;
  border: 2rpx solid rgba(212, 115, 122, 0.5);
  transform: translate(-50%, -50%);
}

.levelup-ring-1 {
  width: 120rpx;
  height: 120rpx;
  border-color: rgba(212, 115, 122, 0.7);
  animation: levelup-pulse 1.8s ease-out infinite;
}

.levelup-ring-2 {
  width: 160rpx;
  height: 160rpx;
  border-color: rgba(212, 115, 122, 0.4);
  animation: levelup-pulse 1.8s ease-out infinite 0.3s;
}

.levelup-ring-3 {
  width: 200rpx;
  height: 200rpx;
  border-color: rgba(212, 115, 122, 0.25);
  animation: levelup-pulse 1.8s ease-out infinite 0.6s;
}

@keyframes levelup-pulse {
  0% { transform: translate(-50%, -50%) scale(0.7); opacity: 0; }
  40% { opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1.15); opacity: 0; }
}

.levelup-emblem {
  position: relative;
  z-index: 1;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #d4737a, #864e5a);
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.4), 0 0 16rpx rgba(212, 115, 122, 0.5);
}

.levelup-title {
  font-size: 28rpx;
  color: #8a7a7e;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
}

.levelup-level {
  font-size: 44rpx;
  font-weight: 700;
  color: #864e5a;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.levelup-desc {
  font-size: 26rpx;
  color: #514345;
  letter-spacing: 0.5rpx;
  margin-bottom: 40rpx;
}

.levelup-close-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.3);
}

.levelup-close-btn:active {
  opacity: 0.85;
}

/* ================================================================
   DARK MODE
   ================================================================ */

.settings-container.dark {
  background: #121220;
}

.dark .settings-title {
  color: #e8e4e3;
}

/* 羁绊面板 - 深色模式 */
.dark .bond-card {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.dark .bond-avatar {
  border-color: rgba(196, 155, 165, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  background: rgba(134, 78, 90, 0.12);
}

.dark .bond-avatar-label {
  color: #a09a9c;
}

.dark .thread-free {
  background: linear-gradient(
    90deg,
    rgba(106, 100, 104, 0) 0%,
    rgba(106, 100, 104, 0.2) 30%,
    rgba(106, 100, 104, 0.3) 50%,
    rgba(106, 100, 104, 0.2) 70%,
    rgba(106, 100, 104, 0) 100%
  );
}

.dark .thread-free::after {
  background: rgba(106, 100, 104, 0.25);
  box-shadow: none;
}

.dark .thread-silver {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.25) 30%,
    rgba(212, 115, 122, 0.4) 50%,
    rgba(212, 115, 122, 0.25) 70%,
    rgba(212, 115, 122, 0) 100%
  );
}

.dark .thread-silver::after {
  background: rgba(212, 115, 122, 0.35);
  box-shadow: 0 0 12rpx rgba(212, 115, 122, 0.15);
}

.dark .thread-gold {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.4) 25%,
    rgba(212, 115, 122, 0.6) 50%,
    rgba(212, 115, 122, 0.4) 75%,
    rgba(212, 115, 122, 0) 100%
  );
}

.dark .thread-gold::after {
  background: rgba(212, 115, 122, 0.45);
  box-shadow: 0 0 16rpx rgba(212, 115, 122, 0.3);
}

@keyframes avatar-breathe-dark {
  0%, 100% {
    border-color: rgba(218, 165, 32, 0.25);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  }
  50% {
    border-color: rgba(218, 165, 32, 0.6);
    box-shadow: 0 4rpx 28rpx rgba(218, 165, 32, 0.3), 0 0 12rpx rgba(218, 165, 32, 0.15);
  }
}

.dark .avatar-glow {
  animation: avatar-breathe-dark 2.5s ease-in-out infinite;
}

.dark .bond-free {
  color: #a09a9c;
  background: rgba(134, 78, 90, 0.15);
}

.dark .bond-silver {
  color: #b8adc8;
  background: rgba(122, 111, 138, 0.15);
}

.dark .bond-gold {
  color: #daa520;
  background: rgba(184, 134, 11, 0.15);
}

.dark .bond-status-menstrual {
  background: rgba(212, 115, 122, 0.15);
  color: #d4a0a6;
}

.dark .bond-status-mood {
  background: rgba(212, 115, 122, 0.12);
  color: #d4a0a6;
}

/* 关系等级 - 深色模式 */
.dark .bond-level {
  background: rgba(134, 78, 90, 0.12);
  border-color: rgba(134, 78, 90, 0.18);
}

.dark .bond-level-name {
  color: #d4a0a6;
}

.dark .bond-level-streak {
  color: #6a6468;
}

.dark .bond-level-track {
  background: rgba(134, 78, 90, 0.18);
}

.dark .bond-level-hint {
  color: #6a6468;
}

.dark .entry-card {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dark .entry-card:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

.dark .entry-icon-contract {
  background: linear-gradient(135deg, rgba(196, 155, 165, 0.15), rgba(196, 155, 165, 0.05));
}

.dark .entry-icon-contract::before {
  background: #c49ba5;
}

.dark .entry-icon-contract::after {
  border-color: #c49ba5;
}

.dark .entry-icon-backpack {
  background: linear-gradient(135deg, rgba(184, 134, 11, 0.15), rgba(184, 134, 11, 0.05));
}

.dark .entry-icon-backpack::before {
  border-color: #daa520;
}

.dark .entry-icon-backpack::after {
