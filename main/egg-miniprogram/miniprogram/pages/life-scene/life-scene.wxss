/* 全面屏安全区与动效生命周期降级 */
.scene-title { bottom: calc(152rpx + env(safe-area-inset-bottom)); }
.bubble { bottom: calc(52rpx + env(safe-area-inset-bottom)); }
.scene-enter-gradient { z-index: 7; animation-duration: 700ms; }
.page--paused .grass-shimmer,
.page--paused .firefly,
.page--paused .ambient-piece { animation-play-state: paused !important; }

@media (prefers-reduced-motion: reduce) {
  .grass-shimmer,
  .firefly,
  .ambient-piece { display: none; }
  .scene-bg { animation: none; transform: none; }
  .scene-enter-gradient { animation: none; opacity: 0; visibility: hidden; }
  .ripple,
  .flower-effect,
  .butterfly-effect,
  .scene-effect { display: none; }
}
