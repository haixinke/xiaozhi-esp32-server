<!--pages/agent-select/agent-select.wxml-->
<view class="container">
  <!-- 标题区 -->
  <view class="header">
    <text class="title">选择智能体</text>
    <text class="subtitle">绑定后即可开始语音对话</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Agent 列表 -->
  <scroll-view class="agent-list" scroll-y="true" wx:if="{{!loading}}">
    <block wx:if="{{agents.length === 0}}">
      <view class="empty-state">
        <text class="empty-text">暂无可用智能体</text>
        <view class="btn btn-secondary retry-btn" bindtap="loadAgents">
          <text>重新加载</text>
        </view>
      </view>
    </block>

    <block wx:for="{{agents}}" wx:key="id">
      <view 
        class="agent-card card {{bindingId === item.id ? 'binding' : ''}}"
        bindtap="onSelectAgent"
        data-agent="{{item}}"
      >
        <view class="agent-info">
          <view class="agent-avatar">
            <text class="avatar-text">{{item.name[0] || 'A'}}</text>
          </view>
          <view class="agent-detail">
            <text class="agent-name">{{item.name}}</text>
            <text class="agent-desc">{{item.description || '智能语音助手'}}</text>
          </view>
        </view>
        <view class="agent-action">
          <text class="bind-text" wx:if="{{bindingId !== item.id}}">绑定</text>
          <text class="binding-text" wx:else>绑定中...</text>
        </view>
      </view>
    </block>
  </scroll-view>
</view>
