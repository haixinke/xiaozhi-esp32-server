.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; min-height: 0; padding: 38rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

.intro { padding: 34rpx; border-radius: 32rpx; background: #002900; color: #FFFFFF; }
.title { display: block; font-size: 36rpx; font-weight: 600; }
.desc { display: block; margin-top: 16rpx; font-size: 24rpx; line-height: 1.7; color: #CFD9C0; }

.code-card { margin-top: 28rpx; padding: 34rpx 32rpx; border-radius: 32rpx; background: #FFFFFF; border: 1rpx solid #E5E3DF; }
.code-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx; }
.state-label { font-size: 24rpx; color: #5C5C5C; }
.state-label--available { color: #54632C; }
.usage { font-size: 24rpx; color: #5C5C5C; }

.qr-image { display: block; width: 360rpx; max-width: 100%; height: 360rpx; margin: 24rpx auto 0; }
.qr-error { display: flex; flex-direction: column; align-items: center; padding: 36rpx 0 12rpx; }
.state { display: flex; flex-direction: column; align-items: center; justify-content: center; margin-top: 28rpx; padding: 70rpx 30rpx; border-radius: 32rpx; background: #FFFFFF; }
.state-text, .state-error { font-size: 26rpx; text-align: center; }
.state-text { color: #5C5C5C; }
.state-error { color: #C33F36; }
.retry, .qr-save { min-width: 200rpx; height: 68rpx; line-height: 68rpx; margin-top: 28rpx; padding: 0 28rpx; border-radius: 999rpx; background: #F5F8ED; color: #54632C; font-size: 24rpx; }
.retry::after, .qr-save::after { border: none; }
.qr-save[disabled] { opacity: 0.5; }
