<!--pages/index/index.wxml-->
<view class="page">
  <!-- 背景层：网格 + 光晕 -->
  <view class="bg-grid"></view>
  <view class="bg-aurora bg-aurora-1"></view>
  <view class="bg-aurora bg-aurora-2"></view>

  <!-- 顶部状态栏 -->
  <view class="top-bar">
    <view class="status-cluster" bindtap="onTapStatus">
      <view class="status-ring state-{{connectionState}}">
        <view class="status-dot"></view>
      </view>
      <view class="status-meta">
        <text class="status-label">
          <block wx:if="{{connectionState === 'connected'}}">CHANNEL · LIVE</block>
          <block wx:elif="{{connectionState === 'connecting'}}">HANDSHAKE</block>
          <block wx:else>OFFLINE · 点击重连</block>
        </text>
        <text class="status-session" wx:if="{{sessionId}}">{{sessionId}}</text>
      </view>
    </view>

    <view class="agent-cluster">
      <view class="agent-name">
        <text class="agent-prefix">@</text>
        <text class="agent-text">{{agentName || '小智助手'}}</text>
      </view>
      <view class="switch-btn" bindtap="onSwitchAgent" hover-class="switch-btn-hover" hover-stay-time="80">
        <text>切换</text>
      </view>
    </view>
  </view>

  <!-- 启动占位 -->
  <view wx:if="{{booting}}" class="boot-shell">
    <view class="boot-orbit">
      <view class="boot-dot"></view>
    </view>
    <text class="boot-text">正在唤醒小智…</text>
  </view>

  <!-- 消息区 -->
  <scroll-view
    wx:if="{{!booting}}"
    class="conversation"
    scroll-y="true"
    scroll-with-animation="true"
    enhanced="true"
    show-scrollbar="false"
    scroll-into-view="{{scrollToView}}"
  >
    <view class="conversation-inner">
      <!-- 空状态：欢迎卡片 -->
      <block wx:if="{{messages.length === 0 && !currentReply}}">
        <view class="welcome">
          <view class="welcome-eyebrow">
            <view class="welcome-line"></view>
            <text>NEURAL · 24kHz · OPUS</text>
            <view class="welcome-line"></view>
          </view>
          <view class="welcome-title">
            <text class="welcome-hi">Hi，我是</text>
            <text class="welcome-name">{{agentName || '小智'}}</text>
            <text class="welcome-dot">.</text>
          </view>
          <text class="welcome-sub">在下方输入框输入文字与小智助手对话。</text>

          <view class="welcome-grid">
            <view class="welcome-card">
              <view class="welcome-card-tag">01</view>
              <text class="welcome-card-text">帮我写一篇产品介绍</text>
            </view>
            <view class="welcome-card">
              <view class="welcome-card-tag">02</view>
              <text class="welcome-card-text">解释什么是人工智能</text>
            </view>
            <view class="welcome-card">
              <view class="welcome-card-tag">03</view>
              <text class="welcome-card-text">给我推荐几本好书</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 历史消息 -->
      <block wx:for="{{messages}}" wx:key="id">
        <view id="{{item.id}}">
          <chat-bubble role="{{item.role}}" content="{{item.content}}" label="{{agentName || 'XIAOZHI'}}" />
        </view>
      </block>

      <!-- 流式回复 -->
      <view wx:if="{{currentReply}}" id="streaming">
        <chat-bubble role="assistant" content="{{currentReply}}" typing="{{true}}" label="{{agentName || 'XIAOZHI'}}" />
      </view>
    </view>
  </scroll-view>

  <!-- 底部输入栏 -->
  <view wx:if="{{!booting}}" class="input-bar safe-area-bottom">
    <view class="input-bar-inner">
      <!-- 输入框容器 -->
      <view class="input-wrapper">
        <input
          class="message-input"
          type="text"
          placeholder="输入消息..."
          placeholder-style="color: rgba(148, 163, 184, 0.5);"
          value="{{inputText}}"
          bindinput="onTextInput"
          bindconfirm="onTextSend"
          confirm-type="send"
          maxlength="500"
          disabled="{{connectionState !== 'connected' || chatState === 'thinking'}}"
          adjust-position="{{true}}"
        />
      </view>

      <!-- 发送按钮 -->
      <view
        class="send-btn {{inputText.trim() ? 'active' : ''}}"
        bindtap="onTextSend"
        hover-class="send-btn-hover"
        hover-stay-time="80"
      >
        <text class="send-btn-text">发送</text>
      </view>
    </view>
  </view>
</view>
