/* components/chat-bubble/chat-bubble.wxss */

.cb-row {
  display: flex;
  flex-direction: column;
  margin: 0 0 32rpx;
  max-width: 100%;
  animation: cb-enter 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes cb-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.cb-row.cb-user {
  align-items: flex-end;
}
.cb-row.cb-assistant {
  align-items: flex-start;
}

/* ----- 角色标签 ----- */
.cb-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 18rpx;
  margin-bottom: 8rpx;
}

.cb-tag {
  font-size: 18rpx;
  letter-spacing: 4rpx;
  font-weight: 600;
  font-family: 'SF Mono', 'Menlo', Consolas, monospace;
  color: rgba(148, 163, 184, 0.6);
}

.cb-row.cb-user .cb-tag {
  color: rgba(96, 165, 250, 0.85);
}
.cb-row.cb-assistant .cb-tag {
  color: rgba(94, 234, 212, 0.85);
}

.cb-pin {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.5;
}

.cb-row.cb-user .cb-pin {
  background: rgba(96, 165, 250, 0.7);
  box-shadow: 0 0 8rpx rgba(96, 165, 250, 0.6);
}
.cb-row.cb-assistant .cb-pin {
  background: rgba(94, 234, 212, 0.7);
  box-shadow: 0 0 8rpx rgba(94, 234, 212, 0.6);
}

.cb-row.cb-user .cb-meta {
  flex-direction: row-reverse;
}

/* ----- 气泡 ----- */
.cb-bubble {
  position: relative;
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 22rpx;
  overflow: hidden;
  isolation: isolate;
}

.cb-row.cb-user .cb-bubble {
  border-top-right-radius: 6rpx;
  background:
    linear-gradient(135deg, #2563eb 0%, #1d4ed8 60%, #1e3a8a 100%);
  border: 1rpx solid rgba(96, 165, 250, 0.45);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08),
    inset 0 -8rpx 18rpx rgba(0, 0, 0, 0.25),
    0 8rpx 24rpx rgba(37, 99, 235, 0.25);
}

.cb-row.cb-assistant .cb-bubble {
  border-top-left-radius: 6rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(94, 234, 212, 0.08), transparent 60%),
    linear-gradient(155deg, #1e293b 0%, #131a2e 100%);
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.04),
    0 8rpx 24rpx rgba(0, 0, 0, 0.35);
}

/* assistant 左侧的指示线 */
.cb-row.cb-assistant .cb-bubble::before {
  content: '';
  position: absolute;
  left: 0;
  top: 14rpx;
  bottom: 14rpx;
  width: 3rpx;
  background: linear-gradient(180deg, #5eead4, transparent);
  opacity: 0.7;
}

/* 流式时的边光 */
.cb-glow {
  position: absolute;
  inset: -1rpx;
  border-radius: inherit;
  pointer-events: none;
  opacity: 0;
  background: linear-gradient(120deg,
    transparent 30%,
    rgba(94, 234, 212, 0.35) 50%,
    transparent 70%);
  background-size: 200% 100%;
  z-index: -1;
}

.cb-typing .cb-glow {
  opacity: 1;
  animation: cb-shimmer 2.4s linear infinite;
}

@keyframes cb-shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -100% 0; }
}

/* ----- 文本 ----- */
.cb-content {
  position: relative;
  display: block;
  word-break: break-word;
}

.cb-text {
  font-size: 30rpx;
  line-height: 1.65;
  color: #f1f5f9;
  letter-spacing: 0.5rpx;
}

.cb-row.cb-user .cb-text {
  color: #ffffff;
  font-weight: 500;
}

.cb-cursor {
  display: inline-block;
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 1;
  color: #5eead4;
  animation: cb-blink 1s steps(2, start) infinite;
  text-shadow: 0 0 12rpx rgba(94, 234, 212, 0.6);
}

@keyframes cb-blink {
  0%, 50%   { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}
