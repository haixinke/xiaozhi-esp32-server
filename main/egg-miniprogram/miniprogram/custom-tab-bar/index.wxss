.tab-bar {
  position: fixed;
  z-index: 71;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 34rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
}
.tab-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(225,226,211,.9);
  border-radius: 50%;
  background: #FFF;
  box-shadow: 0 8rpx 24rpx rgba(43,55,39,.12), inset 0 1rpx 0 rgba(255,255,255,.72);
  pointer-events: auto;
  transition: transform .16s ease, background .16s ease;
}
.tab-item--pressed { background: #F7F7F4; opacity: .9; transform: scale(.98); }
.tab-icon { width: 62rpx; height: 62rpx; display: block; }
.toolbox-icon { width: 84rpx; height: 84rpx; display: block; }
.toolbox-dismiss { position: fixed; z-index: 70; inset: 0; background: transparent; }
.toolbox-panel {
  position: absolute;
  right: 34rpx;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  width: 320rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E3DF;
  border-radius: 28rpx;
  background: #FFFDF7;
  box-shadow: 0 12rpx 36rpx rgba(32,28,23,.2);
  pointer-events: auto;
  transform-origin: 100% 100%;
  animation: toolbox-open .28s ease-out both;
}
.toolbox-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 28rpx; }
.toolbox-item { display: flex; flex-direction: column; align-items: center; gap: 10rpx; min-height: 112rpx; font-size: 24rpx; color: #35483C; }
.toolbox-item image { width: 88rpx; height: 88rpx; }
@keyframes toolbox-open { from { opacity: 0; transform: scale(.88); } to { opacity: 1; transform: scale(1); } }
@media (prefers-reduced-motion: reduce) { .toolbox-panel { animation: none; } }
