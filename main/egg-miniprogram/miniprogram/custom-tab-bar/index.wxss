.tab-bar {
  position: fixed;
  z-index: 70;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(136rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 0 34rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  background: transparent;
}
.tab-item {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  flex: 0 0 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1rpx solid rgba(225,226,211,.9);
  border-radius: 50%;
  background: #FFF;
  box-shadow: 0 8rpx 24rpx rgba(43,55,39,.12), inset 0 1rpx 0 rgba(255,255,255,.72);
  pointer-events: auto;
  transition: transform .16s ease, background .16s ease;
}
.tab-item--pressed { background: #F7F7F4; opacity: .9; transform: scale(.98); }
.tab-icon { width: 62rpx; height: 62rpx; display: block; }
