/* 自定义组件宿主节点默认不带 display/width，必须显式声明，
   否则在 flex 居中容器里宿主会塌陷成内容宽度，胶囊只剩文字那么宽
   （首页空态「添加蛋宝宝」按钮溢出就是这个原因）。 */
:host {
  display: block;
  width: 100%;
}

.btn {
  width: 100%;
  height: 100rpx; /* 50px */
  border-radius: 999rpx; /* --radius-full */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: transform 0.18s ease-out;
}

.btn--pressed {
  transform: scale(0.98);
}

.btn-text {
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 30rpx; /* 15px */
  font-weight: 600;
}

.btn--primary {
  background: #002900; /* --ink */
}
.btn--primary .btn-text {
  color: #FFFFFF;
}

.btn--secondary {
  background: transparent;
  border: 3rpx solid #002900; /* --ink */
}
.btn--secondary .btn-text {
  color: #002900; /* --ink */
}

.btn--danger {
  background: #D9463C; /* --error */
}
.btn--danger .btn-text {
  color: #FFFFFF;
}

.btn--disabled {
  opacity: 0.4;
}
