/* pages/soul-resonance/soul-resonance.wxss */
/* Ethereal Companion Design System - 灵魂共振 */

page {
  background-color: #fbf9f8;
  color: #1b1c1c;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fbf9f8;
  background-image:
    radial-gradient(at 0% 0%, rgba(255, 183, 197, 0.2) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(211, 198, 218, 0.2) 0px, transparent 50%);
}

/* -------- 自定义导航栏 -------- */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.08);
}

.nav-bar-inner {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #864e5a;
  letter-spacing: 2rpx;
}

/* -------- 角色照片区（在 scroll-view 外） -------- */
.char-section {
  flex-shrink: 0;
  padding: calc(var(--status-bar-height, 44px) + 88rpx + 24rpx) 40rpx 0;
}

/* -------- 滚动内容区 -------- */
.scroll-content {
  flex: 1;
  overflow: hidden;
}

.char-card-static {
  width: 100%;
  height: 600rpx;
  border-radius: 32rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 8rpx 60rpx rgba(255, 183, 197, 0.35);
  margin-bottom: 20rpx;
}

.char-image {
  width: 100%;
  height: 100%;
}

.char-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 36rpx 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.35) 0%, transparent 100%);
  text-align: center;
}

.char-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.2);
}

/* -------- 通用 section -------- */
.section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 36rpx;
  background: #ffb7c5;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1c;
  line-height: 1.3;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.6);
  margin-bottom: 28rpx;
  padding-left: 22rpx;
  line-height: 1.5;
}

/* -------- 灵魂特质网格 -------- */
.trait-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.trait-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.25s ease;
  user-select: none;
}

.trait-item-hover {
  transform: scale(0.95);
}

.trait-item-active {
  background: rgba(255, 183, 197, 0.25);
  border-color: #864e5a;
  box-shadow: 0 0 20rpx rgba(255, 183, 197, 0.3);
}

.trait-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1b1c1c;
  text-align: center;
  line-height: 1.3;
}

.trait-item-active .trait-label {
  color: #864e5a;
  font-weight: 600;
}

/* -------- 小任性网格 -------- */
.quirk-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.quirk-item {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 8rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.6);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: all 0.25s ease;
  user-select: none;
}

.quirk-item-hover {
  transform: scale(0.95);
}

.quirk-item-active {
  background: rgba(255, 183, 197, 0.25);
  border-color: #864e5a;
  box-shadow: 0 0 20rpx rgba(255, 183, 197, 0.3);
}

.quirk-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #1b1c1c;
  text-align: center;
  line-height: 1.3;
}

.quirk-item-active .quirk-label {
  color: #864e5a;
  font-weight: 600;
}

/* -------- CTA 按钮 -------- */
.cta-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 40rpx 24rpx;
  background: rgba(251, 249, 248, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 100;
}

.cta-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 100rpx;
  background: linear-gradient(135deg, #ffb7c5 0%, #ff9aa2 100%);
  text-align: center;
  box-shadow: 0 8rpx 40rpx rgba(255, 183, 197, 0.35);
  animation: softPulse 3s infinite ease-in-out;
  user-select: none;
}

.cta-btn-hover {
  transform: scale(0.97);
  opacity: 0.9;
}

.cta-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #360c19;
  letter-spacing: 2rpx;
}

@keyframes softPulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.01); opacity: 0.95; }
}

/* -------- 安全区 -------- */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom, 24rpx);
}
