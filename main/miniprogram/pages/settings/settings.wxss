/* pages/settings/settings.wxss */
/* Ethereal Companion Design System - 完美女友主题 */

/* ===== Base ===== */
.settings-container {
  min-height: 100vh;
  background: #f6f3f2;
  padding: 40rpx 32rpx 60rpx;
}

/* ===== Header ===== */
.settings-header {
  padding: 20rpx 8rpx 48rpx;
}

.settings-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1b1c1c;
  line-height: 1.2;
  letter-spacing: 1rpx;
}

/* ===== 羁绊面板 ===== */
.bond-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(134, 78, 90, 0.08),
    0 0 20rpx rgba(255, 183, 193, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 40rpx 32rpx;
}

/* --- 头像区域 --- */
.bond-avatars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.bond-avatar-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bond-avatar-btn {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  line-height: normal;
}

.bond-avatar-btn::after {
  border: none;
}

.bond-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(134, 78, 90, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.15);
}

.bond-avatar-label {
  font-size: 24rpx;
  color: #514345;
  letter-spacing: 0.5rpx;
}

/* --- 命运红线 --- */
.bond-thread {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
}

.bond-thread-line {
  width: 100%;
  height: 2rpx;
  position: relative;
}

/* 免费 - 灰色暗淡 */
.thread-free {
  background: linear-gradient(
    90deg,
    rgba(160, 154, 156, 0) 0%,
    rgba(160, 154, 156, 0.25) 30%,
    rgba(160, 154, 156, 0.4) 50%,
    rgba(160, 154, 156, 0.25) 70%,
    rgba(160, 154, 156, 0) 100%
  );
}

.thread-free::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(160, 154, 156, 0.3);
}

/* Silver - 红色亮起 */
.thread-silver {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.4) 30%,
    rgba(212, 115, 122, 0.6) 50%,
    rgba(212, 115, 122, 0.4) 70%,
    rgba(212, 115, 122, 0) 100%
  );
}

.thread-silver::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: rgba(212, 115, 122, 0.5);
  box-shadow: 0 0 12rpx rgba(212, 115, 122, 0.3);
}

/* Gold - 高亮发光 */
.thread-gold {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.6) 25%,
    rgba(212, 115, 122, 0.85) 50%,
    rgba(212, 115, 122, 0.6) 75%,
    rgba(212, 115, 122, 0) 100%
  );
  height: 3rpx;
}

.thread-gold::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(212, 115, 122, 0.6);
  box-shadow: 0 0 16rpx rgba(212, 115, 122, 0.5);
}

/* Gold 头像呼吸光效 */
@keyframes avatar-breathe {
  0%, 100% {
    border-color: rgba(184, 134, 11, 0.35);
    box-shadow: 0 4rpx 16rpx rgba(184, 134, 11, 0.15);
  }
  50% {
    border-color: rgba(184, 134, 11, 0.7);
    box-shadow: 0 4rpx 28rpx rgba(184, 134, 11, 0.4), 0 0 12rpx rgba(184, 134, 11, 0.2);
  }
}

.avatar-glow {
  animation: avatar-breathe 2.5s ease-in-out infinite;
}

/* --- 身份标签 --- */
.bond-identity {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
}

.bond-identity-name {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 8rpx 32rpx;
  border-radius: 20rpx;
}

.bond-free {
  color: #514345;
  background: rgba(134, 78, 90, 0.08);
}

.bond-silver {
  color: #7a6f8a;
  background: rgba(122, 111, 138, 0.1);
}

.bond-gold {
  color: #b8860b;
  background: rgba(184, 134, 11, 0.1);
}

/* --- 功能入口（并列卡片） --- */
.entry-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.entry-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.06);
  padding: 32rpx 20rpx 28rpx;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.entry-card:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(134, 78, 90, 0.1);
}

.entry-icon-area {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-icon-contract {
  background: linear-gradient(135deg, rgba(134, 78, 90, 0.12), rgba(134, 78, 90, 0.04));
  position: relative;
}

.entry-icon-contract::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #864e5a;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-contract::after {
  content: '';
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 3rpx solid #864e5a;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-backpack {
  background: linear-gradient(135deg, rgba(184, 134, 11, 0.12), rgba(184, 134, 11, 0.04));
  position: relative;
}

.entry-icon-backpack::before {
  content: '';
  position: absolute;
  width: 28rpx;
  height: 24rpx;
  border-radius: 4rpx;
  border: 3rpx solid #b8860b;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.entry-icon-backpack::after {
  content: '';
  position: absolute;
  width: 16rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #b8860b;
  top: calc(50% - 14rpx);
  left: 50%;
  transform: translateX(-50%);
}

.entry-title {
  font-size: 28rpx;
  color: #1b1c1c;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.entry-desc {
  font-size: 22rpx;
  color: #8a7a7e;
}

/* ===== Settings List (Glassmorphic Card) ===== */
.settings-list {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow:
    0 8rpx 32rpx rgba(134, 78, 90, 0.08),
    0 0 20rpx rgba(255, 183, 193, 0.12);
  overflow: hidden;
  margin-bottom: 24rpx;
}

/* ===== Settings Item ===== */
.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.06);
  transition: background 0.2s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: rgba(134, 78, 90, 0.04);
}

/* ===== Item Left ===== */
.item-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.item-label {
  font-size: 32rpx;
  color: #1b1c1c;
  font-weight: 500;
  line-height: 1.4;
}

/* ===== Item Right ===== */
.item-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: flex-end;
}

.item-value {
  font-size: 28rpx;
  color: #514345;
  text-align: right;
}

/* ===== Switch Component ===== */
switch {
  transform: scale(0.9);
}

/* ===== Footer ===== */
.settings-footer {
  text-align: center;
  padding: 60rpx 20rpx 40rpx;
}

.footer-text {
  font-size: 24rpx;
  color: rgba(134, 78, 90, 0.5);
  letter-spacing: 0.5rpx;
}

/* ===== 契约浮窗 ===== */
.contract-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease, visibility 0.3s ease;
}

.contract-overlay-show {
  opacity: 1;
  visibility: visible;
}

.contract-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fbf9f8;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom, 24rpx));
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.contract-overlay-show .contract-panel {
  transform: translateY(0);
}

.contract-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.contract-romantic-text {
  font-size: 30rpx;
  color: #514345;
  line-height: 1.6;
  letter-spacing: 1rpx;
}

.contract-cards {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.contract-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(134, 78, 90, 0.12);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.contract-card:active {
  transform: scale(0.97);
}

.contract-card-selected {
  border-color: #864e5a;
  box-shadow: 0 4rpx 20rpx rgba(134, 78, 90, 0.2);
}

.contract-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1b1c1c;
  letter-spacing: 1rpx;
}

.contract-card-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.contract-card-promo {
  font-size: 40rpx;
  font-weight: 700;
  color: #864e5a;
}

.contract-card-original {
  font-size: 22rpx;
  color: #8a7a7e;
  text-decoration: line-through;
}

.contract-card-period {
  font-size: 22rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

.contract-card-features {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  width: 100%;
  align-items: center;
}

.contract-feature {
  font-size: 22rpx;
  color: #514345;
  padding: 4rpx 16rpx;
  background: rgba(134, 78, 90, 0.06);
  border-radius: 12rpx;
  letter-spacing: 0.5rpx;
}

.contract-action {
  padding-top: 8rpx;
}

.contract-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: opacity 0.2s ease;
}

.contract-btn-disabled {
  background: rgba(134, 78, 90, 0.12);
  color: rgba(134, 78, 90, 0.4);
}

.contract-btn-active {
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.3);
}

.contract-btn-active:active {
  opacity: 0.85;
}

/* ===== 契约详情浮窗 ===== */
.detail-header {
  text-align: center;
  margin-bottom: 36rpx;
}

.detail-identity {
  display: inline-block;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 6rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.detail-silver {
  color: #7a6f8a;
  background: rgba(122, 111, 138, 0.1);
}

.detail-gold {
  color: #b8860b;
  background: rgba(184, 134, 11, 0.1);
}

.detail-expired {
  color: #8a7a7e;
  background: rgba(138, 122, 126, 0.1);
}

.detail-plan-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #1b1c1c;
  letter-spacing: 1rpx;
  margin-top: 12rpx;
}

/* 时间信息 */
.detail-time {
  background: rgba(134, 78, 90, 0.04);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 32rpx;
}

.detail-time-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.detail-time-label {
  font-size: 26rpx;
  color: #8a7a7e;
}

.detail-time-value {
  font-size: 26rpx;
  color: #514345;
  font-weight: 500;
}

.detail-remaining {
  font-size: 28rpx;
  color: #864e5a;
  font-weight: 600;
}

.detail-remaining-expired {
  color: #8a7a7e;
}

/* 权益列表 */
.detail-features {
  margin-bottom: 32rpx;
}

.detail-features-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #514345;
  margin-bottom: 16rpx;
  display: block;
}

.detail-features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 状态 */
.detail-status {
  text-align: center;
  padding-top: 8rpx;
}

.detail-status-tag {
  display: inline-block;
  font-size: 24rpx;
  font-weight: 500;
  padding: 6rpx 28rpx;
  border-radius: 16rpx;
  letter-spacing: 1rpx;
}

.detail-status-active {
  color: #5a8a4e;
  background: rgba(90, 138, 78, 0.1);
}

.detail-status-expired {
  color: #8a7a7e;
  background: rgba(138, 122, 126, 0.1);
}

/* 操作按钮 */
.detail-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(134, 78, 90, 0.08);
}

.detail-btn {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 0.15s ease;
}

.detail-btn:active {
  opacity: 0.85;
}

.detail-btn-renew {
  background: rgba(134, 78, 90, 0.1);
  color: #864e5a;
}

.detail-btn-upgrade {
  background: linear-gradient(135deg, #b8860b, #daa520);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(184, 134, 11, 0.25);
}

.detail-btn-subscribe {
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.25);
}

/* ===== 契约确认浮窗 ===== */
.confirm-card {
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(134, 78, 90, 0.12);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.confirm-plan-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1b1c1c;
  letter-spacing: 1rpx;
}

.confirm-price {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.confirm-features {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.confirm-note {
  text-align: center;
  margin-bottom: 24rpx;
  padding: 0 16rpx;
}

.confirm-note text {
  font-size: 22rpx;
  color: #8a7a7e;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* ================================================================
   DARK MODE
   ================================================================ */

.settings-container.dark {
  background: #121220;
}

.dark .settings-title {
  color: #e8e4e3;
}

/* 羁绊面板 - 深色模式 */
.dark .bond-card {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.dark .bond-avatar {
  border-color: rgba(196, 155, 165, 0.25);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  background: rgba(134, 78, 90, 0.12);
}

.dark .bond-avatar-label {
  color: #a09a9c;
}

.dark .thread-free {
  background: linear-gradient(
    90deg,
    rgba(106, 100, 104, 0) 0%,
    rgba(106, 100, 104, 0.2) 30%,
    rgba(106, 100, 104, 0.3) 50%,
    rgba(106, 100, 104, 0.2) 70%,
    rgba(106, 100, 104, 0) 100%
  );
}

.dark .thread-free::after {
  background: rgba(106, 100, 104, 0.25);
  box-shadow: none;
}

.dark .thread-silver {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.25) 30%,
    rgba(212, 115, 122, 0.4) 50%,
    rgba(212, 115, 122, 0.25) 70%,
    rgba(212, 115, 122, 0) 100%
  );
}

.dark .thread-silver::after {
  background: rgba(212, 115, 122, 0.35);
  box-shadow: 0 0 12rpx rgba(212, 115, 122, 0.15);
}

.dark .thread-gold {
  background: linear-gradient(
    90deg,
    rgba(212, 115, 122, 0) 0%,
    rgba(212, 115, 122, 0.4) 25%,
    rgba(212, 115, 122, 0.6) 50%,
    rgba(212, 115, 122, 0.4) 75%,
    rgba(212, 115, 122, 0) 100%
  );
}

.dark .thread-gold::after {
  background: rgba(212, 115, 122, 0.45);
  box-shadow: 0 0 16rpx rgba(212, 115, 122, 0.3);
}

@keyframes avatar-breathe-dark {
  0%, 100% {
    border-color: rgba(218, 165, 32, 0.25);
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  }
  50% {
    border-color: rgba(218, 165, 32, 0.6);
    box-shadow: 0 4rpx 28rpx rgba(218, 165, 32, 0.3), 0 0 12rpx rgba(218, 165, 32, 0.15);
  }
}

.dark .avatar-glow {
  animation: avatar-breathe-dark 2.5s ease-in-out infinite;
}

.dark .bond-free {
  color: #a09a9c;
  background: rgba(134, 78, 90, 0.15);
}

.dark .bond-silver {
  color: #b8adc8;
  background: rgba(122, 111, 138, 0.15);
}

.dark .bond-gold {
  color: #daa520;
  background: rgba(184, 134, 11, 0.15);
}

.dark .entry-card {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dark .entry-card:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.25);
}

.dark .entry-icon-contract {
  background: linear-gradient(135deg, rgba(196, 155, 165, 0.15), rgba(196, 155, 165, 0.05));
}

.dark .entry-icon-contract::before {
  background: #c49ba5;
}

.dark .entry-icon-contract::after {
  border-color: #c49ba5;
}

.dark .entry-icon-backpack {
  background: linear-gradient(135deg, rgba(184, 134, 11, 0.15), rgba(184, 134, 11, 0.05));
}

.dark .entry-icon-backpack::before {
  border-color: #daa520;
}

.dark .entry-icon-backpack::after {
  background: #daa520;
}

.dark .entry-title {
  color: #e8e4e3;
}

.dark .entry-desc {
  color: #6a6468;
}

/* 设置列表 - 深色模式 */
.dark .settings-list {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.dark .settings-item {
  border-bottom-color: rgba(134, 78, 90, 0.12);
}

.dark .settings-item:active {
  background: rgba(134, 78, 90, 0.08);
}

.dark .item-label {
  color: #e8e4e3;
}

.dark .item-value {
  color: #a09a9c;
}

.dark .footer-text {
  color: rgba(196, 155, 165, 0.5);
}

