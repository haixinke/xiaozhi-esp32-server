<view class="page"><nav-bar title="我的卡册"></nav-bar><view class="content"><view wx:if="{{card}}" class="album-card" bindtap="onOpen"><image wx:if="{{card.avatarUrl}}" class="album-pet-avatar" src="{{card.avatarUrl}}" mode="aspectFill"></image><view wx:else class="baby-mark">{{card.petType === '锦鲤' ? '锦' : '兔'}}</view><view class="copy"><text class="name">{{card.name}}</text><text class="meta">{{card.petType || card.prototype}} · {{card.personalityBrief || card.personality}}</text><text class="serial">{{card.serial}}</text></view><text class="arrow">›</text></view><view wx:else class="empty"><view class="empty-card"></view><text class="empty-title">卡册还是空的</text><text class="empty-desc">到达预设破壳日后，收藏卡会自动收入这里。</text></view></view></view>
