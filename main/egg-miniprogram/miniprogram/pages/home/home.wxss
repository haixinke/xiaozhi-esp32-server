.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 30rpx 40rpx 48rpx; box-sizing: border-box; }
.empty-state { min-height: 1040rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.empty-orbit { width: 300rpx; height: 300rpx; border-radius: 50%; border: 2rpx dashed #D8D6C8; display: flex; align-items: center; justify-content: center; margin-bottom: 50rpx; background: radial-gradient(circle, rgba(237,231,142,.22), transparent 68%); }
.empty-egg { width: 150rpx; height: 184rpx; border-radius: 52% 48% 48% 52% / 61% 59% 41% 39%; border: 4rpx solid #D7D4CA; background: #FFF; }
.empty-title { font-size: 42rpx; font-weight: 600; color: #002900; }
.empty-desc { width: 520rpx; margin: 22rpx 0 48rpx; font-size: 27rpx; line-height: 1.75; color: #6D6B65; }
.empty-note { margin-top: 22rpx; font-size: 22rpx; line-height: 1.6; color: #9A9890; text-align: center; }
.pet-restore-error .empty-orbit { border-color: #E1C9C0; background: radial-gradient(circle, rgba(244,185,174,.20), transparent 68%); }
.primary-button { width: 100%; height: 94rpx; line-height: 94rpx; padding: 0; border: none; border-radius: 999rpx; background: #002900; color: white; font-size: 29rpx; font-weight: 600; }
.primary-button::after { border: none; }
.friend-invite-card { width: 100%; margin-bottom: 20rpx; padding: 28rpx; border: 1rpx solid #D9E3C2; border-radius: 28rpx; box-sizing: border-box; background: #F5F8ED; text-align: left; }
.friend-invite-title { display: block; font-size: 30rpx; font-weight: 600; color: #002900; }
.friend-invite-copy { display: block; margin: 10rpx 0 22rpx; font-size: 24rpx; color: #6D6B65; }
.home-actions { display: flex; align-items: center; gap: 16rpx; margin-top: 20rpx; }
.home-actions .primary-button { width: auto; min-width: 0; margin: 0; }
.home-actions__chat { flex: 7 1 0; }
.home-actions__scene { flex: 3 1 0; background: #F5F8ED; color: #002900; border: 1rpx solid #D9E3C2; }
.pet-view { padding-bottom: 30rpx; }
.top-row { display: flex; justify-content: space-between; align-items: center; }
.eyebrow { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: #829047; }
.pet-name { display: block; margin-top: 10rpx; font-size: 42rpx; font-weight: 600; color: #1A1A1A; }
.progress-ring { width: 86rpx; height: 86rpx; border-radius: 50%; border: 8rpx solid #DCE5C1; display: flex; align-items: center; justify-content: center; color: #54632C; font-size: 23rpx; font-weight: 600; }
.egg-zone { position: relative; height: 600rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.scene-or-avatar { position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
.life-home-scene { position: relative; z-index: 2; width: 430rpx; height: 450rpx; border-radius: 42rpx; box-shadow: 0 26rpx 50rpx rgba(0,41,0,.16); }
.feedback-bubble { position: absolute; z-index: 5; top: 48rpx; max-width: 480rpx; padding: 18rpx 26rpx; border-radius: 28rpx 28rpx 28rpx 8rpx; background: #FFF; box-shadow: 0 12rpx 36rpx rgba(0,41,0,.10); font-size: 25rpx; color: #3D4930; animation: bubbleIn .25s ease-out; }
.cuddle-track { position: absolute; bottom: 62rpx; width: 280rpx; height: 8rpx; border-radius: 999rpx; overflow: hidden; background: #E8E6DF; }
.cuddle-fill { height: 100%; border-radius: 999rpx; background: #9DB65B; transition: width .1s linear; }
.state-card { display: flex; align-items: center; margin-bottom: 24rpx; padding: 28rpx 30rpx; border: 1rpx solid #E8E6E0; border-radius: 28rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(0,41,0,.04); }
.state-dot { width: 16rpx; height: 16rpx; flex-shrink: 0; margin: 0 28rpx 0 8rpx; border-radius: 50%; background: #9DB65B; box-shadow: 0 0 0 10rpx #F1F5E7; }
.state-copy { flex: 1; min-width: 0; }
.state-title { display: block; font-size: 28rpx; font-weight: 600; color: #273020; }
.status-daily { margin: 0 0 28rpx; padding: 0 30rpx; text-align: center; }
.status-meta { display: block; font-size: 21rpx; line-height: 1.5; color: #718044; }
.status-line { display: block; margin-top: 10rpx; font-size: 28rpx; line-height: 1.55; color: #35352F; }
.phone-auth-mask { position: fixed; z-index: 9998; top: 0; right: 0; bottom: 0; left: 0; display: flex; align-items: center; justify-content: center; padding: 48rpx; box-sizing: border-box; background: rgba(0,41,0,.42); }
.phone-auth-dialog { width: 100%; padding: 52rpx 44rpx 34rpx; border-radius: 36rpx; box-sizing: border-box; background: #FFF; box-shadow: 0 24rpx 64rpx rgba(0,41,0,.18); text-align: center; }
.phone-auth-title { display: block; font-size: 34rpx; font-weight: 600; color: #002900; }
.phone-auth-copy { display: block; margin: 20rpx 0 42rpx; font-size: 26rpx; color: #6D6B65; }
.phone-auth-cancel { margin-top: 20rpx; padding: 0; border: none; background: transparent; color: #7B796F; font-size: 26rpx; }
.phone-auth-cancel::after { border: none; }
.hatch-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #000; z-index: 9999; display: flex; align-items: center; justify-content: center; }
.hatch-video { width: 100vw; height: 100vh; }
.companion-section { margin-top: 28rpx; padding: 0 12rpx; }
.companion-item { position: relative; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; width: 160rpx; margin-right: 24rpx; padding: 16rpx 0 12rpx; border-radius: 24rpx; background: #FFF; box-shadow: 0 8rpx 24rpx rgba(0,41,0,.06); text-align: center; transition: transform .16s ease, background .16s ease, opacity .16s ease; }
.companion-item::after { border: none; }
.companion-item--locked { opacity: .68; }
.companion-item--locked .companion-icon { filter: grayscale(1); opacity: .62; }
.companion-icon { width: 78rpx; height: 78rpx; display: block; }
.companion-title { display: block; margin-top: 10rpx; font-size: 22rpx; color: #3D4930; }
@keyframes bubbleIn { from { transform: translateY(8rpx); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
