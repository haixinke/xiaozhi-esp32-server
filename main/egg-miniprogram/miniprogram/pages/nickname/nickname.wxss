.page { display:flex; flex-direction:column; height:100vh; background:#FAFAF8; }.content{flex:1;display:flex;flex-direction:column;align-items:center;padding:70rpx 48rpx 50rpx}.mini-egg{width:120rpx;height:148rpx;border-radius:52% 48% 48% 52%/61% 59% 41% 39%;background:linear-gradient(155deg,#FFFDF0,#EDE78E 58%,#F4B9AE);box-shadow:0 18rpx 36rpx rgba(0,41,0,.12)}.title{margin-top:44rpx;font-size:40rpx;font-weight:600;color:#002900}.desc{margin-top:16rpx;font-size:25rpx;color:#77756E}.input-wrap{position:relative;width:100%;margin-top:54rpx}.name-input{height:104rpx;border-radius:26rpx;background:#FFF;border:2rpx solid #D8D6CF;padding:0 110rpx 0 30rpx;font-size:30rpx}.counter{position:absolute;right:28rpx;top:36rpx;font-size:22rpx;color:#AAA79F}.error{align-self:flex-start;margin-top:14rpx;font-size:23rpx;color:#D9463C}.spacer{flex:1}.primary{width:100%;height:94rpx;display:flex;align-items:center;justify-content:center;padding:0;margin:0;border:none;border-radius:999rpx;background:#002900;color:#FFF;font-size:29rpx}.primary::after{border:none}
