<view class="page">
  <nav-bar title="系统设置"></nav-bar>

  <view class="content">

    <text class="section-label">个人信息</text>
    <view class="panel">
      <list-row label="年龄区间" value="{{ageRangeLoading ? '读取中…' : ageRangeLabel}}" bind:rowtap="onNavAgeRange"></list-row>
    </view>

    <text class="section-label">帮助与支持</text>
    <view class="panel">
      <list-row label="用户反馈" bind:rowtap="onNavFeedback"></list-row>
    </view>

    <text class="section-label">协议与政策</text>
    <view class="panel">
      <list-row label="用户服务协议" bind:rowtap="onNavTerms"></list-row>
      <list-row label="隐私协议" bind:rowtap="onNavPrivacy"></list-row>
    </view>

  </view>
</view>
