<view class="page"><nav-bar title="彩蛋涂鸦"></nav-bar><scroll-view class="content" scroll-y><view class="preview"><view class="preview-aura"></view><view class="preview-egg" style="background:linear-gradient(155deg,#FFFDF0 4%,{{selectedColor}} 62%,#F4B9AE 130%);"><text class="pattern-mark">{{selectedPattern === '星星' ? '✦' : selectedPattern === '爱心' ? '♡' : selectedPattern === '云朵' ? '☁' : selectedPattern === '裂纹' ? 'ϟ' : '••'}}</text></view><text class="preview-name">{{selectedColorName}} · {{selectedPattern}}</text></view><text class="label">选择主色</text><view class="color-row"><view wx:for="{{colors}}" wx:key="name" class="color-item" data-value="{{item.value}}" data-name="{{item.name}}" bindtap="onColor"><view class="swatch {{selectedColor === item.value ? 'swatch--selected' : ''}}" style="background:{{item.value}};"></view><text>{{item.name}}</text></view></view><text class="label">选择纹理</text><view class="pattern-row"><view wx:for="{{patterns}}" wx:key="*this" class="pattern {{selectedPattern === item ? 'pattern--selected' : ''}}" data-value="{{item}}" bindtap="onPattern">{{item}}</view></view><button class="primary" bindtap="onSave"><text class="primary-label">生成我的蛋壳</text></button></scroll-view></view>
