<view wx:if="{{!hidden && selected === 0 && toolboxVisible}}" class="toolbox-dismiss" catchtap="onCloseToolbox"></view>
<view wx:if="{{!hidden}}" class="tab-bar">
  <block wx:if="{{selected === 0}}">
    <view wx:if="{{toolboxVisible}}" class="toolbox-panel {{photoPetId ? 'toolbox-panel--with-photo' : ''}}">
      <view class="toolbox-grid">
        <view class="toolbox-item" aria-role="button" aria-label="打开活动" bindtap="onOpenActivities">
          <image class="toolbox-activity-icon" src="{{activityIcon}}" mode="aspectFit"></image><text>活动</text>
        </view>
        <view wx:if="{{photoPetId}}" class="toolbox-item" aria-role="button" aria-label="和蛋宝宝拍写真" bindtap="onOpenPhoto">
          <image src="{{photoIcon}}" mode="aspectFit"></image><text>AI 写真</text>
        </view>
        <view class="toolbox-item" aria-role="button" aria-label="打开设置" bindtap="onOpenSettings">
          <image src="{{items[1].iconPath}}" mode="aspectFit"></image><text>设置</text>
        </view>
      </view>
    </view>
    <view class="tab-item" hover-class="tab-item--pressed" aria-role="button" aria-label="{{toolboxVisible ? '收起百宝箱' : '打开百宝箱'}}" aria-expanded="{{toolboxVisible}}" bindtap="onToggleToolbox">
      <image class="toolbox-icon" src="{{toolboxVisible ? toolboxOpenIcon : toolboxClosedIcon}}" mode="aspectFit"></image>
    </view>
  </block>
  <block wx:else>
  <block wx:for="{{items}}" wx:key="pagePath">
    <view
      wx:if="{{selected !== index}}"
      class="tab-item"
      hover-class="tab-item--pressed"
      data-index="{{index}}"
      aria-role="button"
      aria-label="{{item.text}}"
      bindtap="onSwitch"
    >
      <image class="tab-icon" src="{{item.selectedIconPath}}" mode="aspectFit"></image>
    </view>
  </block>
  </block>
</view>
