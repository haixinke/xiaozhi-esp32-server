.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }

/* web-view 占满导航栏以外的全部可视区域 */
.page web-view { flex: 1; width: 100%; }

.error-state { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32rpx; padding: 0 60rpx; box-sizing: border-box; }
.error-text { color: #374039; font-size: 28rpx; line-height: 1.6; text-align: center; }
.back-btn { height: 88rpx; padding: 0 64rpx; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.back-btn::after { border: none; }
.back-btn-label { display: block; line-height: 1; }
