.page{display:flex;flex-direction:column;height:100vh;background:#FAFAF8}.content{flex:1;padding:38rpx 40rpx 60rpx;box-sizing:border-box}.intro{padding:34rpx;border-radius:32rpx;background:#002900;color:#FFF}.title{display:block;font-size:36rpx;font-weight:600}.desc{display:block;margin-top:16rpx;font-size:24rpx;line-height:1.7;color:#CFD9C0}.code-card{margin-top:28rpx;padding:34rpx 32rpx;border-radius:30rpx;background:#FFF;border:1rpx solid #E5E3DF}.code-head{display:flex;align-items:center;justify-content:space-between}.code-label{font-size:23rpx;color:#8C8C88}.usage{font-size:23rpx;color:#54632C;font-weight:600}.code{display:block;margin-top:22rpx;font-size:40rpx;font-weight:700;letter-spacing:2rpx;color:#1F2A14}.code-foot{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx}.state{font-size:24rpx;color:#8C8C88}.copy{min-width:200rpx;height:68rpx;line-height:68rpx;margin:0;padding:0 28rpx;border-radius:999rpx;background:#F5F8ED;color:#54632C;font-size:24rpx}.copy::after{border:none}.copy[disabled]{color:#B4B4AE;background:#F2F2EE}.code-card--exhausted{opacity:.6}.empty{margin-top:28rpx;padding:70rpx 30rpx;border-radius:28rpx;background:#FFF;text-align:center;color:#8C8C88;font-size:25rpx}.note{margin-top:26rpx;padding:26rpx;border-radius:24rpx;background:#FAFAEF;color:#6E6B35;font-size:22rpx;line-height:1.7}
