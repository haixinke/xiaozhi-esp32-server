<!--pages/soul-resonance/soul-resonance.wxml-->
<view class="page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar-inner">
      <text class="nav-title">真实灵魂</text>
    </view>
  </view>

  <!-- 角色照片（在 scroll-view 外，避免被导航栏遮挡） -->
  <view class="char-section">
    <view class="char-card-static">
      <image class="char-image" src="{{characterImage}}" mode="aspectFill" />
      <view class="char-overlay">
        <text class="char-name">{{characterName}}</text>
      </view>
    </view>
  </view>

  <!-- 可滚动内容区 -->
  <scroll-view class="scroll-content" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 灵魂特质 -->
    <view class="section">
      <view class="section-header">
        <view class="section-bar" />
        <text class="section-title">挑选两个最吸引您的灵魂特质</text>
      </view>
      <text class="section-subtitle">人类的灵魂从来都不单一</text>
      <view class="trait-grid">
        <view
          wx:for="{{soulTraits}}"
          wx:key="*this"
          class="trait-item {{item.selected ? 'trait-item-active' : ''}}"
          data-index="{{index}}"
          bindtap="onTraitTap"
          hover-class="trait-item-hover"
          hover-stay-time="80"
        >
          <text class="trait-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 小任性 -->
    <view class="section">
      <view class="section-header">
        <view class="section-bar" />
        <text class="section-title">选一个她的小任性吧</text>
      </view>
      <text class="section-subtitle">世界上没有完美的圆，正因为有了小瑕疵，她才独一无二</text>
      <view class="quirk-grid">
        <view
          wx:for="{{quirks}}"
          wx:key="*this"
          class="quirk-item {{index === selectedQuirk ? 'quirk-item-active' : ''}}"
          data-index="{{index}}"
          bindtap="onQuirkTap"
          hover-class="quirk-item-hover"
          hover-stay-time="80"
        >
          <text class="quirk-label">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 底部留白给 CTA 按钮腾空间 -->
    <view style="height: 200rpx;" />
  </scroll-view>

  <!-- CTA 按钮 -->
  <view class="cta-bar safe-area-bottom">
    <view
      class="cta-btn {{canProceed ? '' : 'cta-btn-disabled'}}"
      bindtap="onNext"
      hover-class="{{canProceed ? 'cta-btn-hover' : ''}}"
      hover-stay-time="80"
    >
      <text class="cta-text">绑定灵魂，开始交心</text>
    </view>
  </view>
</view>
