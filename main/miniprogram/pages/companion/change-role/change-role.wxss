.co-container { min-height:100vh; background:#f6f3f2; padding:0 0 160rpx; box-sizing:border-box;
  background-image: radial-gradient(at 0% 0%, rgba(255,183,197,0.18) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(211,198,218,0.18) 0px, transparent 50%) }
.co-container.dark { background:#121220; background-image:none }

.co-hint { text-align:center; font-size:26rpx; color:#8a7a7e; padding:40rpx 0 8rpx }
.co-container.dark .co-hint { color:#a89aa0 }

/* 角色肖像 swiper（沿用 destiny 命运初见） */
.char-section { padding:24rpx 0 0 }
.char-swiper { height:780rpx }
.char-card { width:100%; height:100%; border-radius:32rpx; overflow:hidden; position:relative;
  transform:scale(0.88); opacity:0.6; transition:all 0.3s ease; box-shadow:0 8rpx 40rpx rgba(134,78,90,0.12) }
.char-card-active { transform:scale(1); opacity:1; box-shadow:0 10rpx 60rpx rgba(255,183,197,0.35) }
.char-image { width:100%; height:100% }
.char-overlay { position:absolute; bottom:0; left:0; right:0; padding:48rpx 0 36rpx;
  background:linear-gradient(to top, rgba(0,0,0,0.45) 0%, transparent 100%); text-align:center }
.char-name { font-size:38rpx; font-weight:700; color:#fff; letter-spacing:2rpx; text-shadow:0 2rpx 12rpx rgba(0,0,0,0.3) }
.char-dots { display:flex; justify-content:center; gap:12rpx; margin-top:24rpx }
.char-dot { width:12rpx; height:12rpx; border-radius:50%; background:rgba(134,78,90,0.2); transition:all 0.3s ease }
.co-container.dark .char-dot { background:rgba(232,228,227,0.25) }
.char-dot-active { background:#864e5a; width:24rpx; border-radius:6rpx }

/* 底部确认条 */
.co-foot { position:fixed; left:0; right:0; bottom:0; background:rgba(251,249,248,0.96); backdrop-filter:blur(12rpx); border-top:1rpx solid rgba(134,78,90,0.1); display:flex; align-items:center; gap:20rpx; padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)) }
.co-container.dark .co-foot { background:#1e1c2e }
.co-info { flex:1; font-size:22rpx; color:#8a7a7e }
.co-btn { background:linear-gradient(135deg,#864e5a,#d4737a); color:#fff; font-size:28rpx; font-weight:600; padding:24rpx 52rpx; border-radius:48rpx; box-shadow:0 8rpx 24rpx rgba(134,78,90,0.3) }
.co-btn.dis { background:#d4c4c6; box-shadow:none }

/* 成功态 */
.co-success { display:flex; flex-direction:column; align-items:center; padding-top:200rpx; text-align:center }
.co-st { font-size:36rpx; font-weight:700; color:#3a2a2e; margin-top:32rpx }
.co-container.dark .co-st { color:#e8e4e3 }
.co-ss { font-size:24rpx; color:#8a7a7e; margin-top:16rpx; line-height:1.6; width:80% }
.co-row { display:flex; justify-content:space-between; width:84%; background:rgba(255,255,255,0.8); border:1rpx solid rgba(134,78,90,0.12); border-radius:24rpx; padding:24rpx; margin:40rpx 0 }
.co-container.dark .co-row { background:rgba(30,28,46,0.85) }
.co-rk { font-size:24rpx; color:#8a7a7e } .co-rv { font-size:24rpx; color:#b8860b }
.co-done { background:linear-gradient(135deg,#864e5a,#d4737a); color:#fff; font-size:28rpx; font-weight:600; padding:24rpx 80rpx; border-radius:48rpx; box-shadow:0 8rpx 24rpx rgba(134,78,90,0.3) }
