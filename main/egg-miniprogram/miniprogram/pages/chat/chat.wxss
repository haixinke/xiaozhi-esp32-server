.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }

/* 心情状态条 */
.mood-bar {
  display: flex; align-items: center; gap: 16rpx;
  padding: 16rpx 32rpx; background: #FAFAF8; border-bottom: 1rpx solid #E5E3DF;
}
.mood-line { flex: 1; font-size: 24rpx; color: #5C5C5C; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

/* 连接状态 */
.conn-state { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 999rpx; }
.conn-state--disconnected { color: #8C8C88; background: #EFEFED; }
.conn-state--connecting { color: #856B00; background: #FFF6CC; }
.conn-state--connected { color: #54632C; background: #E8F2D4; }

/* 消息区 */
.messages { flex: 1; padding: 32rpx; box-sizing: border-box; }
.tip { text-align: center; font-size: 22rpx; color: #8C8C88; margin-bottom: 24rpx; }
.row { display: flex; margin-bottom: 24rpx; }
.row--user { justify-content: flex-end; }
.row--egg { justify-content: flex-start; align-items: flex-end; gap: 16rpx; }
.bubble {
  max-width: 75%; padding: 20rpx 28rpx; font-size: 28rpx; line-height: 1.5;
  box-sizing: border-box;
}
.bubble--user { background: #002900; color: #FFFFFF; border-radius: 32rpx 32rpx 8rpx 32rpx; }
.bubble--egg { background: #F5F8ED; color: #1A1A1A; border-radius: 32rpx 32rpx 32rpx 8rpx; max-width: 70%; position: relative; }

/* 正在输入 / 正在说话 */
.typing { display: flex; gap: 8rpx; padding: 24rpx 32rpx; }
.bubble--typing { padding-right: 28rpx; }
.dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #54632C; animation: typingDot 1s ease-in-out infinite; }
.dot:nth-child(2) { animation-delay: 0.15s; }
.dot:nth-child(3) { animation-delay: 0.3s; }
@keyframes typingDot { 0%, 80%, 100% { transform: translateY(0); opacity: 0.4; } 40% { transform: translateY(-8rpx); opacity: 1; } }

.speaking-indicator { display: flex; align-items: flex-end; gap: 6rpx; margin-top: 12rpx; height: 24rpx; }
.speaking-bar { width: 6rpx; height: 8rpx; background: #54632C; border-radius: 999rpx; animation: speakingBar 0.8s ease-in-out infinite; }
.speaking-bar:nth-child(2) { animation-delay: 0.15s; }
.speaking-bar:nth-child(3) { animation-delay: 0.3s; }
@keyframes speakingBar { 0%, 100% { height: 8rpx; opacity: 0.5; } 50% { height: 22rpx; opacity: 1; } }

/* 输入栏 */
.composer {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 32rpx; border-top: 1rpx solid #E5E3DF; background: #FFFFFF;
}
.composer__input {
  flex: 1; height: 80rpx; border-radius: 999rpx; border: 1rpx solid #E5E3DF;
  background: #FAFAF8; padding: 0 32rpx; font-size: 28rpx; color: #1A1A1A;
}
.composer__send {
  width: 80rpx; height: 80rpx; border-radius: 50%; background: #002900;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.composer__send--pressed { background: #001A00; transform: scale(0.98); }
.composer__send--disabled { background: #B8B8B0; }
.composer__send-arrow {
  width: 20rpx; height: 20rpx; border-top: 4rpx solid #FFFFFF; border-right: 4rpx solid #FFFFFF;
  transform: rotate(-45deg); margin-top: 6rpx;
}
