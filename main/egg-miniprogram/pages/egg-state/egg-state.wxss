.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 56rpx 48rpx; box-sizing: border-box; }

/* 蛋台 */
.egg-stage { position: relative; width: 300rpx; height: 320rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 20rpx; }
.egg-glow {
  position: absolute; width: 240rpx; height: 240rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(157,182,91,0.35) 0%, rgba(255,255,255,0) 70%);
  animation: glowPulse 3s ease-in-out infinite;
}
.egg {
  position: relative; width: 224rpx; height: 262rpx;
  border-radius: 50% 50% 50% 50% / 58% 58% 42% 42%;
  border: 4rpx solid #FFFFFF; box-shadow: 0 8rpx 24rpx rgba(0,41,0,0.10);
  animation: eggPulse 3s ease-in-out infinite;
}
@keyframes eggPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
@keyframes glowPulse { 0%, 100% { opacity: 0.55; transform: scale(1); } 50% { opacity: 0.9; transform: scale(1.15); } }

.state-text { font-size: 24rpx; color: #8C8C88; letter-spacing: 1rpx; margin: 32rpx 0 40rpx; text-align: center; }

/* 进度卡 */
.progress-card {
  width: 100%; background: #F5F8ED; border: 1rpx dashed #002900; border-radius: 32rpx;
  padding: 40rpx; box-sizing: border-box; margin-bottom: 32rpx;
}
.progress-head { display: flex; justify-content: space-between; font-size: 24rpx; color: #54632C; }
.progress-track { height: 16rpx; border-radius: 999rpx; background: #E5E3DF; overflow: hidden; margin: 16rpx 0; }
.progress-fill { height: 100%; background: #9DB65B; border-radius: 999rpx; }
.divider { height: 1rpx; background: #DCE5C9; margin-bottom: 24rpx; }

/* 神秘感占位 */
.mystery {
  width: 100%; background: #FFFFFF; border: 1rpx solid #E5E3DF; border-radius: 32rpx;
  padding: 40rpx; box-sizing: border-box; margin-bottom: 48rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,41,0,0.06), 0 4rpx 8rpx rgba(0,41,0,0.04);
}
.mystery-title { display: block; font-size: 28rpx; font-weight: 600; color: #1A1A1A; margin-bottom: 12rpx; }
.mystery-desc { display: block; font-size: 26rpx; color: #8C8C88; line-height: 1.65; }

.hint { font-size: 22rpx; color: #8C8C88; text-align: center; margin-top: 24rpx; }

@media (prefers-reduced-motion: reduce) {
  .egg, .egg-glow { animation: none; }
}
