.page{height:100vh;display:flex;flex-direction:column;background:#FAFAF8;color:#1A1A1A}.content{flex:1;padding:34rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}.success{margin-bottom:28rpx;padding:26rpx;border-radius:24rpx;background:#EAF2DF;color:#294732}.success__title,.success__receipt{display:block}.success__title{font-size:28rpx;font-weight:600}.success__receipt{margin-top:10rpx;font-size:24rpx}.label{display:block;margin:30rpx 0 14rpx;font-size:25rpx;font-weight:600}.picker-field{min-height:96rpx;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:0 28rpx;border:1rpx solid #D8D5CE;border-radius:24rpx;background:#FFF;font-size:25rpx;line-height:1.45}.picker-field--placeholder{color:#8C8C88}.picker-field--open{border-color:#69836A;box-shadow:0 0 0 2rpx rgba(105,131,106,.12)}.picker-field__label{flex:1;min-width:0}.picker-field__chevron{flex:none;color:#607261;font-size:25rpx}.type-options{margin-top:12rpx;overflow:hidden;border:1rpx solid #D8D5CE;border-radius:24rpx;background:#FFF;box-shadow:0 12rpx 28rpx rgba(0,41,0,.08)}.type-option{min-height:84rpx;display:flex;align-items:center;gap:18rpx;padding:18rpx 26rpx;box-sizing:border-box;border-bottom:1rpx solid #EEECE6;color:#3F443F;font-size:23rpx;line-height:1.45}.type-option:last-child{border-bottom:0}.type-option--selected{background:#F0F5E9;color:#002900}.type-option__label{flex:1;min-width:0}.type-option__check{flex:none;color:#002900;font-weight:700}.description-wrap{position:relative}.description{width:100%;height:300rpx;padding:24rpx 26rpx 54rpx;box-sizing:border-box;border:1rpx solid #D8D5CE;border-radius:24rpx;background:#FFF;font-size:25rpx;line-height:1.6}.count{position:absolute;right:22rpx;bottom:18rpx;color:#8C8C88;font-size:21rpx}.consent{min-height:88rpx;display:flex;align-items:flex-start;margin-top:28rpx;color:#5C5C5C;font-size:23rpx;line-height:38rpx}.consent-copy{flex:1;min-width:0}.checkbox{width:36rpx;height:36rpx;display:flex;align-items:center;justify-content:center;flex:none;margin:1rpx 14rpx 0 0;border:2rpx solid #A6AAA3;border-radius:8rpx;box-sizing:border-box}.checkbox--checked{border-color:#002900;background:#002900;color:#FFF}.policy-link{color:#002900;font-weight:600}.submit-error{display:block;margin-top:18rpx;color:#C33F36;font-size:24rpx}.submit{min-height:96rpx;margin-top:28rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#002900;color:#FFF;font-size:28rpx;font-weight:600}.submit--disabled{background:#D9DBD5;color:#8C8C88}
