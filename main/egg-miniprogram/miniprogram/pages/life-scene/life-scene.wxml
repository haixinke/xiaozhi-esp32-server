<view class="page {{isActive ? '' : 'page--paused'}}">
  <image class="scene-bg" src="{{scene.image}}" mode="aspectFill"></image><view class="scene-dim"></view><view class="scene-enter-gradient"></view>
  <view wx:if="{{scene && scene.key === 'grass'}}" class="grass-ambient">
    <view class="grass-sky-dim"></view>
    <view class="grass-shimmer grass-shimmer--one"></view>
    <view class="grass-shimmer grass-shimmer--two"></view>
    <view class="firefly firefly--one"></view>
    <view class="firefly firefly--two"></view>
    <view class="firefly firefly--three"></view>
    <view class="firefly firefly--four"></view>
    <view class="firefly firefly--five"></view>
    <view class="firefly firefly--six"></view>
  </view>
  <view wx:if="{{scene && scene.key !== 'grass'}}" class="scene-ambient scene-ambient--{{scene.key}}">
    <view class="ambient-piece ambient-piece--one"></view>
    <view class="ambient-piece ambient-piece--two"></view>
    <view class="ambient-piece ambient-piece--three"></view>
    <view class="ambient-piece ambient-piece--four"></view>
    <view class="ambient-piece ambient-piece--five"></view>
    <view class="ambient-piece ambient-piece--six"></view>
    <view class="ambient-piece ambient-piece--seven"></view>
    <view class="ambient-piece ambient-piece--eight"></view>
  </view>
  <view class="topbar" style="padding-top:{{statusBarHeight}}px;"><view class="round-btn" bindtap="onBack"><view class="back-icon"></view></view></view>
  <view class="pet-hotspot" bindtap="onTapPet"></view>
  <view wx:for="{{sceneDecorations}}" wx:key="itemId" class="placed-decoration">{{item.icon}}</view>
  <view class="hotspot" wx:for="{{hotspots}}" wx:key="label" style="left:{{item.x}};top:{{item.y}};" data-index="{{index}}" catchtap="onTapHotspot"><view class="hotspot-dot"></view><text>{{item.label}}</text></view>
  <view wx:if="{{ripple}}" class="ripple" style="left:{{ripple.x}};top:{{ripple.y}};"></view>
  <view wx:if="{{flowerEffect}}" class="flower-effect" style="left:{{flowerEffect.x}};top:{{flowerEffect.y}};">
    <view class="flower-sway">
      <view class="flower-stem"></view>
      <view class="flower-leaf flower-leaf--left"></view>
      <view class="flower-leaf flower-leaf--right"></view>
      <view class="flower-bloom">
        <view class="flower-petal flower-petal--one"></view>
        <view class="flower-petal flower-petal--two"></view>
        <view class="flower-petal flower-petal--three"></view>
        <view class="flower-petal flower-petal--four"></view>
        <view class="flower-petal flower-petal--five"></view>
        <view class="flower-center"></view>
      </view>
    </view>
  </view>
  <view wx:if="{{butterflyEffect}}" class="butterfly-effect" style="left:{{butterflyEffect.x}};top:{{butterflyEffect.y}};">
    <view class="butterfly-flight">
      <view class="butterfly">
        <view class="butterfly-wing butterfly-wing--left"></view>
        <view class="butterfly-wing butterfly-wing--right"></view>
        <view class="butterfly-body"></view>
      </view>
    </view>
  </view>
  <view wx:if="{{sceneEffect}}" class="scene-effect scene-effect--{{sceneEffect.type}}" style="left:{{sceneEffect.x}};top:{{sceneEffect.y}};">
    <view class="effect-piece effect-piece--one"></view>
    <view class="effect-piece effect-piece--two"></view>
    <view class="effect-piece effect-piece--three"></view>
    <view class="effect-piece effect-piece--four"></view>
    <view class="effect-piece effect-piece--five"></view>
    <view class="effect-piece effect-piece--six"></view>
  </view>
  <view class="scene-title"><text class="kicker">{{sceneKicker}}</text><text class="name">{{scene.label}}</text></view>
  <view wx:if="{{bubble}}" class="bubble">{{bubble}}</view>
</view>
