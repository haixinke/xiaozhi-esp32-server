.page { position: relative; width: 100vw; height: 100vh; overflow: hidden; background: #DCE5CE; }.scene-bg,.scene-dim { position: absolute; inset: 0; width: 100%; height: 100%; }.scene-dim { background: linear-gradient(180deg,rgba(0,0,0,.2),rgba(0,0,0,0) 38%,rgba(0,0,0,.32)); }.topbar { position: absolute; z-index: 8; left: 28rpx; right: 28rpx; top: 0; display: flex; align-items: center; justify-content: space-between; }.round-btn,.change-btn { margin-top: 18rpx; height: 72rpx; background: rgba(0,0,0,.3); backdrop-filter: blur(8rpx); }.round-btn { width: 72rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }.change-btn { padding: 0 28rpx; border-radius: 999rpx; color: #FFF; font-size: 23rpx; display: flex; align-items: center; }.back-icon { width: 18rpx; height: 18rpx; border-left: 4rpx solid #FFF; border-bottom: 4rpx solid #FFF; transform: rotate(45deg); margin-left: 6rpx; }.pet-hotspot { position: absolute; z-index: 4; left: 28%; top: 34%; width: 44%; height: 42%; }.hotspot { position: absolute; z-index: 5; transform: translate(-50%,-50%); min-width: 90rpx; min-height: 90rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #FFF; font-size: 19rpx; text-shadow: 0 2rpx 5rpx rgba(0,0,0,.5); }.hotspot-dot { width: 28rpx; height: 28rpx; margin-bottom: 7rpx; border-radius: 50%; background: rgba(255,255,255,.9); border: 4rpx solid rgba(0,41,0,.28); box-shadow: 0 4rpx 12rpx rgba(0,0,0,.18); }.ripple { position: absolute; z-index: 6; width: 36rpx; height: 36rpx; margin: -18rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,.88); animation: ripple .7s ease-out forwards; }@keyframes ripple { from { opacity: 1; transform: scale(.4); } to { opacity: 0; transform: scale(3.5); } }.scene-title { position: absolute; z-index: 4; left: 40rpx; bottom: 152rpx; }.kicker { display: block; font-size: 20rpx; letter-spacing: 2rpx; color: rgba(255,255,255,.78); }.name { display: block; margin-top: 8rpx; font-size: 44rpx; font-weight: 600; color: #FFF; text-shadow: 0 3rpx 10rpx rgba(0,0,0,.35); }.bubble { position: absolute; z-index: 7; left: 40rpx; right: 40rpx; bottom: 52rpx; min-height: 78rpx; padding: 22rpx 28rpx; border-radius: 24rpx; background: rgba(255,255,255,.95); color: #263020; font-size: 25rpx; line-height: 1.5; box-shadow: 0 10rpx 30rpx rgba(0,0,0,.17); }
