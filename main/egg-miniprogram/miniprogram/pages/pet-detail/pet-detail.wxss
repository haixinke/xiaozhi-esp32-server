.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }
.content { flex: 1; padding: 26rpx 40rpx 64rpx; box-sizing: border-box; }
.hero { display: flex; flex-direction: column; align-items: center; padding: 28rpx 0 38rpx; }
.avatar { width: 190rpx; height: 190rpx; border-radius: 50% 50% 45% 45%; background: #002900; color: #EDE78E; display: flex; align-items: center; justify-content: center; font-size: 68rpx; box-shadow: 0 24rpx 48rpx rgba(0,41,0,.17); }
.name { margin-top: 26rpx; font-size: 40rpx; font-weight: 600; }
.meta { margin-top: 9rpx; font-size: 23rpx; color: #8C8C88; }
.daily-card, .profile-card, .record-card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 30rpx; background: #FFF; border: 1rpx solid #E7E5DF; }
.daily-card { background: #F5F8ED; border-color: #E2EACF; }
.daily-head { display: flex; justify-content: space-between; font-size: 22rpx; color: #77756E; }
.mood { padding: 5rpx 15rpx; border-radius: 999rpx; background: #DDE8C4; color: #54632C; }
.daily-line { display: block; margin-top: 14rpx; font-size: 28rpx; color: #30392A; }
.section-title { display: block; font-size: 27rpx; font-weight: 600; }
.fields { display: grid; grid-template-columns: 1fr 1fr; margin-top: 24rpx; border-radius: 22rpx; overflow: hidden; background: #F7F6F2; }
.fields > view { padding: 22rpx; }
.fields text { display: block; font-size: 20rpx; color: #8C8C88; }
.fields .field-value { margin-top: 7rpx; font-size: 25rpx; font-weight: 600; color: #1A1A1A; }
.summary { display: block; margin-top: 24rpx; font-size: 25rpx; line-height: 1.65; color: #5C5C5C; }
.record-card { display: flex; align-items: center; justify-content: space-between; }
.serial { display: block; margin-top: 10rpx; font-size: 19rpx; color: #8C8C88; }
.arrow { font-size: 40rpx; color: #99978F; }
.primary { height: 94rpx; line-height: 94rpx; border: 0; border-radius: 999rpx; background: #002900; color: #FFF; font-size: 29rpx; }
.primary::after { border: none; }
