.page { display: flex; flex-direction: column; height: 100vh; background: #FAFAF8; }.content { flex: 1; padding: 26rpx 34rpx 64rpx; box-sizing: border-box; }.intro { min-height: 190rpx; padding: 30rpx 34rpx; border-radius: 34rpx; background: #002900; color: #FFF; display: flex; align-items: center; justify-content: space-between; overflow: hidden; }.intro > view:first-child { flex: 1; }.intro-rabbit { width: 122rpx; height: 142rpx; margin-left: 18rpx; border-radius: 26rpx; flex-shrink: 0; }.intro-kicker { display: block; font-size: 18rpx; letter-spacing: 3rpx; color: #C8D6A1; }.intro-title { display: block; margin-top: 12rpx; font-size: 34rpx; font-weight: 600; }.intro-desc { display: block; width: 390rpx; margin-top: 12rpx; font-size: 22rpx; line-height: 1.55; color: #CDD8BE; }.scene-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; margin-top: 28rpx; }.scene-card { position: relative; height: 300rpx; border-radius: 28rpx; overflow: hidden; background: #E8E8DF; box-shadow: 0 10rpx 26rpx rgba(0,41,0,.08); }.scene-card--pressed { transform: scale(.98); opacity: .86; }.scene-image,.scene-shade { position: absolute; inset: 0; width: 100%; height: 100%; }.scene-shade { background: linear-gradient(180deg,rgba(0,0,0,0) 42%,rgba(0,20,0,.58) 100%); }.scene-copy { position: absolute; left: 22rpx; right: 22rpx; bottom: 20rpx; }.scene-name { display: block; color: #FFF; font-size: 29rpx; font-weight: 600; }.scene-subtitle { display: block; margin-top: 5rpx; color: rgba(255,255,255,.8); font-size: 19rpx; }.tip { margin: 24rpx 0; padding: 20rpx; border-radius: 20rpx; text-align: center; background: #FAFAEF; color: #6E6B35; font-size: 21rpx; }.exit-button { height: 82rpx; display: flex; align-items: center; justify-content: center; line-height: normal; border-radius: 999rpx; background: #FFF; border: 1rpx solid #D8D6CF; color: #5C5C5C; font-size: 24rpx; }.exit-button::after { border: none; }
