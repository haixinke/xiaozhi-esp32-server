/* pages/subscription/subscription.wxss */
/* Ethereal Companion - 订阅页面 */

/* 覆盖全局 page { overflow: hidden } 以启用页面滚动 */
page {
  height: auto;
  overflow: auto;
}

/* ===== Page Base ===== */
.sub-page {
  min-height: 100vh;
  background: #f6f3f2;
}

/* ===== Body ===== */
.sub-body {
  padding: 24rpx 32rpx 0;
}

/* ===== Capsule Tabs ===== */
.sub-tabs {
  display: flex;
  justify-content: center;
  gap: 8rpx;
  width: fit-content;
  background: rgba(134, 78, 90, 0.08);
  border-radius: 40rpx;
  padding: 6rpx;
  margin: 0 auto 20rpx;
}

.sub-tab {
  padding: 12rpx 36rpx;
  border-radius: 34rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #8a7a7e;
  transition: all 0.25s ease;
  letter-spacing: 1rpx;
}

.sub-tab-active {
  background: #864e5a;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(134, 78, 90, 0.3);
}

/* ===== Header ===== */
.sub-header {
  padding: 0rpx 0 24rpx;
}

.sub-title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #864e5a;
  letter-spacing: 1rpx;
  margin-bottom: 12rpx;
}

.sub-subtitle {
  display: block;
  font-size: 26rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

/* ===== Status Bar ===== */
.sub-status-bar {
  background: rgba(134, 78, 90, 0.06);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  margin-bottom: 24rpx;
}

.sub-status-text {
  font-size: 24rpx;
  color: #864e5a;
  font-weight: 500;
  letter-spacing: 0.5rpx;
}

/* ===== Period Cards ===== */
.period-scroll {
  margin-bottom: 32rpx;
  white-space: nowrap;
}

.period-cards {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 4rpx;
}

.period-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 200rpx;
  padding: 32rpx 20rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 2rpx solid rgba(134, 78, 90, 0.12);
  border-radius: 24rpx;
  transition: all 0.2s ease;
  white-space: normal;
}

.period-card-active {
  border-color: #864e5a;
  box-shadow: 0 4rpx 20rpx rgba(134, 78, 90, 0.2);
  background: rgba(134, 78, 90, 0.04);
}

.period-label {
  font-size: 26rpx;
  color: #514345;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.period-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #864e5a;
}

.period-original {
  font-size: 22rpx;
  color: #8a7a7e;
  text-decoration: line-through;
}

.period-monthly {
  font-size: 22rpx;
  color: #8a7a7e;
  letter-spacing: 0.5rpx;
}

/* ===== Feature Table ===== */
.feature-table {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 4rpx 16rpx rgba(134, 78, 90, 0.06);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.feature-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid rgba(134, 78, 90, 0.06);
}

.feature-row:last-child {
  border-bottom: none;
}

.feature-header-row {
  background: rgba(134, 78, 90, 0.03);
}

.feature-name-col {
  flex: 1.2;
}

.feature-tier-col {
  flex: 0.8;
  text-align: center;
}

.feature-header-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #514345;
}

.feature-tier-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #864e5a;
}

.feature-name {
  font-size: 26rpx;
  color: #514345;
}

.feature-check {
  font-size: 32rpx;
  font-weight: 600;
}

.check-yes {
  color: #864e5a;
}

.check-no {
  color: #ccc;
}

/* ===== Bottom Placeholder ===== */
.bottom-placeholder {
  height: 200rpx;
}

/* ===== Loading ===== */
.sub-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 300rpx;
}

.sub-loading-text {
  font-size: 28rpx;
  color: #8a7a7e;
}

/* ===== Bottom Bar ===== */
.sub-bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #f6f3f2;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom, 24rpx));
  box-shadow: 0 -4rpx 16rpx rgba(134, 78, 90, 0.06);
  z-index: 50;
}

.sub-buy-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: linear-gradient(135deg, #864e5a, #d4737a);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.3);
  transition: opacity 0.2s ease;
}

.sub-buy-btn:active {
  opacity: 0.85;
}

.btn-disabled {
  background: rgba(134, 78, 90, 0.15);
  color: rgba(134, 78, 90, 0.4);
  box-shadow: none;
}

.credit-info {
  margin-bottom: 16rpx;
  text-align: center;
}

.credit-info-text {
  font-size: 22rpx;
  color: #864e5a;
  letter-spacing: 0.5rpx;
}

.sub-terms {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #8a7a7e;
  margin-top: 12rpx;
  letter-spacing: 0.5rpx;
}

/* ================================================================
   DARK MODE
   ================================================================ */

.sub-page.dark {
  background: #121220;
}

.dark .sub-tabs {
  background: rgba(134, 78, 90, 0.15);
}

.dark .sub-tab {
  color: #6a6468;
}

.dark .sub-tab-active {
  background: #864e5a;
  color: #ffffff;
}

.dark .sub-title {
  color: #d4737a;
}

.dark .sub-subtitle {
  color: #6a6468;
}

.dark .sub-status-bar {
  background: rgba(134, 78, 90, 0.12);
}

.dark .sub-status-text {
  color: #d4737a;
}

.dark .period-card {
  background: rgba(30, 28, 46, 0.9);
  border-color: rgba(134, 78, 90, 0.2);
}

.dark .period-card-active {
  border-color: #c49ba5;
  box-shadow: 0 4rpx 20rpx rgba(196, 155, 165, 0.15);
  background: rgba(134, 78, 90, 0.12);
}

.dark .period-label {
  color: #a09a9c;
}

.dark .period-price {
  color: #d4737a;
}

.dark .period-original {
  color: #6a6468;
}

.dark .period-monthly {
  color: #6a6468;
}

.dark .feature-table {
  background: rgba(30, 28, 46, 0.85);
  border-color: rgba(134, 78, 90, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
}

.dark .feature-row {
  border-bottom-color: rgba(134, 78, 90, 0.12);
}

.dark .feature-header-row {
  background: rgba(134, 78, 90, 0.08);
}

.dark .feature-header-text {
  color: #a09a9c;
}

.dark .feature-tier-text {
  color: #d4737a;
}

.dark .feature-name {
  color: #a09a9c;
}

.dark .check-yes {
  color: #d4737a;
}

.dark .check-no {
  color: #444;
}

.dark .sub-loading-text {
  color: #6a6468;
}

.dark .sub-bottom-bar {
  background: #121220;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.dark .sub-buy-btn {
  background: linear-gradient(135deg, #864e5a, #d4737a);
  box-shadow: 0 8rpx 24rpx rgba(134, 78, 90, 0.25);
}

.dark .btn-disabled {
  background: rgba(134, 78, 90, 0.15);
  color: rgba(196, 155, 165, 0.3);
  box-shadow: none;
}

.dark .sub-terms {
  color: #6a6468;
}

.dark .credit-info-text {
  color: #d4737a;
}
