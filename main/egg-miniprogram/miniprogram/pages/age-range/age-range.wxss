.page{height:100vh;display:flex;flex-direction:column;background:#FAFAF8;color:#1A1A1A}.age-header{position:relative;flex:none}.save-success-toast{position:fixed;z-index:200;top:50%;left:50%;width:220rpx;min-height:200rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18rpx;padding:28rpx 24rpx;box-sizing:border-box;border:1rpx solid #DDE7D1;border-radius:30rpx;background:rgba(247,250,241,.97);box-shadow:0 16rpx 42rpx rgba(42,53,41,.14);color:#435348;font-size:25rpx;font-weight:600;line-height:1.5;text-align:center;pointer-events:none;transform:translate(-50%,-50%)}.save-success-toast__icon{width:66rpx;height:66rpx;display:flex;align-items:center;justify-content:center;border:3rpx solid #6F826E;border-radius:50%;box-sizing:border-box}.save-success-toast__check{width:17rpx;height:31rpx;border-right:5rpx solid #6F826E;border-bottom:5rpx solid #6F826E;box-sizing:border-box;transform:translateY(-4rpx) rotate(45deg)}.content{flex:1;padding:48rpx 40rpx calc(56rpx + env(safe-area-inset-bottom));box-sizing:border-box}.prompt{display:block;font-size:32rpx;font-weight:600;line-height:1.55}.state{margin-top:28rpx;padding:24rpx;border-radius:22rpx;background:#FFF;color:#5C5C5C;font-size:24rpx;text-align:center}.options{margin-top:30rpx;overflow:hidden;border:1rpx solid #E5E3DF;border-radius:30rpx;background:#FFF}.option{min-height:104rpx;display:flex;align-items:center;gap:22rpx;padding:0 30rpx;border-bottom:1rpx solid #ECEBE7;font-size:28rpx}.option:last-child{border-bottom:0}.option--selected{background:#F2F6EA}.option--disabled{opacity:.62}.radio{width:38rpx;height:38rpx;display:flex;align-items:center;justify-content:center;border:3rpx solid #A6AAA3;border-radius:50%;box-sizing:border-box}.option--selected .radio{border-color:#002900}.radio__dot{width:20rpx;height:20rpx;border-radius:50%;background:#002900}.save-error{display:block;margin-top:24rpx;color:#C33F36;font-size:24rpx}.confirm{min-height:96rpx;margin-top:30rpx;display:flex;align-items:center;justify-content:center;border-radius:999rpx;background:#002900;color:#FFF;font-size:28rpx;font-weight:600}.confirm--disabled{background:#D9DBD5;color:#8C8C88}.boundary-note{display:block;margin-top:28rpx;color:#737771;font-size:22rpx;line-height:1.65}
