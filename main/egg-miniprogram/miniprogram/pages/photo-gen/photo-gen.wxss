.page {
  min-height: 100vh;
  background: #FAFAF8;
}

/* 内容区留白，nav-bar 需顶到屏幕边缘（与"我的"页结构一致） */
.content {
  padding: 32rpx;
  box-sizing: border-box;
}

.hint-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.hint-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #002900;
}

.hint-desc {
  font-size: 26rpx;
  color: #8C8C88;
}

.photo-frame {
  width: 100%;
  height: 640rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFFFF;
  border: 2rpx dashed #D8D8D2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview {
  width: 100%;
  height: 100%;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.photo-placeholder-plus {
  font-size: 80rpx;
  color: #B8B8B2;
  line-height: 1;
}

.photo-placeholder-text {
  font-size: 26rpx;
  color: #8C8C88;
}

.primary-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  /* 微信 button 自带 padding/行高，line-height 居中文字会偏下，改用 flex 居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 48rpx;
  background: #002900;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
}

.primary-btn--disabled {
  opacity: 0.4;
}

.working-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 80rpx;
  gap: 24rpx;
}

.working-photo {
  width: 320rpx;
  height: 320rpx;
  border-radius: 24rpx;
  opacity: 0.6;
}

.working-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #D8D8D2;
  border-top-color: #002900;
  animation: photo-gen-spin 0.9s linear infinite;
}

@keyframes photo-gen-spin {
  to { transform: rotate(360deg); }
}

.working-text {
  font-size: 30rpx;
  color: #002900;
}

.working-sub {
  font-size: 24rpx;
  color: #8C8C88;
}

.result-frame {
  position: relative;
  width: 100%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #FFFFFF;
}

.result-image {
  width: 100%;
  display: block;
}

.ai-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.45);
  color: #FFFFFF;
  font-size: 20rpx;
}

.result-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.ghost-btn {
  width: 100%;
  height: 96rpx;
  /* 同 primary-btn，用 flex 保证文字垂直居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 48rpx;
  background: #FFFFFF;
  color: #002900;
  font-size: 30rpx;
  border: 2rpx solid #002900;
}

.failed-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
  gap: 32rpx;
}

.failed-reason {
  font-size: 28rpx;
  color: #8C8C88;
}

.failed-wrap .primary-btn {
  width: 60%;
  margin-top: 0;
}
