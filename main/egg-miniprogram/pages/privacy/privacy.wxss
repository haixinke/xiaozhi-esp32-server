.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #FFFFFF;
}

.content {
  flex: 1;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
}

.doc-title {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 40rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.doc-meta {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 24rpx;
  color: #8C8C88;
  margin-bottom: 48rpx;
}

.doc-intro {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  line-height: 1.75;
  color: #5C5C5C;
  margin-bottom: 48rpx;
}

.strong {
  font-weight: 600;
  color: #1A1A1A;
}

.toc {
  background: #E5EBE5; /* --ink-surface */
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-bottom: 56rpx;
}

.toc-title {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
}

.toc-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.toc-link {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  color: #54632C; /* --green-on-tint */
}

.section {
  margin-bottom: 8rpx;
}

.section-last {
  margin-bottom: 0;
}

.h2 {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 32rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 24rpx;
  padding-top: 8rpx;
}

.h3 {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.p {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 26rpx;
  line-height: 1.75;
  color: #5C5C5C;
  margin-bottom: 28rpx;
}

.footer-line {
  height: 2rpx;
  background: #E5E3DF;
  margin-bottom: 40rpx;
}

.footer-note {
  display: block;
  font-family: 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8C8C88;
  text-align: center;
}
